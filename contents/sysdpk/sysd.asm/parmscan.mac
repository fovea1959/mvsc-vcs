PARMSCAN TITLE 'GENERAL SCAN ROUTINE FOR EXEC PARMS'
*---------------------------------------------------------------------*
*                                                                     *
*         PROGRAM             PARMSCAN                                *
*         AUTHOR              Rob Prins                               *
*         FUNCTION            Scan the parameter in the EXEC statement*
*                             Example: PARM='KEYWORD=CONTENTS'        *
*                             CALL PARMSCAN,(WORD1,WORD2)             *
*                                                                     *
*                             WORD1 contains the address of a 8 bytes *
*                             'KEYWORD', wich contains the keyword    *
*                             padded with blanks if the 'KEYWORD' is  *
*                             shorter.                                *
*                             WORD1 contains the address of a 255     *
*                             byte area, which contains a 2 byte      *
*                             length field and a 253 byte field       *
*                             with the data after the '=' in          *
*                             Keyword=value.                          *
*                                                                     *
*                             Example: PARM='ROB=CHARLIE'             *
*                             In the area addressed by word1, you     *
*                             specify 'ROB' (without quotes).         *
*                             In the area addressed by word2 you      *
*                             receive:                                *
*                             X'0007' in the first 2 bytes            *
*                             And 'CHARLIE' WITH 246 BLANKS in the    *
*                             area addressed by word2.                *
*                                                                     *
*                             Return codes: 00, Parameter is found    *
*                                           04, Parameter is not found*
*                                                                     *
*------------------------------------------ (C)-1985 SKYBIRD SYSTEMS -*
         SPACE 3
PARMSCAN CSECT
         SAVE  (14,12),,*              SAVE REGISTERS
         LR    10,15                   BASE REGISTER
         USING PARMSCAN,10             GET ADDRESSABILITY
         LA    2,SAVEAREA
         ST    2,8(13)                 FORWARD POINTER
         ST    13,4(2)                 BACKWARD POINTER
         L     3,4(13)                 SAVE AREA BEFORE SAVE MACRO
*                                      'CALLING PROGRAM'
         LR    13,2
         L     2,24(3)                 PICKUP R1 WITH EXEC PARM ADDRESS
         LM    3,4,0(1)                PICKUP PARM OF PARMSCAN
         USING WORD2,4
         L     2,0(2)                  PICKUP EXEC-PARM
         LH    5,0(2)                  LENGTH OF EXEC PARM
         LTR   5,5                     NO PARM IN EXEC-STMNT ?
         BZ    ERROR                   ERROR IF YES
         LA    2,2(2)                  SKIP LENGTH
         XR    6,6                     FOR ACTUAL LENGTH OF 'KEYWORD'
         LR    7,3                     SAVE ADDRESS 'KEYWORD'
A001     EQU   *
         CLI   0(7),X'40'              TRAILING BLANK ?
         BE    A003                    END OF KEYWORD IF YES
         LA    6,1(6)                  COUNT IS COUNT+1
         LA    7,1(7)
         C     6,=F'8'                 MAX LENGTH REACHED ?
         BL    A001                    BRANCH IF NOT
*
A003     EQU   *
         BCTR  6,0                     MINUS 1 FOR EX INSTR
*
A005     EQU   *
         EX    6,COMPARE         COMPARE IF 'KEYWORD' IN EXEC-PARM
         BE    PRMFOUND                BRANCH IF FOUND
A005A    LA    2,1(2)                  NEXT CHAR IN EXEC-PARM
         BCT   5,A005                  TRY AGAIN
         B     ERROR                   'KEYWORD' NOT FOUND
*
COMPARE  CLC   0(0,2),0(3)             *** EXECUTE ONLY ***
*
PRMFOUND EQU   *
         AR    2,6
         LA    2,1(2)                  EQUAL SIGN
         CLI   0(2),C'='               MUST BE A = SIGN
         BE    A006                    YES PROCEED
         BCTR  2,0                     RESET R2
         SR    2,6                             )RESET R2
         B     A005A
A006     SR    5,6                     DECR WITH KEYWORD LENGTH -1
         BCTR  5,0                     DECR WITH KEYWORD LENGTH
         XR    7,7                     FOR COUNT 'CONTENTS'
         LA    2,1(2)                  SKIP EQUAL SIGN
         BCTR  5,0                     DECREASE LENGTH ('=' SIGN)
         C     5,=F'0'
         BL    ERROR
         LR    3,2                     SAVE BEGINADDRESS 'CONTENTS'
*
A007     EQU   *
         LTR   5,5                     REGISTER 5 ALREADY ZERO
         BZ    A009                    YES: PARM LENGTH IS 0
         CLI   0(2),C','               END OF 'CONTENTS'
         BE    A009                    BRANCH IF SO
         LA    2,1(2)                  NEXT CHAR 'CONTENTS'
         LA    7,1(7)                  COUNT THAT CHARACTER
         C     7,=F'253'               MAX LENGTH ?
         BNL   A009                    FORCE END IF >=253
         BCT   5,A007                  NEXT CHAR
*
A009     EQU   *
         STH   7,PARMLEN               LENGTH OF 'CONTENTS'
         MVI   PARM,X'40'              CLEAR 'CONTENTS' FIELD
         MVC   PARM+1(252),PARM
         BCTR  7,0                     FOR EX.
         C     7,=F'-1'                NEGATIVE ?
         BE    END                     YES: SKIP MOVE
         EX    7,MOVE                  MOVE 'CONTENTS'
         B     END
*
MOVE     MVC   PARM(0),0(3)            *** EXECUTE ONLY ***
*
END      EQU   *
         LA    15,0                    ZERO RC
         B     BACK
*
ERROR    EQU   *
         LA    15,4                    'KEYWORD' NOT FOUND
*
BACK     EQU   *
         L     13,4(13)
         RETURN (14,12),RC=(15)
         EJECT
SAVEAREA DS    18F
         LTORG
WORD2    DSECT
PARMLEN  DS    CL2
PARM     DS    CL253
         END
