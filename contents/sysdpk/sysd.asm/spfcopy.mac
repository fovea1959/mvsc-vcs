SPFCOPY  CSECT
*---------------------------------------------------------------------*
*
*        Module:    SPFCOPY
*
*        Author:    Rob Prins, module reconstructed from the load
*                   module.
*
*        Function:  Invoke IEBCOPY in an authorized environmemt.
*                   1. Issue a STAX macro to disable PA1 or ATTN
*                   2. Setup an ESTAE for cleanup reasons.
*                   3. Toggle APF bit on if RAKF authorized.
*                   4. Link to IEBCOPY.
*                   5. Issue a STAX to enable PA1 or ATTN
*                   6. Toggle APF bit off if RAKF authorized.
*
*        Note:      SPFCOPY will be attached by other TSO command
*                   processors like COMPRESS.
*
*---------------------------------------------------------------------*
         STM   R14,R12,12(R13)                SAVE REGISTERS
         LR    R12,R15                        OUR BASE REGISTER
         USING SPFCOPY,R12                    PROVIDE ADDRESSABILITY
         B     START
         DC    C'SPFCOPY, &SYSDATE &SYSTIME'
START    DS    0H
         LR    R2,R1                          SAVE PARAMETER
         GETMAIN R,LV=WORKL                   GETMAIN WORKING STORAGE
         ST    R13,4(,R1)
         ST    R1,8(,R13)
         LR    R13,R1
         LR    R11,R1
         USING WORK,R11                       OUR WORKING STORAGE
         XC    STAXLST(STAXL),STAXLST         CLEAR STAX MF=L
         LA    R1,STAXLST
         STAX  MF=(E,(1)),DEFER=YES           DISABLE ATTN
         LA    R3,40                          RC=40, STAX FAILED
         LTR   R15,R15                        STAX OK?
         BNZ   RETURN                         NO: FREEMAIN AND EXIT
         LA    R4,RECOVER                     EXIT ROUTINE
         LA    R5,ESTAEP                      PARAMETER ESTAE
         ST    R11,ESTAEP                     SAVE R11 FOR ESTAE
         MVC   ESTAEL(ESTAELL),ESTAELC        MOVE LIST FORM TO WS
         ESTAE (4),PARAM=(5),MF=(E,ESTAEL)
         LA    R3,44                          SET DISASTROUS RETURNCDE
         LTR   R15,R15                        ESTAE OK?
         BNZ   STAXOFF                        NO: STAX OFF AND EXIT
         SR    R0,R0                          R0=0, ALWAYS 0 FOR SVC244
         LA    R1,1                           R1=1, SET APF
         SVC   244                            TOGGLE APF
         LR    R1,R2                          PARAMETER -> IEBCOPY
         LINK  EP=IEBCOPY
         LR    R3,R15                         R3=RETURN CODE IEBCOPY
         SR    R0,R0                          R0=0 ALWAYS FOR SVC 244
         SR    R1,R1                          R1=0 RESET APF
         SVC   244                            TOGGLE APF
         ESTAE 0                              KILL ESTAE
STAXOFF  DS    0H
         XC    STAXLST(STAXL),STAXLST         CLEAR STAX MF=L
         LA    R1,STAXLST
         STAX  DEFER=NO,MF=(E,(1))            CANCEL STAX
RETURN   LR    R1,R13                         A(WORKING STORAGE)
         L     R13,4(,R13)                    CALLERS SAVE AREA
         FREEMAIN R,LV=WORKL,A=(1)            GET RID OF OUR WORKAREA
         LR    R15,R3                         RETURN CODE
         L     R14,12(,R13)
         LM    R0,R12,20(R13)
         BR    R14
ESTAELC  ESTAE MF=L
         DROP  ,
RECOVER  DS    0H
         USING *,R15
         USING WORK,R11
         C     R0,=F'12'                      IS THERE AN SDWA?
         BNE   CONTINUE                       NO: CONTINUE WITH ABEND
*                                    IF NO SDWA, PARAM IS IN REGISTER 2
         L     R11,0(,R2)                     PARAMETER A(WORKAREA)
         STM   R14,R12,ESTAES                 SAVE REGISTERS
         LR    R12,R15                        ENTRY POINT
         DROP  R15                            RECOVER
         USING RECOVER,R12                    PROVIDE ADDRESSABILITY
         SR    R0,R0                          R0=0 ALWAYS 0 FOR SVC244
         SR    R1,R1                          R1=0 = APF OFF
         SVC   244                            RESET APF
         XC    STAXLST(STAXL),STAXLST         CLEAR STAX MF=L
         LA    R1,STAXLST
         STAX  DEFER=NO,MF=(E,(1))            CANCEL STAX
         LM    R14,R12,ESTAES                 RESTORE REGISTERS
         XR    R15,R15                        RC = 0, PERCOLATE
         BR    R14                            RETURN TO RTM
CONTINUE DS    0H
         STM   R14,R12,12(R13)
         LR    R12,R15                        RESTORE BASE
         LR    R2,R1                          SDWA
         L     R11,0(,R2)                     SDWAPARM WITH A(WORK)
         SR    R0,R0                          R0=0 ALWAYS 0 FOR SVC244
         SR    R1,R1                          R1=0 = APF OFF
         SVC   244                            TOGGLE APF OFF
         XC    STAXLST(STAXL),STAXLST         CLEAR STAX MF=L
         LA    R1,STAXLST
         STAX  DEFER=NO,MF=(E,(1))            CANCEL STAX
         LR    R1,R2                          RESTORE ADDRESS SDWA
         MVI   252(R1),X'00'                  00 TO SDWARCDE, PERCOLATE
         LM    R14,R12,12(R13)
         BR    R14                            PERCOLATE
         LTORG ,
         SPACE 1
R0       EQU   0
R1       EQU   1
R2       EQU   2
R3       EQU   3
R4       EQU   4
R5       EQU   5
R6       EQU   6
R7       EQU   7
R8       EQU   8
R9       EQU   9
R10      EQU   10
R11      EQU   11
R12      EQU   12
R13      EQU   13
R14      EQU   14
R15      EQU   15
*
WORK     DSECT
SAVE     DS    18F
ESTAEP   DS    F                                  ESTAE parm r11
ESTAES   DS    15F                                SAVE AREA RECOVER
ESTAEL   ESTAE MF=L
ESTAELL  EQU   *-ESTAEL
STAXLST  STAX  MF=L
STAXL    EQU   *-STAXLST
WORKL    EQU   *-WORK
         END   SPFCOPY
