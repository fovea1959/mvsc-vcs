//Z531415U JOB (CCMVS),ASMLINK,NOTIFY=&SYSUID,
// CLASS=A,MSGCLASS=X,COND=(0,NE)
//*
//*     ASM LINKEDIT FROM SOURCE ASM AND COPY THE HELP MEMBER
//*
//* ********************************************************
//* *  REFER: TK5.CNTL(UNITS$)                             *
//* *  INSTALL THE 'UNITS'    PROGRAM                      *
//* ********************************************************
//ASMH EXEC PGM=IFOX00,PARM='OBJECT,NODECK,RENT'
//SYSLIB   DD DISP=SHR,DSN=SYS1.MACLIB
//         DD DISP=SHR,DSN=SYS1.AMODGEN
//SYSIN    DD DISP=SHR,DSN=SYSD.ASM(UNITS)
//SYSUT1   DD UNIT=VIO,SPACE=(1024,(100,100))
//SYSUT2   DD UNIT=VIO,SPACE=(1024,(100,100))
//SYSUT3   DD UNIT=VIO,SPACE=(1024,(100,100))
//SYSPRINT DD SYSOUT=*
//SYSGO    DD UNIT=VIO,SPACE=(TRK,1),DISP=(,PASS),DCB=BLKSIZE=3200,
//            DSN=&&TEMP
//*
//LKED   EXEC  PGM=IEWL,
//       PARM='NCAL,MAP,LIST,LET,RENT'
//SYSUT1   DD  UNIT=SYSDA,SPACE=(2048,(200,20))
//SYSPRINT DD  SYSOUT=*
//SYSLIB   DD  DISP=SHR,DSN=SYS2.CMDLIB
//SYSLMOD  DD  DISP=SHR,DSN=SYS2.CMDLIB
//OBJECT   DD  DISP=(OLD,DELETE),DSN=&&TEMP
//SYSLIN   DD  *
 INCLUDE OBJECT
 ENTRY   UNITS
 NAME    UNITS(R)
/*
//HELP    EXEC PGM=IEBUPDTE,PARM=NEW
//SYSPRINT DD  SYSOUT=*
//SYSUT2   DD  DSN=SYS2.HELP,DISP=SHR
//SYSIN    DD  *
./ ADD NAME=UNITS
)F Function -
                  Display the unitnames available in the system
)X SYNTAX -
                  UNITS

                  Required - None
                  Defaults - None
)O OPERANDS -
                  None
./ ENDUP
/*
