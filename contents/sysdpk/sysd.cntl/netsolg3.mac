//NETSOLVA JOB (SYSGEN),'SETUP VTAM/TSO',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),COND=(0,NE)
//* ----------------------------------------------------------------- *
//* DO NOT RENUMBER THIS DECK!                                        *
//* ----------------------------------------------------------------- *
//*
//* ----------------------------------------------------------------- *
//* REPLACE NETWORK SOLICITOR SCREEN, Step 1: restore default source  *
//* ----------------------------------------------------------------- *
//CLEANUP EXEC PGM=IDCAMS
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
 DELETE SYS1.MACLIB(NSLOGO)
 SET MAXCC=0
 SET LASTCC=0
//COMP    EXEC COMPRESS,LIB='SYS1.MACLIB'
//COPY    EXEC PGM=IEBCOPY
//SYSPRINT DD  SYSOUT=*
//SYSUT1   DD  DISP=SHR,DSN=SYS1.AMACLIB
//SYSUT2   DD  DISP=SHR,DSN=SYS1.MACLIB
//SYSIN    DD  *
 COPY INDD=SYSUT1,OUTDD=SYSUT2
 SELECT MEMBER=((NETSOL,,R))
//*
//* ----------------------------------------------------------------- *
//* Step 2, update with changes to screen appearance                  *
//* ----------------------------------------------------------------- *
//UPDATE1 EXEC PGM=IEBUPDTE
//SYSPRINT DD  SYSOUT=*
//SYSUT1   DD  DISP=SHR,DSN=SYS1.MACLIB
//SYSUT2   DD  DISP=SHR,DSN=SYS1.MACLIB
//SYSIN    DD  *
./ CHANGE NAME=NETSOL
         CLI   MSGINDEX,X'0C'
         BNE   EGSKIP
         MVC   EGDATA(8),NAMEDEV
         MVC   EGDATA+9(8),APPLID
         LA    R3,EGMSGLN
         L     R4,=A(EGMSG)
*
         WRITE RPL=(PTRRPL),                                           X
               OPTCD=(LBT,ERASE),                                      X
               AREA=(R4),                                              X
               RECLEN=(R3),                                            X
               EXIT=WRITEND
*
         B     EGOK
*
*
EGSKIP   DS    0H                                 EGSKIP
EGOK     DS    0H                                 EGOK
EGMSG    DS    0C                                 EGMSG
         COPY  NSLOGO
EGMSGLN  EQU   *-EGMSG
//UPDATE2 EXEC PGM=IEBUPDTE
//SYSPRINT DD  SYSOUT=*
//SYSUT1   DD  DISP=SHR,DSN=SYS1.MACLIB
//SYSUT2   DD  DISP=SHR,DSN=SYS1.MACLIB
//SYSIN    DD  *
./ ADD NAME=NSLOGO
         $WCC  (RESETKBD,MDT)
         $SBA  (1,1)
         DC    C'Terminal'
         $SBA  (1,9)
         $SF   (SKIP,HI)
         $SBA  (1,11)
         $SF   (SKIP,HI)
TK5MDEV  DC    CL8' '
         $SBA  (1,20)
         $SF   (SKIP,HI)
         $SBA  (1,66)
         $SF   (SKIP,HI)
         DC    C'Date'
         $SBA  (1,71)
         $SF   (SKIP,HI)
         $SBA  (1,72)
         $SF   (SKIP,HI)
TK5MDATE DC    CL8' '
         $SBA  (2,1)
         $SF   (SKIP,HI)
         $SBA  (2,66)
         $SF   (SKIP,HI)
         DC    C'Time'
         $SBA  (2,72)
         $SF   (SKIP,HI)
TK5MTIME DC    CL8' '
         $SBA  (8,8)
         $SF   (SKIP,HI)
         DC    C'×l'
         $SBA  (8,16)
         $SF   (SKIP,HI)
         DC    C'_,,,---,,_'
         $SBA  (9,1)
         $SF   (SKIP,HI)
         DC    C'ZZZzz /,''.-''`''    -.  ;-;;,'
         $SBA  (10,6)
         $SF   (SKIP,HI)
         DC    C'×,4-  ) )-,_. ,( (  ''''-'''
         $SBA  (11,5)
         $SF   (SKIP,HI)
         DC    C'''---''''(_/--''  `-'')_)'
         $SBA  (13,8)
         DC    X'2842F6'                  , Color yellow
         DC    C'The MVS 3.8j'
         $SBA  (14,6)
         DC    C'Tur(n)key system'
         $SBA  (4,29)
         DC    X'2842F2'                  , Color red
         DC    C'  ______________  '
         $SBA  (5,29)
         DC    C' /××××××××××××××\ '
         $SBA  (6,29)
         DC    C'× ×××××××××××××× ×'
         $SBA  (7,29)
         DC    C'×/____/××××\ ___\×'
         $SBA  (8,31)
         DC    C'   × ×××× ×     '
         $SBA  (9,31)
         DC    C'   × ×××× ×     '
         $SBA  (10,31)
         DC    C'   × ×××× ×     '
         $SBA  (11,31)
         DC    C'   × ×××× ×     '
         $SBA  (12,31)
         DC    C'   × ×××× ×     '
         $SBA  (13,31)
         DC    C'   × ×××× ×     '
         $SBA  (14,31)
         DC    C'   × ×××× ×     '
         $SBA  (15,31)
         DC    C'   ×/____\×     '
         $SBA  (4,49)
         DC    X'2842F7'                  , Color white
         DC    C' __      __ '
         $SBA  (5,49)
         DC    C'×××\    ///\'
         $SBA  (6,49)
         DC    C'××××   /// /'
         $SBA  (7,49)
         DC    C'××××  /// / '
         $SBA  (8,49)
         DC    C'×××× /// /  '
         $SBA  (9,49)
         DC    C'××××/// /   '
         $SBA  (10,49)
         DC    C'×××///_/    '
         $SBA  (11,49)
         DC    C'×××\\\ \    '
         $SBA  (12,49)
         DC    C'××××\\\ \   '
         $SBA  (13,49)
         DC    C'×××× \\\ \  '
         $SBA  (14,49)
         DC    C'××××  \\\_\ '
         $SBA  (15,49)
         DC    C'\__\   \___\'
         $SBA  (4,64)
         DC    X'2842F1'                  , Color blue
         DC    C' ___________ '
         $SBA  (5,64)
         DC    C'××××××××××××\'
         $SBA  (6,64)
         DC    C'×××××××××××× ×'
         $SBA  (7,64)
         DC    C'××××\ ______\×'
         $SBA  (8,64)
         DC    C'×××× ×'
         $SBA  (9,64)
         DC    C'×××××××××× \'
         $SBA  (10,64)
         DC    C'××××××××××× \'
         $SBA  (11,64)
         DC    C'\_______×××× ×'
         $SBA  (12,64)
         DC    C'        ×××× ×'
         $SBA  (13,64)
         DC    C'×××××××××××× ×'
         $SBA  (14,64)
         DC    C'××××××××××× /'
         $SBA  (15,64)
         DC    C'\__________/'
         DC    X'280000'                  , Reset SA
         $SBA  (17,6)
         $SF   (SKIP)
         DC    C'TK3  created by Volker Bandke      volker@bandke.org'
         $SF   (SKIP)
         $SBA  (18,6)
         $SF   (SKIP)
         DC    C'TK4- update by Juergen Winkelmann  juergen.winkelmann@C
               pebble-beach.ch'
         $SBA  (18,76)
         $SF   (SKIP)
         $SBA  (19,6)
         $SF   (SKIP)
         DC    C'TK5  update by Rob Prins           prin0096@gmail.com'
         $SBA  (19,60)
         $SF   (SKIP)
         $SBA  (20,11)
         $SF   (SKIP)
         DC    C'see SYS2.JCLLIB(CREDITS) for complete credits'
         $SBA  (20,57)
         $SF   (SKIP)
         $SBA  (21,24)
         $SF   (SKIP)
         DC    C'MVS 3.8j Level 8505 - '
         DC    X'2842F6'                  , Color yellow
         DC    C'Update 5'
         DC    X'280000'                  , Reset SA
         $SBA  (22,80)
         $SF   (SKIP,HI)
         DC    C'Logon ===>'
         $SBA  (23,11)
         $SF   (UNPROT,HI)
         $IC
EGDATA   DC    CL128' '
         $SBA  (24,60)
         $SF   (SKIP,HI)
         DC    C'RUNNING  TK5'
         $SBA  (24,76)
         $SF   (SKIP,HI)
         $SBA  (24,80)
         $SF   (SKIP,HI)
//* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -UPDATE10
//*
//* ----------------------------------------------------------------- *
//* Step 3: assemble and link-edit new NETSOL                         *
//* ----------------------------------------------------------------- *
//*
//ASM11    EXEC PGM=IFOX00,REGION=1024K,
//             PARM='LINECOUNT(49),TERM'
//SYSLIB   DD  DISP=SHR,DSN=SYS1.MACLIB
//         DD  DISP=SHR,DSN=SYS2.MACLIB
//         DD  DISP=SHR,DSN=SYS1.AMODGEN
//SYSUT1   DD  UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSTERM  DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*,DCB=BLKSIZE=1089
//SYSPUNCH DD  DSN=&&A,DISP=(NEW,PASS,DELETE),
//             UNIT=3350,SPACE=(TRK,(2,2)),
//             DCB=(BLKSIZE=80,LRECL=80,RECFM=F)
//SYSIN    DD  *
ISTNSC00 CSECT ,
         NETSOL SYSTEM=VS2
         END   ,
//* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - ASM11
//*
//LKED12   EXEC PGM=IEWL,PARM='XREF,LIST,LET,NCAL',REGION=1024K
//SYSPRINT DD  SYSOUT=*
//SYSLIN   DD  DSN=&&A,DISP=(OLD,DELETE,DELETE)
//SYSLMOD  DD  DISP=SHR,DSN=SYS1.VTAMLIB(ISTNSC00)
//SYSUT1   DD  UNIT=SYSDA,SPACE=(1024,(200,20))
//* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -LKED12
//
