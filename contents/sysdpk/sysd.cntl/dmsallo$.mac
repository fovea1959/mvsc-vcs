//DMSALLO$ JOB (50,030),ALLOCATE.DMS,MSGLEVEL=(1,1),MSGCLASS=X,
//             REGION=500K,CLASS=A
//LD      EXEC PGM=IEBCOPY
//SYSPRINT  DD SYSOUT=*
//SYSUT3    DD UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT4    DD UNIT=SYSDA,SPACE=(TRK,(10,10))
//SRCIN     DD DSN=CBT249.FILE023,DISP=OLD
//SRCOUT    DD DSN=SYSD.DMS.SOURCE,DISP=(,CATLG),UNIT=SYSDA,
//             VOL=SER=SYSDPK,
//             SPACE=(CYL,(2,2,30)),DCB=SYS1.MACLIB
//LODIN     DD DSN=CBT249.FILE024,DISP=OLD
//LODOUT    DD DSN=SYSD.DMS.LINKLIB,DISP=(,CATLG),UNIT=SYSDA,
//             VOL=SER=SYSDPK,
//             SPACE=(CYL,(2,2,30))
//SYSIN     DD *
  COPY INDD=((SRCIN,R)),OUTDD=SRCOUT
  COPY INDD=((LODIN,R)),OUTDD=LODOUT
/*
