//GETSID   JOB (TSO),'SYS INFO',CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1)
//ASMEXEC   EXEC PGM=IFOX00,PARM='NODECK,LOAD'
//SYSLIB    DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1    DD UNIT=SYSDA,SPACE=(CYL,(2,2))
//SYSUT2    DD UNIT=SYSDA,SPACE=(CYL,(2,2))
//SYSUT3    DD UNIT=SYSDA,SPACE=(CYL,(2,2))
//SYSPRINT  DD SYSOUT=*
//SYSGO     DD DSN=&&OBJSET,UNIT=SYSDA,SPACE=(CYL,(1,1)),
//             DISP=(MOD,PASS)
//SYSIN     DD *
GETSID   CSECT
         STM   14,12,12(13)        SAVE CALLER'S REGISTERS
         BALR  12,0                ESTABLISH ADDRESSABILITY
         USING *,12                TELL ASSEMBLER BASE REGISTER
         ST    13,SAVEAREA+4       FORWARD POINTER
         LA    11,SAVEAREA
         ST    11,8(13)            BACKWARD POINTER
         LR    13,11               ACTIVATE NEW SAVE AREA
*
         LA    3,SYSID
         LA    4,MVSREL
         LA    5,CPUMOD
         LA    15,SYSINFO
         BALR  14,15
*
* --- PRINT THE SYSTEM DATA VIA DCB PUT ---
*
         OPEN  (PRTDCB,(OUTPUT))   OPEN SYSPRINT DCB
         PUT   PRTDCB,OUTLINE      WRITE COMPACT VARIABLES LINE
         CLOSE (PRTDCB)            CLOSE SYSPRINT DCB
*
* --- NORMAL EXIT ROUTINE ---
*
         L     13,SAVEAREA+4       RESTORE CALLER'S SAVE AREA PTR
         LM    14,12,12(13)        RESTORE ALL REGISTERS
         XR    15,15               SET RETURN CODE TO 0
         BR    14                  RETURN TO CALLER
*
* --- DATA STORAGE ---
*
SAVEAREA DC    18F'0'              STANDARD REGISTER SAVE AREA
*
OUTLINE  DS    0CL133              132 CHARS + 1 ASA CONTROL CHAR
         DC    C' '                ASA CARRIAGE CONTROL
         DC    C'SYSID: '
SYSID    DS    CL4                 SMF SYSTEM ID
         DC    C'  ×  MVS REL: '
MVSREL   DS    CL4                 MVS RELEASE VERSION
         DC    C'  ×  CPU MOD: '
CPUMOD   DS    CL4                 CPU MODEL NUMBER
         DC    CL87' '             PADDING TO FILL 132 CHARS
*
* --- DCB DEFINITION ---
*
PRTDCB   DCB   DSORG=PS,MACRF=PM,DDNAME=SYSPRINT,                      C
               RECFM=FBA,LRECL=133,BLKSIZE=133
         EJECT
*        ENTRY: R3 -> 4-BYTE SMF ID FIELD
*               R4 -> 4-BYTE MVS RELEASE FIELD
*               R5 -> 4-BYTE CPU MODEL FIELD
SYSINFO  STM   14,12,12(13)
         BALR  12,0
         USING *,12
         GETMAIN R,LV=SWORKAL
         LR    6,1
         USING SWORKA,6
         ST    13,SAVE+4
         ST    6,8(,13)
         LR    13,6
         L     7,16(0,0)           R7 = CVT
*
*        SMF ID: SMCA AT CVT+X'C4', SID AT SMCA+X'10'
*
         L     8,196(,7)
         LTR   8,8
         BZ    NOSMCA
         MVC   0(4,3),16(8)
         B     DOREL
NOSMCA   MVC   0(4,3),UNKNOWN
*
*        MVS RELEASE: 4 BYTES AT CVT-4
*
DOREL    LR    8,7
         SH    8,H4
         MVC   0(4,4),0(8)
*
*        CPU MODEL: 2 BYTES AT CVT-6, UNPACKED
*
         LR    8,7
         SH    8,H6
         UNPK  CPUTMP(5),0(3,8)
         MVC   0(4,5),CPUTMP
*
*        RETURN
*
         LR    2,13
         L     13,SAVE+4
         FREEMAIN R,LV=SWORKAL,A=(2)
         LM    14,12,12(13)
         SR    15,15
         BR    14
*
UNKNOWN  DC    C'????'
H4       DC    H'4'
H6       DC    H'6'
*
SWORKA   DSECT
SAVE     DS    18F
CPUTMP   DS    CL5
SWORKAL  EQU   *-SWORKA
         END
/*
//LKEDEXEC  EXEC PGM=IEWL,PARM='XREF,LIST,LET',COND=(4,LT,ASMEXEC)
//SYSLIN    DD DSN=&&OBJSET,DISP=(OLD,DELETE)
//SYSUT1    DD UNIT=SYSDA,SPACE=(CYL,(2,2))
//SYSPRINT  DD SYSOUT=*
//SYSLMOD   DD DSN=&&LOADLIB(GETSID),DISP=(,PASS),UNIT=SYSDA,
//             SPACE=(CYL,(1,1,1))
/*
//GOEXEC    EXEC PGM=GETSID,
//             COND=((4,LT,ASMEXEC),(4,LT,LKEDEXEC))
//STEPLIB   DD DSN=&&LOADLIB,DISP=(OLD,DELETE)
//SYSPRINT  DD SYSOUT=*
/*
