//COPYJOB  JOB CLASS=A,MSGCLASS=X,COND=(0,NE)
//ASM     EXEC PGM=IEBCOPY
//SYSPRINT  DD SYSOUT=*
//SYSUT1    DD DISP=SHR,
//             DSN=TK5.SYS1.SETUP.ASM,
//             UNIT=SYSDA,VOL=SER=SYSDPK
//SYSUT2    DD DISP=SHR,
//             DSN=SYSD.ASM
//SYSIN     DD *
  COPY INDD=SYSUT1,OUTDD=SYSUT2
  SELECT MEMBER=((BSPRCTST,,R))
  SELECT MEMBER=((BSPOSCMD,,R))
/*
//CNTL    EXEC PGM=IEBCOPY
//SYSPRINT  DD SYSOUT=*
//SYSUT1    DD DISP=SHR,
//             DSN=TK5.SYS1.SETUP.CNTL,
//             UNIT=SYSDA,VOL=SER=SYSDPK
//SYSUT2    DD DISP=SHR,
//             DSN=SYSD.CNTL
//SYSIN     DD *
  COPY INDD=SYSUT1,OUTDD=SYSUT2
  SELECT MEMBER=((RCTST$,,R))
  SELECT MEMBER=((OSCMD$,,R))
/*
