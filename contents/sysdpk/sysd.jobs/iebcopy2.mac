//COPYJOB  JOB CLASS=A,MSGCLASS=X
//STEP01  EXEC PGM=IEBCOPY
//SYSPRINT  DD SYSOUT=*
//SYSUT1    DD DISP=SHR,
//             DSN=SYSCPK.BSPPILOT
//SYSUT2    DD DISP=(NEW,CATLG,DELETE),
//             DSN=SYSCPK.BSPP2,VOL=SER=MVSCUS,UNIT=SYSDA,
//             SPACE=(TRK,(20,5,5)),
//             DCB=(LRECL=80,BLKSIZE=19040,RECFM=FB)
//SYSIN     DD *
  COPY INDD=SYSUT1,OUTDD=SYSUT2
/*
