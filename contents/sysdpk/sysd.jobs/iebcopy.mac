//COPYJOB  JOB CLASS=A,MSGCLASS=X
//STEP01  EXEC PGM=IEBCOPY
//SYSPRINT  DD SYSOUT=*
//SYSUT1    DD DISP=SHR,
//             DSN=BSP.SYS2.MACLIB,VOL=SER=MVSCUS,UNIT=SYSDA
//SYSUT2    DD DISP=(NEW,CATLG,DELETE),
//             DSN=SYSCPK.BSPMACS,VOL=SER=MVSCUS,UNIT=SYSDA,
//             SPACE=(TRK,(15,3,10)),
//             DCB=*.SYSUT1
//SYSIN     DD *
  COPY INDD=SYSUT1,OUTDD=SYSUT2
/*
