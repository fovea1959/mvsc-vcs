//VSAMLIST JOB (000),'RUN VSAMLIST',CLASS=A,MSGCLASS=X
//        EXEC PGM=VSAMLIST,PARM=SUM,REGION=2048K
//STEPLIB   DD DISP=SHR,DSN=SYS2.LINKLIB
//*YSABEND  DD SYSOUT=*
//MSGFILE   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133,BLKSIZE=1330)
//RPTFIL1   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133,BLKSIZE=1330)
//RPTFIL2   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133,BLKSIZE=1330)
//SYSOUT    DD SYSOUT=*
//SORTLIB   DD DSN=SYSC.SORTLIB,DISP=SHR
//SORTIN    DD DSN=&&DETAIL,DISP=(NEW,DELETE),UNIT=SYSDA,
//             SPACE=(CYL,(5,5))
//SORTWK01  DD UNIT=SYSDA,SPACE=(CYL,(3))
//SORTWK02  DD UNIT=SYSDA,SPACE=(CYL,(3))
//SORTWK03  DD UNIT=SYSDA,SPACE=(CYL,(3))
//VCLCNTL   DD *
   LISTCAT SYS1.VSAM.MASTER.CATALOG/SYSPROG
   LISTCAT UCWEGSCD
//
