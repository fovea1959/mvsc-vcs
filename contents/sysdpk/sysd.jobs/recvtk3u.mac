//R        JOB (1),'UNPACK XMIT',CLASS=A,MSGCLASS=A,MSGLEVEL=(1,1)
//R1      EXEC RECV370
//XMITIN    DD DSN=TK3UPD.SYS2.MACLIB.XMIT,DISP=OLD,
//             UNIT=SYSDA,VOL=SER=MVSCUS
//XMITOUT   DD DSN=SYS2.MACLIB,DISP=(NEW,CATLG,DELETE),
//             UNIT=3350,SPACE=(CTL,(3,1,10)),VOL=SER=MVS000
//R2      EXEC RECV370
//XMITIN    DD DSN=BREXX.V2R5M2.XMIT,DISP=OLD,
//             UNIT=SYSDA,VOL=SER=MVSCUS
//XMITOUT   DD DSN=BREXX.V2R5M2.INSTALL,DISP=(NEW,CATLG,DELETE),
//             UNIT=3390,SPACE=(TRK,(60,10,15),RLSE),VOL=SER=PUB001
