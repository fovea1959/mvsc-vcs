//R        JOB (1),'UNPACK XMIT',CLASS=A,MSGCLASS=A,MSGLEVEL=(1,1)
//R052    EXEC RECV370
//XMITIN    DD DSN=CBT.FILE052.XMIT,DISP=OLD,
//             UNIT=SYSDA,VOL=SER=XMI
//XMITOUT   DD DSN=CBT.FILE052,DISP=(NEW,CATLG,DELETE),
//             UNIT=3350,SPACE=(CYL,(3,1,10)),VOL=SER=MVSCUS
//R069    EXEC RECV370
//XMITIN    DD DSN=CBT.FILE069.XMIT,DISP=OLD,
//             UNIT=SYSDA,VOL=SER=XMI
//XMITOUT   DD DSN=CBT.FILE069,DISP=(NEW,CATLG,DELETE),
//             UNIT=3350,SPACE=(CYL,(30,1,100),RLSE),VOL=SER=MVSCUS
//R755    EXEC RECV370
//XMITIN    DD DSN=CBT.FILE755.XMIT,DISP=OLD,
//             UNIT=SYSDA,VOL=SER=XMI
//XMITOUT   DD DSN=JRP.DATA,DISP=(NEW,CATLG,DELETE),
//             UNIT=3350,SPACE=(CYL,(30,1,100),RLSE),VOL=SER=MVSCUS
