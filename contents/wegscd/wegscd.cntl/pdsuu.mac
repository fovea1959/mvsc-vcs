//WEGSCDCP JOB (DOUG,5278),'UNUPDTE,UPDTE',CLASS=A,MSGCLASS=A,
//             COND=(4,LT)
//RECREATE PROC D1=,D2=
//SCRATCH EXEC PGM=IEFBR14
//OUTDD     DD DSN=&D2,DISP=(MOD,DELETE,DELETE),
//             SPACE=(TRK,(0)),
//             UNIT=3350,VOL=SER=WEGSCD
//*
//UNLOAD  EXEC PGM=UNUPDTE
//STEPLIB   DD DSN=SYSC.LINKLIB,DISP=SHR
//SYSPRINT  DD SYSOUT=*
//SYSUT1    DD DSN=&D1,DISP=(OLD,PASS,KEEP),
//             UNIT=3350,VOL=SER=WEGSCD
//SYSUT2    DD DSN=&&UNLOAD,UNIT=SYSDA,
//             DISP=(NEW,PASS),SPACE=(TRK,(2700,400),RLSE),
//             DCB=(DSORG=PS,RECFM=V,LRECL=133,BLKSIZE=3990)
//*
//REFORMAT EXEC PGM=SUPERGEN
//STEPLIB   DD DSN=SYSC.LINKLIB,DISP=SHR
//SYSIN     DD DUMMY
//SYSPRINT  DD SYSOUT=*
//SYSUT1    DD DSN=&&UNLOAD,DISP=(OLD,DELETE)
//SYSUT2    DD DSN=&&UNLOADF,UNIT=SYSDA,
//             DISP=(NEW,PASS),SPACE=(TRK,(2700,400),RLSE),
//             DCB=(DSORG=PS,RECFM=FB,LRECL=133,BLKSIZE=3990)
//*
//RELOAD  EXEC PGM=UPDTE,PARM=NEW
//STEPLIB   DD DSN=SYSC.LINKLIB,DISP=SHR
//SYSPRINT  DD SYSOUT=*
//SYSIN     DD DSN=&&UNLOADF,DISP=(OLD,DELETE)
//SYSUT2    DD DSN=&D2,DISP=(NEW,KEEP),
//             SPACE=(TRK,(100,100,5),RLSE),
//             DCB=(DSORG=PO,LRECL=133,BLKSIZE=3990,RECFM=FB),
//             UNIT=3350,VOL=SER=WEGSCD
//        PEND
//        EXEC RECREATE,D1='CTON.PICTURE',D2='CTON.PICTURE.FIXED'
//
