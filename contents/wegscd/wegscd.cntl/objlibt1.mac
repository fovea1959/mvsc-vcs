//WEGSCDOT JOB (001),'TEST OBJLIB F77',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1)
//*
//        EXEC F77CLG,
//             PARM.FORT='SOURCE,LINECNT=60,XREF,MAP,LIST',
//             PARM.LKED='MAP,LIST'
//FORT.SYSIN DD *
C CPU TIME MICROS SINCE LAST CALL
      CALL TIMER(5, ICPU)
C ELAPSED MILLIS SINCE LAST CALL
      CALL TIMER(6, IELAP)
C
      DO 99 I = 1, 2
        DO 98 J = 1, 1000000
          F = J
          S = SQRT(F)
98      CONTINUE
99    CONTINUE
C
      CALL TIMER(5, ICPU)
      CALL TIMER(6, IELAP)
      WRITE (6, 10) ICPU, IELAP
   10 FORMAT(1X, 4HCPU=, I16, 9H ELAPSED=, I16)
C
      PAUSE 2222
C
      CALL TIMER(5, ICPU)
      CALL TIMER(6, IELAP)
      WRITE (6, 10) ICPU, IELAP
      STOP
      END
/*
//LKED.SYSLIN DD
//           DD *
  INCLUDE MYLIB(TIMER,SROSDATE,SRCVTGRE,SRCVTJUL,TOD,DOW,GU719100)
/*
//LKED.MYLIB DD DSN=WEGSCD.OBJ,DISP=SHR
//GO.FT06F001 DD SYSOUT=*
//*
