//WEGSCDSC JOB (DOUG),'TRY SCRIPT',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//SCRIPTMN PROC PROG=SCRIPT,SCRIPT='PASSES=2,STAT',SIZE=1024K,SOUT='A'
//SCRIPT  EXEC PGM=&PROG,PARM='&SCRIPT',REGION=&SIZE
//STEPLIB   DD DSN=SYSC.SCRIPT.LOAD,DISP=SHR
//SYSPRINT  DD SYSOUT=&SOUT,FREE=CLOSE
//SYSTERM   DD SYSOUT=*
//SYSHYPH   DD DSN=SYSC.SCRIPT.HYPH(HYPH),DISP=SHR
//SYSIN     DD DSN=SYSC.SCRIPT.MEMO(&MEM),DISP=SHR
//SYSLIB    DD DSN=SYSC.SCRIPT.MEMO,DISP=SHR
//        PEND
//        EXEC SCRIPTMN,MEM=SCRIPT
//        EXEC SCRIPTMN,MEM=SCRDOC
//        EXEC SCRIPTMN,MEM=SCRINTRO
//        EXEC SCRIPTMN,MEM=SYSPUBMN
//        EXEC SCRIPTMN,MEM=SCRIPTNI
//        EXEC SCRIPTMN,MEM=SCRIPTCD
