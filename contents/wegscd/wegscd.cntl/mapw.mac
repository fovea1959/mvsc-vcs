//MAPWEG   JOB (WEGSCD),MAP.WEGSCD,CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1)
//*
//VOL     PROC V=
//*
//SUPRLST EXEC PGM=SUPERLST,PARM=MAP
//STEPLIB   DD DSN=SYSC.LINKLIB,DISP=SHR
//SYSPRINT  DD SYSOUT=*
//* these DD names must start with VOL
//VOLDD     DD VOL=SER=&V,UNIT=SYSALLDA,DISP=SHR
//*
//* DISKMAP AND MAPDISK ARE THE SAME UTILITY
//*
//*ISKMAP EXEC PGM=DISKMAP
//*TEPLIB   DD DSN=SYSC.LINKLIB,DISP=SHR
//*YSPRINT  DD SYSOUT=*
//*YSUT1    DD DSN=SYS1.PROCLIB,DISP=SHR
//*D1       DD VOL=SER=&V,UNIT=SYSALLDA,DISP=OLD
//*
//MAPDISK EXEC PGM=MAPDISK
//STEPLIB   DD DSN=SYSC.LINKLIB,DISP=SHR
//SYSPRINT  DD SYSOUT=*
//SYSUT1    DD DSN=SYS1.PROCLIB,DISP=SHR
//DD1       DD VOL=SER=&V,UNIT=SYSALLDA,DISP=OLD
//*
//VTOCLST EXEC PGM=VTOCLIST
//SYSPRINT  DD SYSOUT=*,DCB=(RECFM=VBA,LRECL=125,BLKSIZE=1254)
//SYSUT1    DD VOL=SER=&V,UNIT=SYSALLDA,DISP=SHR
//        PEND
//        EXEC VOL,V=WEGSCD
