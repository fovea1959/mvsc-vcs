//WEGSCDSM JOB 'HEX DUMP OF SMF',CLASS=A,MSGCLASS=A,NOTIFY=&SYSUID
//IDCAMS  EXEC PGM=IDCAMS
//SYSPRINT  DD SYSOUT=*
//SYSIN     DD *
 PRINT INDATASET(SYSO.SMF.DATA) HEX MARGINS(1,80)
/*
//PTPCHA  EXEC PGM=IEBPTPCH
//SYSPRINT  DD SYSOUT=*
//SYSUT1    DD DSN=SYSO.SMF.DATA,DISP=SHR
//SYSUT2    DD SYSOUT=*
//SYSIN     DD *
  PUNCH TYPORG=PS,TOTCONV=XE
/*
//PTPCHA  EXEC PGM=IEBPTPCH
//SYSPRINT  DD SYSOUT=*
//SYSUT1    DD DSN=SYSO.SMF.DATA(0),DISP=SHR
//SYSUT2    DD SYSOUT=*
//SYSIN     DD *
  PUNCH TYPORG=PS,TOTCONV=XE
/*
//
