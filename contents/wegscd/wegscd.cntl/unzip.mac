//WEGSCDUZ JOB (DOUG,5278),UNZIP,CLASS=A,MSGCLASS=X
//L       EXEC PGM=MINIUNZ,REGION=8M,PARM='-L ZIPFILE SEQOUT'
//STDOUT    DD SYSOUT=*
//ZIPFILE   DD DSN=SYSC.ZIP,DISP=SHR
//SEQOUT    DD DUMMY
//*
//UZ      EXEC PGM=MINIUNZ,REGION=8M,PARM='ZIPFILE SEQOUT FILE182.XMI'
//STDOUT    DD SYSOUT=*
//ZIPFILE   DD DSN=SYSC.ZIP,DISP=SHR
//SEQOUT    DD DISP=(NEW,CATLG,DELETE),DSN=SYSC.UNZIPPED,
//             UNIT=SYSDA,VOL=SER=MVSCUS,
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=19040),
//             SPACE=(TRK,(500,500),RLSE)
