//WEGSCDCP JOB (DOUG,5278),IEBCOPY.TEST,CLASS=A,MSGCLASS=A,
//             COND=(4,LT)
//RECREATE PROC D1=,D2=
//SCRATCH EXEC PGM=IEFBR14
//OUTDD     DD DSN=&D2,DISP=(MOD,DELETE,DELETE),
//             SPACE=(TRK,(0)),
//             UNIT=3350,VOL=SER=WEGSCD
//*
//UNLOAD  EXEC PGM=OFFLOAD
//STEPLIB   DD DSN=SYSC.LINKLIB,DISP=SHR
//SYSPRINT  DD SYSOUT=*
//INDD      DD DSN=&D1,DISP=OLD,
//             UNIT=3350,VOL=SER=WEGSCD
//OUTDD     DD DSN=&&UNLOAD,UNIT=SYSDA,
//             DISP=(NEW,PASS),SPACE=(TRK,(100,100),RLSE)
//SYSIN     DD DSN=WEGSCD.CONTROL(OFFLOAD),DISP=SHR
//*
//RELOAD  EXEC PGM=PDSLOAD,PARM=NEW
//STEPLIB   DD DSN=SYSC.LINKLIB,DISP=SHR
//SYSPRINT  DD SYSOUT=*
//SYSIN     DD DSN=&&UNLOAD,DISP=OLD
//SYSUT2    DD DSN=&D2,DISP=(NEW,PASS),
//             SPACE=(TRK,(100,100,5),RLSE),
//             DCB=(DSORG=PO,LRECL=133,BLKSIZE=3990,RECFM=FB),
//             UNIT=3350,VOL=SER=WEGSCD
//        PEND
//        EXEC RECREATE,D1='CTON.PICTURE',D2='CTON.PICTURE.FIXED'
//
