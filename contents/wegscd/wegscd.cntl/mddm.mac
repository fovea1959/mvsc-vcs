//WEGSCDDM JOB (WEGSCD),'MAPDISK/DISKMAP',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1)
//MAPALL  EXEC PGM=MAPDISK
//SYSPRINT  DD SYSOUT=* DUMMY
//SYSUT2    DD SYSOUT=* B
//SYSOUT    DD SYSOUT=*
//SYSUT1    DD SYSOUT=*
//WEGSCD    DD VOL=SER=WEGSCD,UNIT=SYSALLDA,DISP=OLD
//*------------------------------------------------------------------*
//DISKMAP EXEC PGM=DISKMAP
//SYSPRINT  DD SYSOUT=*
//SYSOUT    DD SYSOUT=*
//SYSUT1    DD DSN=SYS1.PROCLIB,DISP=SHR
//WEGSCD    DD VOL=SER=WEGSCD,UNIT=SYSALLDA,DISP=OLD
