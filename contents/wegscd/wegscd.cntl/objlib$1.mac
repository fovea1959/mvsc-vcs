//WEGSCDOB JOB (WEGSCD,MAINT,LIB),'SPLA623 -> OBJLIB',CLASS=A,
//             MSGCLASS=X,MSGLEVEL=(1,1)
//*
//ADD     PROC NAME=
//ASM     EXEC PGM=IFOX00,REGION=1024K,
//             PARM='NODECK,OBJ'
//SYSLIB    DD DISP=SHR,DSN=SYS1.MACLIB
//          DD DISP=SHR,DSN=SPLA.SPL623.FILE078.DATA(TIMER),
//             UNIT=SYSDA,VOL=SER=SPLA00
//SYSUT1    DD DSN=&&SYSUT1,UNIT=SYSSQ,SPACE=(1700,(600,100)),
//             SEP=(SYSLIB)
//SYSUT2    DD DSN=&&SYSUT2,UNIT=SYSSQ,SPACE=(1700,(300,50)),
//             SEP=(SYSLIB,SYSUT1)
//SYSUT3    DD DSN=&&SYSUT3,UNIT=SYSSQ,SPACE=(1700,(300,50))
//SYSPRINT  DD SYSOUT=*
//SYSPUNCH  DD DUMMY
//SYSGO     DD DISP=SHR,DSN=WEGSCD.OBJ(&NAME)
//SYSIN     DD DISP=SHR,DSN=SPLA.SPL623.FILE078.DATA(&NAME),
//             UNIT=SYSDA,VOL=SER=SPLA00
//        PEND
//*
//TIMER   EXEC ADD,NAME=TIMER
//SROSDATE EXEC ADD,NAME=SROSDATE
//SRCVTGRE EXEC ADD,NAME=SRCVTGRE
//SRCVTJUL EXEC ADD,NAME=SRCVTJUL
//TOD     EXEC ADD,NAME=TOD
//DOW      EXEC ADD,NAME=DOW        GU719000
//GU719100 EXEC ADD,NAME=GU719100
