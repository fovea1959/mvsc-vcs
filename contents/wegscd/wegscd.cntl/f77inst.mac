//WEGSCDF7 JOB (001),'CREATE F77RT',CLASS=A,MSGCLASS=X
//LIB     EXEC PGM=IEBUPDTE,PARM=NEW
//SYSPRINT  DD SYSOUT=*
//SYSUT2    DD DSN=MVSCUS.FORT370.V2610164.F77RT,
//             DISP=(NEW,CATLG),UNIT=3350,VOL=SER=MVSCUS,
//             SPACE=(TRK,(40,10,40),RLSE),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSIN     DD DSN=WEGSCD.F77RT.UPD,DISP=SHR
//*
//RECV    EXEC PGM=IKJEFT01,DYNAMNBR=60
//SYSTSPRT  DD SYSOUT=*
//SYSPRINT  DD SYSOUT=*
//SYSTSIN   DD *
RECEIVE INDATASET('WEGSCD.FORT370.XMIT') -
  DATASET('MVSCUS.FORT370.V2610164.LINKLIB') -
  VOL(MVSCUS) -
  NOPROMPT
