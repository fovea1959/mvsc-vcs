//WEGSCDF7 JOB (001),'INSTALL F77',CLASS=A,MSGCLASS=X
//RESTORE EXEC PGM=IEBCOPY
//SYSPRINT  DD SYSOUT=*
//TAPE1     DD DSN=FORT370.LOAD,UNIT=TAPE,VOL=SER=FORT70,
//             LABEL=(1,SL),DISP=OLD
//TAPE2     DD DSN=FORT370.F77RT,UNIT=TAPE,VOL=SER=FORT70,
//             LABEL=(2,SL),DISP=OLD
//LOADLIB   DD DSN=MVSCUS.FORT370.VYYMMDD.LINKLIB,DISP=(NEW,CATLG),
//             VOL=SER=MVSCUS,
//             UNIT=SYSDA,SPACE=(CYL,(3,1,10))
//F77RT     DD DSN=MVSCUS.FORT370.VYYMMDD.F77RT,DISP=(NEW,CATLG),
//             VOL=SER=MVSCUS,
//             UNIT=SYSDA,SPACE=(CYL,(2,1,100))
//SYSUT3    DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSIN     DD *
  COPY INDD=TAPE1,OUTDD=LOADLIB
  COPY INDD=TAPE2,OUTDD=F77RT
/*
