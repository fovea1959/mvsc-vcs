//RMFMAP$  JOB (SYS),'INSTALL RMFMAP',CLASS=S,MSGCLASS=X
//RMFMAP   EXEC ASMFCL,PARM='LIST,NODECK,LOAD,NOTERM'
//ASM.SYSGO DD DSN=&&OBJSET,UNIT=SYSSQ,SPACE=(80,(1000,1000),RLSE),
//             DISP=(MOD,PASS)
//ASM.SYSIN DD *
*          DATA SET CBT821     AT LEVEL 002 AS OF 01/19/78
*
* RMFMAP -   RMF REDUCTION PROGRAM    (EXECUTION DOCUMENTATION)
*
*
* THE FOLLOWING IS SAMPLE JCL WHICH RUNS TO PRODUCE DAILY REPORTS
* FOR A 168MP SYSTEM.  EACH DD CARD DESCRIBES ITS GENERAL REPORT
* CONTENTS.  FOR MORE DETAIL YOU WILL HAVE TO ATTACK THE CODE ITSELF
* IF ANYTHING IS NOT CLEAR.
* FOR THOSE OF YOU WITH FAITH,  TRY IT YOU'LL LIKE IT.
*
* //MAPMP PROC SYS='B168',     SYSTEM ID
* //         INTVL='15',       RMF REPORTING INTERVAL (MINUTES)
* //         SELLO='0800',     SELECTED AVERAGE PERIOD START TIME
* //         SELHI='1659',     SELECTED AVERAGE PERIOD STOP TIME
* //         TIMELO='0000',    AVERAGE PERIOD START TIME
* //         TIMEHI='2359',    AVERAGE PERIOD STOP TIME
* //         DATELO='77001',   RECORD DATE RANGE START DATE
* //         DATEHI='99350',   RECORD DATE RANGE STOP DATE
* //         RMFDSN=,          THE RMF RECORD INPUT DATA SET
* //         MIP=302           SERVICE UNITS PER SECOND OF TASK
* //*                          EXECUTION TIME.  CPU SECONDS
* //*                          CALCULATION IS AFFECTED BY THIS NUMBER.
* //*                          SEE MVS INIT AND TUNING GUIDE,
* //*                          SELECTING CPU SERVICE DEFINITION
* //*                          COEFFICIENT FOR TABLE OF VALUES.
* //*
         EJECT
* //MAPMP    EXEC PGM=RMFMAP,
* // PARM='&SYS&INTVL&SELLO&SELHI&TIMELO&TIMEHI&DATELO&DATEHI&MIP'
* //*
* //SMF    DD  DSN=&RMFDSN.,   RMF RECORD INPUT (70,71,72,73,74,76)
* //       DISP=SHR,DCB=BFTEK=A
* //*
* //*
* //*  SUMMARY REPORTS FOR CHANNELS, PERFORMANCE GROUPS, AND
* //*  DEVICES ARE CONSTRAINED BY THE DD CARDS SPECIFIED FOR
* //*  THE RESPECTIVE DETAIL REPORTS.
* //*  IF YOU SPECIFY 10 PERFORMANCE GROUPS FOR DETAIL
* //*  REPORTS YOU WILL GET SUMMARY DATA FOR THOSE SAME 10
* //*  PERFORMANCE GROUPS.
* //*  IF YOU SPECIFY 2 CONTROL UNITS OF DEVICES FOR DETAIL
* //*  REPORTS, YOU WILL GET SUMMARY DATA ONLY FOR THE DEVICES
* //*  ON THOSE CONTROL UNITS.  DEVICE SUMMARY IS ALSO LIMITED TO
* //*  THE FIRST 50 UNIQUE ENTRIES.
* //*  TRACE SUMMARY DATA IS PRODUCED FOR ALL TRACE ENTRIES SPECIFIED
* //*  IN THE RMF PARAMETERS UP TO A MAXIMUM OF 50 UNIQUE ENTRIES.
* //*
* //MAP1   DD  SYSOUT=A   SUMMARY RPT -   CPU AND PAGING
* //MAP2   DD  SYSOUT=A   SUMMARY RPT -   FRAMES, SWAPS, AND CHANNELS
* //TODMAP DD  DUMMY      TOD OUTPUT -    INPUT TO GRAPH PROGRAM
* //PCTMAP DD  SYSOUT=A   SUMMARY RPT -   CUMULATIVE CPU/PAGING/CHANNEL
* //MAP3   DD  SYSOUT=A   SUMMARY RPT -   PERF. GRPS, TRACE AND DEVICES
* //*
* //CPU    DD  SYSOUT=A   BAR GRAPH -     CPU BUSY
* //PAG1   DD  SYSOUT=A   BAR GRAPH -     TOTAL PAGING
* //PAG2   DD  SYSOUT=A   BAR GRAPH -     PAGE RECLAIMS
* //PAG3   DD  SYSOUT=A   BAR GRAPH -     ADDRESS SPACE PAGING
* //PAG4   DD  SYSOUT=A   BAR GRAPH -     COMMON AREA PAGING
* //PAG5   DD  SYSOUT=A   BAR GRAPH -     VIO PAGING
* //PAG6   DD  SYSOUT=A   BAR GRAPH -     SWAP PAGING AND PAGE FAULTS
* //FRAME  DD  SYSOUT=A   DETAIL RPT -    PAGE FRAME UTILIZATION
* //SWAP   DD  SYSOUT=A   DETAIL RPT -    SWAP COUNTS
* //*
         EJECT
* //CLIST  DD  SYSOUT=A   LIST RPT -      CHANNEL DESCRIPTIONS
* //*
* //* CHACBC IS THE DDNAME FORMAT OF THE CHANNEL BAR GRAPH DDNAMES
* //*   WHERE 'A' AND 'B' ARE CPU IDS (0 OR 1) IN ANY COMBINATION AND
* //*   'C' IS ANY CHANNEL ID (0 - F).  TO PRODUCE ACCURATE SUMMARY
* //*   REPORTS FOR CHANNELS, THE CHANNELS MUST BE MAPPED AGAINST THE
* //*   DD CARDS IN ASCENDING ORDER PRIOR TO ANY CROSS MAPPING SUCH AS
* //*   MAPPING PRIMARY AND ALTERNATE CHANNELS TOGETHER.
* //*   THE EXAMPLE PROVIDED BELOW FOR THE CHANNEL DD CARDS IS FOR A
* //*   168MP WITH 8 CHANNELS ON EACH SIDE.
* //*
* //*   NOTE THAT A MAXIMUM OF 20 CHANNEL DD CARDS IS ALLOWED
* //*
* //CH0010 DD  SYSOUT=A   BAR GRAPH -     CPU0 CHAN0   CPU1 CHAN0
* //CH0111 DD  SYSOUT=A   BAR GRAPH -     CPU0 CHAN1   CPU1 CHAN1
* //CH0212 DD  SYSOUT=A   BAR GRAPH -     CPU0 CHAN2   CPU1 CHAN2
* //CH0313 DD  SYSOUT=A   BAR GRAPH -     CPU0 CHAN3   CPU1 CHAN3
* //CH0414 DD  SYSOUT=A   BAR GRAPH -     CPU0 CHAN4   CPU1 CHAN4
* //CH0515 DD  SYSOUT=A   BAR GRAPH -     CPU0 CHAN5   CPU1 CHAN5
* //CH0616 DD  SYSOUT=A   BAR GRAPH -     CPU0 CHAN6   CPU1 CHAN6
* //CH0717 DD  SYSOUT=A   BAR GRAPH -     CPU0 CHAN7   CPU1 CHAN7
* //CH0102 DD  SYSOUT=A   BAR GRAPH -     CPU0 CHAN1   CPU0 CHAN2
* //CH0103 DD  SYSOUT=A   BAR GRAPH -     CPU0 CHAN1   CPU0 CHAN3
* //CH0203 DD  SYSOUT=A   BAR GRAPH -     CPU0 CHAN2   CPU0 CHAN3
* //CH0307 DD  SYSOUT=A   BAR GRAPH -     CPU0 CHAN3   CPU0 CHAN7
* //CH1112 DD  SYSOUT=A   BAR GRAPH -     CPU1 CHAN1   CPU1 CHAN2
* //CH1113 DD  SYSOUT=A   BAR GRAPH -     CPU1 CHAN1   CPU1 CHAN3
* //CH1213 DD  SYSOUT=A   BAR GRAPH -     CPU1 CHAN2   CPU1 CHAN3
* //CH1317 DD  SYSOUT=A   BAR GRAPH -     CPU1 CHAN3   CPU1 CHAN7
* //*
* //DEVNAME  DD  DUMMY    OFFENSIVE DEVICE OUTPUT (INPUT TO OTHER PGM)
* //*
* //DLIST  DD  SYSOUT=A   LIST RPT -      VOLSER LIST (1ST RMF INTRVAL)
* //*
* //* DVXX IS THE DDNAME FORMAT OF THE DEVICE DETAIL REPORT DDNAMES
* //*   WHERE 'XX' IS THE CONTROL UNIT ID OF THE DEVICES TO BE REPORTED
* //*
* //*   NOTE THAT A MAXIMUM OF 20 DEVICE DD CARDS IS ALLOWED
* //*
* //DV11   DD  SYSOUT=A   DETAIL RPT -    DEVICES (110-11F)
* //DV14   DD  SYSOUT=A   DETAIL RPT -    DEVICES (140-14F)
* //DV15   DD  SYSOUT=A   DETAIL RPT -    DEVICES (150-15F)
* //DV17   DD  SYSOUT=A   DETAIL RPT -    DEVICES (170-17F)
* //DV28   DD  SYSOUT=A   DETAIL RPT -    DEVICES (280-28F)
* //DV29   DD  SYSOUT=A   DETAIL RPT -    DEVICES (290-29F)
* //DV3C   DD  SYSOUT=A   DETAIL RPT -    DEVICES (3C0-3CF)
* //DV3D   DD  SYSOUT=A   DETAIL RPT -    DEVICES (3D0-3DF)
         EJECT
* //*
* //* PGNNN IS THE DDNAME FORMAT OF THE PERFORMANCE GROUP DETAIL
* //*   REPORTS WHERE NNN IS ANY NUMBER (001 - 999).
* //*
* //*   NOTE THAT A MAXIMUM OF 30 PERFORMANCE GROUPS ARE ALLOWED
* //*
* //PG001  DD  SYSOUT=A   DETAIL RPT -    PERFORMANCE GROUP 1
* //PG002  DD  SYSOUT=A   DETAIL RPT -    PERFORMANCE GROUP 2
* //PG003  DD  SYSOUT=A   DETAIL RPT -    PERFORMANCE GROUP 3
* //PG004  DD  SYSOUT=A   DETAIL RPT -    PERFORMANCE GROUP 4
* //PG005  DD  SYSOUT=A   DETAIL RPT -    PERFORMANCE GROUP 5
* //PG006  DD  SYSOUT=A   DETAIL RPT -    PERFORMANCE GROUP 6
* //PG007  DD  SYSOUT=A   DETAIL RPT -    PERFORMANCE GROUP 7
* //PG008  DD  SYSOUT=A   DETAIL RPT -    PERFORMANCE GROUP 8
* //PG009  DD  SYSOUT=A   DETAIL RPT -    PERFORMANCE GROUP 9
* //PG010  DD  SYSOUT=A   DETAIL RPT -    PERFORMANCE GROUP 10
* //PG011  DD  SYSOUT=A   DETAIL RPT -    PERFORMANCE GROUP 11
* //PG012  DD  SYSOUT=A   DETAIL RPT -    PERFORMANCE GROUP 12
* //PG013  DD  SYSOUT=A   DETAIL RPT -    PERFORMANCE GROUP 13
* //PG014  DD  SYSOUT=A   DETAIL RPT -    PERFORMANCE GROUP 14
* //PG015  DD  SYSOUT=A   DETAIL RPT -    PERFORMANCE GROUP 15
* //PG016  DD  SYSOUT=A   DETAIL RPT -    PERFORMANCE GROUP 16
* //*
* //       PEND
* //MAPMP   EXEC  MAPMP,RMFDSN='SYS1.RMFDATA'
* //*
         TITLE 'RMFMAP -   RMF DATA REDUCTION PROGRAM'
RMFMAP   CSECT
         SAVE  (14,12)
         LR    R3,R15
         USING RMFMAP,R3
         L     R15,BASE13
         ST    R13,4(0,R15)
         LR    R13,R15
         USING SAVE,R13
         B     PARM
         SPACE 1
BASE13   DC    A(SAVE)
         EJECT
PARM     L     R1,0(0,R1)          PARM ADDR
         MVC   LINE(31),=31C'0'
         MVZ   LINE(31),6(R1)
         CLC   LINE(31),=31C'0'    VALID PARMS
         BE    PARM1               YES, PROCESS
         WTO   'RMFMAP ERROR -   INVALID PARAMETERS',                  X
               ROUTCDE=(11)
         ABEND 77
         EJECT
PARM1    MVC   SYSTEM(4),2(R1)     SYSTEM ID
         PACK  DOUBLE(8),34(3,R1)  MIP RATE VALUE
         CVB   R14,DOUBLE
         ST    R14,MIPRATE
         SPACE 1
PARM2    MVC   TIMELO(4),16(R1)    LO ARGUMENT TIME
         MVC   TIMEHI(4),20(R1)    HI ARGUMENT TIME
         MVC   DATELO(5),24(R1)    LO ARGUMENT DATE
         PACK  DATELO+8(4),DATELO(5)
         MVC   DATEHI(5),29(R1)    HI ARGUMENT DATE
         PACK  DATEHI+8(4),DATEHI(5)
         MVC   DEVLINE+4(2),6(R1)  INTERVAL
         MVC   SELLO(4),8(R1)      SELECTED AVG -   START TIME
         MVC   SELHI(4),12(R1)     SELECTED AVG -   STOP TIME
         LA    R1,OPENLIST         OPEN DCB LIST
         OPEN  MF=(E,(1))
         L     R4,16               CVT
         L     R4,0(0,R4)          TCB WORDS
         L     R4,4(0,R4)          CURRENT TCB
         L     R4,12(0,R4)         TIOT
         L     R15,=A(SMF)
         LH    R15,40(0,R15)       TIOT OFFSET
         LA    R15,0(R15,R4)       TIOT ENTRY ADDR
         L     R15,12(0,R15)       JFCB ADDR
         SRL   R15,8               RIGHT ADJUST JFCB ADDR
         LA    R15,16(0,R15)          ADD INDEX TO DATA
         MVC   DSNDSN(44),0(R15)   SMF DSN
         MVC   DSNVOL(6),118(R15)  SMF VOL
         LA    R4,24(0,R4)         DD ENTRIES
         L     R6,=A(CHNLIST)      CHANNEL OUTPUT DCBS
         L     R7,=A(DVNLIST)      DEVICE OUTPUT DCBS
         L     R8,=A(PGNLIST)      PERF GROUP OUTPUT DCBS
         SR    R5,R5
         EJECT
TIOTLOOP IC    R5,0(0,R4)          LOAD DD LENGTH
         LTR   R5,R5               TIOT END
         BZ    SMFBASE             YES, GO PROCESS SMF DATA
         CLC   4(2,R4),=C'CH'      CHANNEL OUTPUT DD
         BE    TIOTTRNS            YES, PROCESS
         CLC   4(2,R4),=C'PG'      PERF GROUP OUTPUT DD
         BE    TIOPG               YES, PROCESS
         CLC   4(2,R4),=C'DV'      DEVICE OUTPUT DD
         BE    TIODEV              YES, PROCESS
         SPACE 1
TIOTNEXT LA    R4,0(R4,R5)         NEXT DD ENTRY ADDR
         CLC   0(4,R6),=F'0'       END OF ENTRIES
         BNE   TIOTLOOP            NO, CHECK NEXT
         CLC   0(4,R7),=F'0'       END OF DCBS
         BNE   TIOTLOOP            NO, CHECK NEXT
         CLC   0(4,R8),=F'0'       END OF DCBS
         BE    SMFBASE             YES, GO PROCESS SMF DATA
         B     TIOTLOOP            CHECK NEXT
         SPACE 1
TIOTTRNS CLC   0(4,R6),=F'0'       END OF DCBS
         BE    TIOTNEXT
         MVC   4(4,R6),6(R4)       MOVE CPU/CHAN ID
         MVC   8(4,R6),6(R4)          TO HEX AND CHAR AREAS
         TR    4(4,R6),CHTABLE     TRANSLATE DD ENTRY ID
         MVC   K0000(4),=F'0'      TEST
         MVZ   K0000(4),4(R6)         FOR VALID
         CLC   K0000(4),=F'0'            TRANSLATE
         BNE   TIOTERR             NO, ERROR
         L     R2,0(0,R6)          LOAD DCB ADDR
         MVC   42(4,R2),6(R4)      FILL IN DDNAME
         OPEN  ((R2),(OUTPUT))
         LA    R6,240(0,R6)        NEXT ENTRY
         B     TIOTNEXT            GO CHECK NEXT
         EJECT
TIOPG    CLC   0(4,R8),=F'0'       END OF DCBS
         BE    TIOTNEXT            YES, GO BACK
         MVC   K0000(3),=3C'0'
         MVZ   K0000(3),6(R4)
         CLC   K0000(3),=3C'0'     NUMERIC PERF GROUP NO.
         BNE   TIOTERR             NO, ERROR
         L     R2,0(0,R8)          PERF GROUP DCB
         MVC   5(3,R8),6(R4)       CHAR PERF GROUP
         PACK  DOUBLE(8),6(3,R4)
         CVB   R1,DOUBLE
         STC   R1,4(0,R8)          BINARY PERF GROUP
         MVC   42(3,R2),6(R4)      FILL IN DD NAME IN DCB
         OPEN  ((R2),(OUTPUT))
         LA    R8,1756(0,R8)       NEXT TABLE ENTRY
         B     TIOTNEXT
         SPACE 3
TIODEV   CLC   0(4,R7),=F'0'       END OF DCBS
         BE    TIOTNEXT            YES, GO BACK
         CLI   8(R4),C' '          VALIDATE NAME
         BNE   TIOTERR
         MVC   4(2,R7),6(R4)       SAVE UNIT ID
         L     R2,0(0,R7)          DCB ADDR
         MVC   42(2,R2),6(R4)      FILL IN DDNAME
         OPEN  ((R2),(OUTPUT))
         LA    R7,12(0,R7)         NEXT ENTRY
         B     TIOTNEXT
         EJECT
TIOTERR  MVC   TIOTWTO+42(8),4(R4)
TIOTWTO  WTO   'RMFMAP ERROR -   INVALID DDNAME,  XXXXXXXX',           X
               ROUTCDE=(11)
         ABEND 77
         EJECT
         CNOP  0,8
SMFBASE  LA    R3,SMFBASE
         DROP  R3
         USING SMFBASE,R3
         LA    R9,4095(0,R3)
         LA    R9,1(0,R9)
         USING SMFBASE+4096,R9
         SPACE 3
SMFGET   L     R2,=A(SMF)
         GET   (R2)
         LA    R11,4(0,R1)         POINT TO RECORD
         SPACE 1
SMFGET1  CLC   10(4,R11),SYSTEM    SID MATCH
         BNE   SMFGET              NO, NEXT RECORD
         CLC   6(4,R11),DATELO+8   DATE IN SPECIFIED RANGE
         BL    SMFGET              NO, NEXT RECORD
         CLC   6(4,R11),DATEHI+8   DATE IN SPECIFIED RANGE
         BH    SMFGET              NO, NEXT RECORD
         SPACE 1
SMFBR    BC    15,SMFFIRST         1ST RECORD INFO EXTRACT
         SPACE 1
         UNPK  LINE(6),16(4,R11)   TIME
         CLC   LINE(4),TIMELO      TIME IN SPECIFIED RANGE
         BL    SMFGET              NO, NEXT RECORD
         CLC   LINE(4),TIMEHI      TIME IN SPECIFIED RANGE
         BH    SMFGET              NO, NEXT RECORD
         CLI   1(R11),70           CPU ACTIVITY RECORD
         BE    CPUFORM             YES, PROCESS
         BL    SMFGET              NOT RMF TYPE
         CLI   1(R11),71           PAGING ACTIVITY RECORD
         BE    PAGFORM             YES, PROCESS
         CLI   1(R11),72           WORKLOAD ACTIVITY RECORD
         BE    PGFORM              YES, PROCESS
         CLI   1(R11),73           CHANNEL ACTIVITY RECORD
         BE    CHFORM              YES, PROCESS
         CLI   1(R11),74           DEVICE ACTIVITY RECORD
         BE    DEVFORM             YES, PROCESS
         CLI   1(R11),76           TRACE ACTIVITY RECORD
         BE    TRFORM              YES, PROCESS
         B     SMFGET              NOT RMF TYPE
         SPACE 3
SMFFIRST UNPK  DSNDATE(3),7(2,R11) YEARS
         MVI   DSNDATE+2,C'.'
         UNPK  DSNDATE+3(3),8(2,R11) DAYS
         MVC   DSNSYS(4),10(R11)   SID
         MVI   SMFBR+1,X'00'       TURN OFF BRANCH
         B     SMFGET1
         EJECT
CPUFORM  BAL   R12,TIME            SET UP PRINT LINE
         L     R15,=A(INTERVAL)
         BALR  R12,R15             GET RMF INTERVAL
         LA    R10,LINE+6          1ST LINE AREA
         ST    R15,SAMPINTV        SAVE RMF INTERVAL
         LH    R4,50(0,R11)        LOAD NO. OF CPU SECTIONS
         LA    R5,48(0,R11)        CPU CONTROL SECTION ADDR
         AH    R5,0(0,R5)          1ST CPU DATA SECTION
         SPACE 1
CPUFORM1 TM    11(R5),X'01'        CPU ONLINE
         BO    CPUFORM3            YES, GO PROCESS
         SPACE 1
CPUFORM2 LA    R5,16(0,R5)         NEXT CPU DATA SECTION
         BCT   R4,CPUFORM1
         SPACE 1
CPUOUT   L     R10,=A(CPUHDR)      CPU HDR LINE
         LA    R2,CPULINCT
         L     R11,=A(CPU)         CPU OUTPUT DCB
         BAL   R12,PRINT
         B     SMFGET
         SPACE 3
PCTTOTL  SR    R14,R14
         LR    R15,R1
         D     R14,=F'5'           DIVIDE PERCENT/PAGES BY 5
         SLL   R15,2               TABLE ADDRESS INCREMENT
         LA    R15,4(R2,R15)       COUNT FIELD ADDRESS
         L     R14,0(0,R15)
         LA    R14,1(0,R14)        INCR COUNT
         ST    R14,0(0,R15)           OF OCCURRENCES
         L     R14,0(0,R2)         INCR
         LA    R14,1(0,R14)           TOTAL
         ST    R14,0(0,R2)               OCCURRENCES
         BR    R12
         EJECT
CPUFORM3 LH    R2,8(0,R5)          CPU ID
         MH    R2,=H'64'           RELATIVE LINE POSITION
         LA    R10,LINE+6(R2)      PRINT AREA ADDR
         LM    R14,R15,0(R5)       LOAD WAIT TIME
         SRDL  R14,12              WAIT TIME IN MICROSECS
         LR    R8,R15              SAVE WAIT TIME
         D     R14,=F'10'          CONVERT TO MILLISECONDS X 100 PCT
         SR    R14,R14
         D     R14,SAMPINTV        DIVIDE WAIT TIME BY INTERVAL
         LA    R14,100
         SR    R14,R15             BUSY TIME
         BNP   CPUFORM2            BYPASS OCCASSIONAL BAD DATA 0C4
         LH    R2,8(0,R5)          CPUID
         SLL   R2,2                MULT BY 4
         L     R1,CPUSMPA(R2)
         LA    R1,1(0,R1)
         ST    R1,CPUSMPA(R2)      ADD 1 TO AVG SAMPLES
         LR    R1,R14
         A     R1,CPUTOTA(R2)
         ST    R1,CPUTOTA(R2)      ADD TO AVG TOTAL
         CLC   LINE(4),SELLO       SEL TIME RANGE
         BL    *+36
         CLC   LINE(4),SELHI       SEL TIME RANGE
         BH    *+26
         L     R1,CPUSMP1(R2)
         LA    R1,1(0,R1)
         ST    R1,CPUSMP1(R2)      ADD 1 TO SEL SAMPLES
         LR    R1,R14
         A     R1,CPUTOT1(R2)
         ST    R1,CPUTOT1(R2)      ADD TO SEL TOTAL
         C     R14,CPUMIN(R2)
         BNL   *+8
         ST    R14,CPUMIN(R2)      SAVE MIN VALUE
         C     R14,CPUMAX(R2)
         BNH   *+8
         ST    R14,CPUMAX(R2)      SAVE MAX VALUE
         CVD   R14,DOUBLE
         LTR   R2,R2               ONLY CPU0
         BNZ   *+16
         LR    R1,R14              SAVE PERCENT
         L     R2,=A(CPUPCNT)      PERCENT ACCUMULATORS
         BAL   R12,PCTTOTL
         LR    R14,R1              RELOAD PERCENT
         MVC   7(4,R10),=X'40212020'
         ED    7(4,R10),DOUBLE+6
         SRL   R14,1               DIVIDE BY 2
         CH    R14,=H'50'          MAX
         BNH   *+8
         LH    R14,=H'50'          FORCE MAX
         LA    R15,12(0,R10)
         BAL   R12,ASTERISK        PROPAGATE ASTERISKS
         SR    R14,R14
         LR    R15,R8              RELOAD WAIT TIME
         D     R14,=F'1000'        MILLISECONDS
         SR    R14,R14
         D     R14,=F'1000'        SECONDS AND MILLISECONDS
         CVD   R14,DOUBLE
         UNPK  4(3,R10),DOUBLE+6(2) FORMAT MILLISECONDS
         OI    6(R10),X'F0'
         SR    R14,R14
         D     R14,=F'60'          MINUTES AND SECONDS
         CVD   R14,DOUBLE
         UNPK  2(2,R10),DOUBLE+6(2) FORMAT SECONDS
         OI    3(R10),X'F0'
         CVD   R15,DOUBLE
         UNPK  0(2,R10),DOUBLE+6(2) FORMAT MINUTES
         OI    1(R10),X'F0'
         B     CPUFORM2
         EJECT
PAGFORM  BAL   R12,TIME            SET UP PRINT LINE
         L     R15,=A(INTERVAL)
         BALR  R12,R15             GET RMF INTERVAL
         SR    R14,R14
         D     R14,=F'1000'        SECONDS IN INTERVAL
         LA    R15,1(0,R15)
         ST    R15,SAMPINTV        SAVE INTERVAL SECONDS
         SPACE 1
PAGFORM1 BC    15,PAGFORM2
         LA    R10,LINE+5
         LA    R2,4
         L     R4,52(0,R11)        PVTNPIN
         A     R4,56(0,R11)        PVTNPOUT
         A     R4,68(0,R11)        PVTSPIN
         A     R4,72(0,R11)        PVTSPOUT
         A     R4,76(0,R11)        PVTVAMI
         A     R4,80(0,R11)        PVTVAMO
         LR    R5,R4               SAVE ACTUAL PAGING
         BAL   R12,PAGEDIT         ACTUAL PAGING
         L     R1,PAGPSEC          ACTUAL PAGING/SEC
         L     R2,=A(PAGPCNT)
         BAL   R12,PCTTOTL
         LA    R10,LINE+30
         LA    R2,16
         L     R4,52(0,R11)        PVTNPIN
         A     R4,56(0,R11)        PVTNPOUT
         S     R4,88(0,R11)        PVTCAIN
         S     R4,92(0,R11)        PVTCAOUT
         BAL   R12,PAGEDIT         TOTAL ADDRESS SPACE
         LA    R10,LINE+55
         LA    R2,36
         L     R4,88(0,R11)        PVTCAIN
         A     R4,92(0,R11)        PVTCAOUT
         BAL   R12,PAGEDIT         TOTAL COMMON
         LA    R10,LINE+80
         LA    R2,56
         L     R4,76(0,R11)        PVTVAMI
         A     R4,80(0,R11)        PVTVAMO
         BAL   R12,PAGEDIT         TOTAL VIO
         LA    R10,LINE+105
         LA    R2,76
         L     R4,68(0,R11)        PVTSPIN
         A     R4,72(0,R11)        PVTSPOUT
         BAL   R12,PAGEDIT         TOTAL SWAP
         LA    R2,PAGLNCT1
         L     R10,=A(PAGHDR1)
         LR    R6,R11              SAVE RECORD ADDR
         L     R11,=A(PAG1)
         BAL   R12,PRINT
         LR    R11,R6              RELOAD RECORD ADDR
         LA    R10,LINE+5
         SR    R2,R2
         LR    R4,R5               LOAD ACTUAL PAGING
         A     R4,60(0,R11)        PVTNPREC
         A     R4,84(0,R11)        PVTVAMR
         BAL   R12,PAGEDIT         TOTAL PAGING
         LA    R10,LINE+30
         LA    R2,8
         L     R4,60(0,R11)        PVTNPREC
         A     R4,84(0,R11)        PVTVAMR
         BAL   R12,PAGEDIT         TOTAL RECLAIM
         LA    R10,LINE+55
         LA    R2,32
         L     R4,60(0,R11)        PVTNPREC
         S     R4,96(0,R11)        PVTCAREC
         BAL   R12,PAGEDIT         ADDRSPC RECLAIM
         LA    R10,LINE+80
         LA    R2,52
         L     R4,96(0,R11)        PVTCAREC
         BAL   R12,PAGEDIT         COMMON RECLAIM
         LA    R10,LINE+105
         LA    R2,72
         L     R4,84(0,R11)        PVTVAMR
         BAL   R12,PAGEDIT         VIO RECLAIM
         LA    R2,PAGLNCT2
         L     R10,=A(PAGHDR2)
         LR    R6,R11              SAVE RECORD ADDR
         L     R11,=A(PAG2)
         BAL   R12,PRINT
         LR    R11,R6              RELOAD RECORD ADDR
         LA    R10,LINE+5
         LA    R2,92
         L     R4,52(0,R11)        PVTNPIN
         A     R4,56(0,R11)        PVTNPOUT
         S     R4,88(0,R11)        PVTCAIN
         S     R4,92(0,R11)        PVTCAOUT
         LR    R5,R4               SAVE ACTUAL PAGING
         A     R4,60(0,R11)        PVTNPREC
         S     R4,96(0,R11)        PVTCAREC
         BAL   R12,PAGEDIT         TOTAL ADDRESS SPACE
         LA    R10,LINE+30
         LA    R2,20
         LR    R4,R5
         BAL   R12,PAGEDIT         ACTUAL ADDRESS SPACE
         LA    R10,LINE+55
         LA    R2,24
         L     R4,52(0,R11)        PVTNPIN
         S     R4,88(0,R11)        PVTCAIN
         BAL   R12,PAGEDIT         PAGEIN ADDRESS SPACE
         LA    R10,LINE+80
         LA    R2,28
         L     R4,56(0,R11)        PVTNPOUT
         S     R4,92(0,R11)        PVTCAOUT
         BAL   R12,PAGEDIT         PAGEOUT ADDRESS SPACE
         LA    R10,LINE+105
         LA    R2,32
         L     R4,60(0,R11)        PVTNPREC
         S     R4,96(0,R11)        PVTCAREC
         BAL   R12,PAGEDIT         RECLAIMS ADDRESS APACE
         LA    R2,PAGLNCT3
         L     R10,=A(PAGHDR3)
         LR    R6,R11              SAVE RECORD ADDR
         L     R11,=A(PAG3)
         BAL   R12,PRINT
         LR    R11,R6              RELOAD RECORD ADDR
         LA    R10,LINE+5
         LA    R2,92
         L     R4,88(0,R11)        PVTCAIN
         A     R4,92(0,R11)        PVTCAOUT
         LR    R5,R4               SAVE ACTUAL COMMON
         A     R4,96(0,R11)        PVTCAREC
         BAL   R12,PAGEDIT         TOTAL COMMON
         LA    R10,LINE+30
         LA    R2,40
         LR    R4,R5
         BAL   R12,PAGEDIT         ACTUAL COMMON
         LA    R10,LINE+55
         LA    R2,44
         L     R4,88(0,R11)        PVTCAIN
         BAL   R12,PAGEDIT         PAGEIN COMMON
         LA    R10,LINE+80
         LA    R2,48
         L     R4,92(0,R11)        PVTCAOUT
         BAL   R12,PAGEDIT         PAGEOUT COMMON
         LA    R10,LINE+105
         LA    R2,52
         L     R4,96(0,R11)        PVTCAREC
         BAL   R12,PAGEDIT         RECLAIMS COMMON
         LA    R2,PAGLNCT4
         L     R10,=A(PAGHDR4)
         LR    R6,R11              SAVE RECORD ADDR
         L     R11,=A(PAG4)
         BAL   R12,PRINT
         LR    R11,R6              RELOAD RECORD ADDR
         LA    R10,LINE+5
         LA    R2,92
         L     R4,76(0,R11)        PVTVAMI
         A     R4,80(0,R11)        PVTVAMO
         LR    R5,R4               SAVE ACTUAL VIO
         A     R4,84(0,R11)        PVTVAMR
         BAL   R12,PAGEDIT         TOTAL VIO
         LA    R10,LINE+30
         LA    R2,60
         LR    R4,R5
         BAL   R12,PAGEDIT         ACTUAL VIO
         LA    R10,LINE+55
         LA    R2,64
         L     R4,76(0,R11)        PVTVAMI
         BAL   R12,PAGEDIT         PAGEIN VIO
         LA    R10,LINE+80
         LA    R2,68
         L     R4,80(0,R11)        PVTVAMO
         BAL   R12,PAGEDIT         PAGEOUT VIO
         LA    R10,LINE+105
         LA    R2,72
         L     R4,84(0,R11)        PVTVAMR
         BAL   R12,PAGEDIT         RECLAIMS VIO
         LA    R2,PAGLNCT5
         L     R10,=A(PAGHDR5)
         LR    R6,R11              SAVE RECORD ADDR
         L     R11,=A(PAG5)
         BAL   R12,PRINT
         LR    R11,R6              RELOAD RECORD ADDR
         LA    R10,LINE+5
         LA    R2,92
         L     R4,68(0,R11)        PVTSPIN
         A     R4,72(0,R11)        PVTSPOUT
         BAL   R12,PAGEDIT         TOTAL SWAP
         LA    R10,LINE+30
         LA    R2,80
         L     R4,64(0,R11)        PVTNSWPS
         BAL   R12,PAGEDIT         SWAP SEQUENCES
         LA    R10,LINE+55
         LA    R2,84
         L     R4,68(0,R11)        PVTSPIN
         BAL   R12,PAGEDIT         PAGEIN SWAP
         LA    R10,LINE+80
         LA    R2,88
         L     R4,72(0,R11)        PVTSPOUT
         BAL   R12,PAGEDIT         PAGEOUT SWAP
         LA    R10,LINE+105
         LA    R2,12
         L     R4,52(0,R11)        PVTNPIN
         A     R4,60(0,R11)        PVTNPREC
         BAL   R12,PAGEDIT         PAGE FAULTS
         LA    R2,PAGLNCT6
         L     R10,=A(PAGHDR6)
         LR    R6,R11              SAVE RECORD ADDR
         L     R11,=A(PAG6)
         BAL   R12,PRINT
         LR    R11,R6              RELOAD RECORD ADDR
         B     FRMFORM
         EJECT
PAGEDIT  SR    R14,R14
         LR    R15,R4              LOAD PAGES
         D     R14,SAMPINTV        DIVIDE BY SECONDS IN INTERVAL
         LA    R1,1(0,R15)         SAVE
         ST    R1,PAGPSEC             PAGES/SEC
         CVD   R15,DOUBLE
         MVC   0(4,R10),=X'40202120'
         ED    0(4,R10),DOUBLE+6   FORMAT NO. OF PAGES/SEC
         MVI   4(R10),C'.'
         MH    R14,=H'10'          SET UP TENTHS
         SRDL  R14,32
         D     R14,SAMPINTV        CALCULATE TENTHS
         CVD   R15,DOUBLE
         UNPK  5(1,R10),DOUBLE+7(1)
         OI    5(R10),X'F0'
         LR    R14,R1              RELOAD PAGES/SEC
         LTR   R4,R4               ZERO PAGES EXACTLY
         BNZ   *+6                 LET IT SAY 1
         SR    R14,R14             FORCE ZERO
         L     R1,PAGSMPA(R2)
         LA    R1,1(0,R1)
         ST    R1,PAGSMPA(R2)      ADD 1 TO AVG SAMPLES
         LR    R1,R14
         A     R1,PAGTOTA(R2)
         ST    R1,PAGTOTA(R2)      ADD TO AVG TOTAL
         CLC   LINE(4),SELLO       SEL TIME RANGE
         BL    *+36
         CLC   LINE(4),SELHI       SEL TIME RANGE
         BH    *+26
         L     R1,PAGSMP1(R2)
         LA    R1,1(0,R1)
         ST    R1,PAGSMP1(R2)      ADD 1 TO SEL SAMPLES
         LR    R1,R14
         A     R1,PAGTOT1(R2)
         ST    R1,PAGTOT1(R2)      ADD TO SEL TOTAL
         C     R14,PAGMIN(R2)
         BNL   *+8
         ST    R14,PAGMIN(R2)      SAVE MIN VALUE
         C     R14,PAGMAX(R2)
         BNH   *+8
         ST    R14,PAGMAX(R2)      SAVE MAX VALUE
         LR    R4,R14              SAVE PAGES/SEC
         SRL   R14,1               DIVIDE BY 2
         CH    R14,=H'18'          MAX PRINT  (EQUAL TO 36 PAGES/SEC)
         BNH   *+8                 NO, BYPASS MAX SET
         LH    R14,=H'18'          SET MAX
         LA    R15,7(0,R10)
         LR    R6,R12              SAVE RETURN ADDR
         BAL   R12,ASTERISK        PROPAGATE ASTERISKS
         LR    R12,R6              RESTORE RETURN ADDR
         BR    R12
         EJECT
PAGFORM2 MVI   PAGFORM1+1,X'00'
         MVC   LINE(4),LINE+10     CLEAR TIME
         MVC   LINE+10(14),=CL14'RMF INTERVAL -'
         MVC   LINE+26(2),DEVLINE+4
         MVC   LINE+29(3),=CL3'MIN'
         MVC   LINE+36(11),=CL11'RMF CYCLE -'
         UNPK  LINE+50(4),45(3,R11)
         OI    LINE+53,X'F0'
         MVC   LINE+49(1),LINE+50
         MVI   LINE+50,C'.'
         MVC   LINE+55(3),=CL3'SEC'
         MVC   LINE+62(13),=CL13'SEL AVERAGE -'
         MVC   LINE+77(4),SELLO
         MVI   LINE+81,C'-'
         MVC   LINE+82(4),SELHI
         MVC   LINE+90(7),=CL7'DATES -'
         MVC   LINE+99(5),DATELO
         MVI   LINE+104,C'-'
         MVC   LINE+105(5),DATEHI
         MVC   LINE+114(7),=CL7'TIMES -'
         MVC   LINE+123(4),TIMELO
         MVI   LINE+127,C'-'
         MVC   LINE+128(4),TIMEHI
         LA    R2,MAPLNCT1
         L     R10,=A(MAPHDR)
         LR    R6,R11
         L     R11,=A(MAP1)
         MVI   AREA,X'11'
         BAL   R12,PRINT
         MVI   AREA,X'09'
         LR    R11,R6
         BAL   R12,TIME            GO SET UP PRINT LINE
         B     PAGFORM1
         EJECT
FRMFORM  BAL   R12,TIME            SET UP PRINT LINE
         LA    R5,FRAMTAB          FRAME COUNTS INCR TABLE
         LA    R4,4                GROUPS/LINE
         LA    R6,LINE+19          LINE BEGIN
         LA    R7,2                NO. OF LINES
         MVC   LINE+8(8),=CL8'PAGEABLE'
         SR    R2,R2
         SPACE 1
FRMFORM1 L     R15,0(0,R5)         COUNT FIELD INCR
         LA    R15,0(R15,R11)      START OF COUNT FIELDS
         MVC   0(7,R6),=X'4020206B202120'
         MVC   9(7,R6),=X'4020206B202120'
         MVC   18(7,R6),=X'4020206B202120'
         L     R14,0(0,R15)        MINIMUM
         C     R14,FRMMIN(R2)
         BNL   *+8
         ST    R14,FRMMIN(R2)      SAVE MIN VALUE
         CVD   R14,DOUBLE
         ED    0(7,R6),DOUBLE+5
         L     R14,4(0,R15)        MAXIMUM
         C     R14,FRMMAX(R2)
         BNH   *+8
         ST    R14,FRMMAX(R2)      SAVE MAX VALUE
         CVD   R14,DOUBLE
         ED    9(7,R6),DOUBLE+5
         L     R14,8(0,R15)        AVERAGE
         L     R1,FRMSMPA(R2)
         LA    R1,1(0,R1)
         ST    R1,FRMSMPA(R2)      ADD 1 TO AVG SAMPLES
         LR    R1,R14
         A     R1,FRMTOTA(R2)
         ST    R1,FRMTOTA(R2)      ADD TO AVG TOTAL
         CLC   LINE(4),SELLO       SEL TIME RANGE
         BL    *+36
         CLC   LINE(4),SELHI       SEL TIME RANGE
         BH    *+26
         L     R1,FRMSMP1(R2)
         LA    R1,1(0,R1)
         ST    R1,FRMSMP1(R2)      ADD 1 TO SEL SAMPLES
         LR    R1,R14
         A     R1,FRMTOT1(R2)
         ST    R1,FRMTOT1(R2)      ADD TO SEL TOTAL
         LA    R2,4(0,R2)          NEXT GROUP
         CVD   R14,DOUBLE
         ED    18(7,R6),DOUBLE+5
         LA    R5,4(0,R5)          NEXT INCR
         LA    R6,29(0,R6)
         BCT   R4,FRMFORM1
         LA    R4,4                SET UP NEXT PASS
         LA    R6,LINE+19
         LA    R2,FRMLINCT         FRAME LINE COUNT
         L     R10,=A(FRMHDR)      FRAME OUTPUT HDR
         LR    R8,R11              SAVE RECORD ADDR
         L     R11,=A(FRAME)       FRAME OUTPUT DCB
         BAL   R12,PRINT
         LR    R11,R8              RELOAD RECORD ADDR
         MVC   LINE+8(8),=CL8'FIXED'
         LA    R2,16               FIXED TOTALS INCR
         BCT   R7,FRMFORM1         GO FORMAT 2ND LINE
         EJECT
SWPFORM  BAL   R12,TIME            SET UP PRINT LINE
         LA    R5,SWAPTAB          SWAP COUNTS INCR TABLE
         LA    R4,10               NUMBER OF SWAP COUNT FIELDS
         LA    R6,LINE+6
         LA    R7,2                NO. OF PASSES
         SR    R2,R2
         SPACE 1
SWPFORM1 L     R15,0(0,R5)         LOAD INCR
         L     R15,0(R15,R11)      LOAD APPROPRIATE SWAP COUNT
         L     R1,SWPSMPA(R2)
         LA    R1,1(0,R1)
         ST    R1,SWPSMPA(R2)      ADD 1 TO AVG SAMPLES
         LR    R1,R15
         A     R1,SWPTOTA(R2)
         ST    R1,SWPTOTA(R2)      ADD TO AVG TOTAL
         CLC   LINE(4),SELLO       SEL TIME RANGE
         BL    *+36
         CLC   LINE(4),SELHI       SEL TIME RANGE
         BH    *+26
         L     R1,SWPSMP1(R2)
         LA    R1,1(0,R1)
         ST    R1,SWPSMP1(R2)      ADD 1 TO SEL SAMPLES
         LR    R1,R15
         A     R1,SWPTOT1(R2)
         ST    R1,SWPTOT1(R2)      ADD TO SEL TOTAL
         C     R15,SWPMIN(R2)
         BNL   *+8
         ST    R15,SWPMIN(R2)      SAVE MIN VALUE
         C     R15,SWPMAX(R2)
         BNH   *+8
         ST    R15,SWPMAX(R2)      SAVE MAX VALUE
         LA    R2,4(0,R2)          NEXT GROUP
         CVD   R15,DOUBLE
         SR    R14,R14
         MVC   EDIT(6),=X'402020202120'
         ED    EDIT(6),DOUBLE+5
         MVC   0(5,R6),EDIT+1
         D     R14,SAMPINTV        SWAPS/SECOND
         CVD   R15,DOUBLE
         UNPK  6(1,R6),DOUBLE+7(1)
         OI    6(R6),X'F0'
         MVI   7(R6),C'.'
         SRDL  R14,32
         M     R14,=F'100'
         D     R14,SAMPINTV        SWAPS/HUNDREDTHS OF SECS
         CVD   R15,DOUBLE
         UNPK  8(2,R6),DOUBLE+6(2)
         OI    9(R6),X'F0'
         LA    R6,10(0,R6)         NEXT LINE POSITION
         LA    R5,4(0,R5)          NEXT INCR
         BCT   R4,SWPFORM1
         LA    R6,3(0,R6)
         LA    R4,1                ALLOW 1 MORE PASS
         BCT   R7,SWPFORM1         DO TOTALS
         SR    R14,R14
         L     R15,68(0,R11)       PAGES SWAPPED IN
         D     R14,64(0,R11)       PAGES/SWAPIN
         CVD   R15,DOUBLE
         MVC   0(4,R6),=X'40202120'
         ED    0(4,R6),DOUBLE+6
         LA    R6,6(0,R6)
         SR    R14,R14
         L     R15,72(0,R11)       PAGES SWAPPED OUT
         D     R14,64(0,R11)       PAGES/SWAPOUT
         CVD   R15,DOUBLE
         MVC   0(4,R6),=X'40202120'
         ED    0(4,R6),DOUBLE+6
         LA    R2,SWPLINCT
         L     R10,=A(SWPHDR)
         L     R11,=A(SWAP)
         BAL   R12,PRINT
         B     SMFGET
         EJECT
CHFORM   BAL   R12,TIME            SET UP PRINT LINE
         L     R8,=A(CHNLIST)      LOAD CHANNEL OUTPUT DCB LIST
         MVC   SAMPINTV(4),32(R11) SAVE NO. OF SAMPLES
         SPACE 1
CHFORM0  BC    15,CHFORM6
         CLC   8(4,R8),=F'0'       END OF ACTIVE DCBS
         BE    SMFGET              YES, NEXT SMF RECORD
         LH    R4,50(0,R11)        LOAD NO. OF CHANNEL SECTIONS
         LA    R5,48(0,R11)        CHANNEL CONTROL SECTION ADDR
         AH    R5,0(0,R5)          1ST CHANNEL DATA SECTION
         SPACE 1
CHFORM1  TM    3(R5),X'01'         CHANNEL ONLINE
         BO    CHFORM3             YES, GO PROCESS
         SPACE 1
CHFORM2  LA    R5,16(0,R5)         NEXT CHANNEL DATA SECTION
         BCT   R4,CHFORM1
         B     CHNEXT
         SPACE 1
CHFORM3  LA    R10,LINE+4          1ST LINE AREA
         SR    R2,R2
         CLC   4(2,R8),1(R5)       CPU/CHANNEL MATCH
         BE    CHFORM4
         CLC   6(2,R8),1(R5)       CPU/CHANNEL MATCH
         BNE   CHFORM2             NO MATCH, TRY NEXT
         LA    R10,LINE+68         2ND LINE AREA
         LA    R2,4
         EJECT
CHFORM4  L     R14,4(0,R5)         SIO COUNT
         CVD   R14,DOUBLE
         MVC   0(9,R10),=X'40202020206B202120'
         ED    0(9,R10),DOUBLE+4
         L     R15,8(0,R5)         BUSY COUNT
         MVC   11(5,R10),=C'00/00'
         LTR   R15,R15             ANY BUSY COUNT
         BZ    CHFORM5             NO, BYPASS CALCULATION
         SR    R14,R14
         L     R15,12(0,R5)        CONCURRENCY COUNT
         MH    R15,=H'100'
         D     R14,SAMPINTV        PERCENT BUSY AND CPU WAIT
         LTR   R15,R15             ADJUST CONCURRENCY COUNT UNLESS ZERO
         BZ    *+8
         LA    R15,1(0,R15)
         CVD   R15,DOUBLE
         UNPK  14(2,R10),DOUBLE+6(2)
         OI    15(R10),X'F0'
         SR    R14,R14
         L     R15,8(0,R5)         BUSY COUNT
         MH    R15,=H'100'
         D     R14,SAMPINTV        PERCENT BUSY
         LA    R15,1(0,R15)        ADJUST UP
         CVD   R15,DOUBLE
         UNPK  11(2,R10),DOUBLE+6(2) FORMAT PERCENT BUSY
         OI    12(R10),X'F0'
         LR    R14,R15             LOAD PERCENT BUSY
         L     R1,CHNSMPA(R2,R8)
         LA    R1,1(0,R1)
         ST    R1,CHNSMPA(R2,R8)   ADD 1 TO AVG SAMPLES
         LR    R1,R14
         A     R1,CHNTOTA(R2,R8)
         ST    R1,CHNTOTA(R2,R8)   ADD TO AVG TOTAL
         CLC   LINE(4),SELLO       SEL TIME RANGE
         BL    *+36
         CLC   LINE(4),SELHI       SEL TIME RANGE
         BH    *+26
         L     R1,CHNSMP1(R2,R8)
         LA    R1,1(0,R1)
         ST    R1,CHNSMP1(R2,R8)   ADD 1 TO SEL SAMPLES
         LR    R1,R14
         A     R1,CHNTOT1(R2,R8)
         ST    R1,CHNTOT1(R2,R8)   ADD TO SEL TOTAL
         C     R14,CHNMIN(R2,R8)
         BNL   *+8
         ST    R14,CHNMIN(R2,R8)   SAVE MIN VALUE
         C     R14,CHNMAX(R2,R8)
         BNH   *+8
         ST    R14,CHNMAX(R2,R8)   SAVE MAX VALUE
         LR    R1,R14              LOAD PERCENT
         MH    R2,=H'22'           CPU0 OR CPU1 CH OFFSET
         LA    R2,CHNPCNT(R2,R8)   PERCENT ACCUMULATORS
         BAL   R12,PCTTOTL
         LR    R14,R1
         SRL   R14,1               DIVIDE BY 2
         CH    R14,=H'47'          MAX
         BNH   *+8
         LH    R14,=H'47'          FORCE MAX
         LA    R15,17(0,R10)
         BAL   R12,ASTERISK        PROPAGATE ASTERISKS
         SPACE 3
CHFORM5  CLI   LINE+15,C' '        IS LINE PART EMPTY
         BE    CHFORM2             YES, GO FILL
         CLI   LINE+79,C' '        IS LINE PART EMPTY
         BE    CHFORM2             YES, GO FILL
         SPACE 3
CHPRINT  LA    R10,CHNHDR          CHANNEL HDR
         LR    R4,R11              SAVE RECORD ADDR
         LA    R2,12(0,R8)         LOAD LINE COUNT ADDR
         L     R11,0(0,R8)         CHANNEL OUTPUT DCB
         MVC   CHNCPUA(1),8(R8)    FILL
         MVC   CHNCHNA(1),9(R8)       IN
         MVC   CHNCPUB(1),10(R8)         HDR
         MVC   CHNCHNB(1),11(R8)            LINE
         BAL   R12,PRINT
         B     CHNEXT1
         SPACE 1
CHNEXT   LR    R4,R11              SAVE RECORD ADDR
         CLI   LINE+15,C' '        IS LINE PART FULL
         BNE   CHPRINT             YES, GO PRINT
         CLI   LINE+79,C' '        IS LINE PART FULL
         BNE   CHPRINT             YES, GO PRINT
         SPACE 1
CHNEXT1  LA    R8,240(0,R8)        NEXT DCB
         LR    R11,R4              RESTORE RECORD ADDR
         B     CHFORM0
         EJECT
CHFORM6  MVI   CHFORM0+1,X'00'
         MVC   LINE(4),LINE+10
         LH    R4,50(0,R11)        NO. OF CHANNEL SECTIONS
         LA    R5,48(0,R11)        CHANNEL CONTROL SECTION ADDR
         AH    R5,0(0,R5)          1ST CHANNEL DATA SECTION
         LR    R6,R11              SAVE RECORD ADDR
         SPACE 1
CHFORM6A LH    R15,0(0,R5)         CPUID
         CVD   R15,DOUBLE
         MVC   LINE+10(4),=CL4'CPU'
         UNPK  LINE+14(1),DOUBLE+7(1)
         OI    LINE+14,X'F0'
         MVC   LINE+18(8),=CL8'CHANNEL'
         SR    R15,R15
         IC    R15,2(0,R5)         CHANNEL ID
         CH    R15,=H'10'          CHANNEL A-F
         BNL   CHFORM6B            YES
         LA    R15,57(0,R15)
         SPACE 1
CHFORM6B LA    R15,183(0,R15)      TRANSLATE CHANNEL ID
         STC   R15,LINE+26
         MVC   LINE+35(16),=CL16'BLOCK MULTIPLEX'
         TM    3(R5),X'20'         BLOCK MULTPLX CHANNEL
         BO    CHFORM6C            YES
         MVC   LINE+35(16),=CL16'BYTE MULTIPLEX'
         TM    3(R5),X'10'         BYTE MULTIPLEX CHANNEL
         BO    CHFORM6C            YES
         MVC   LINE+35(16),=CL16'SELECTOR'
         SPACE 1
CHFORM6C L     R10,=A(MAPHDR)
         LA    R2,CHCLINCT
         L     R11,=A(CLIST)
         BAL   R12,PRINT
         LA    R5,16(0,R5)         NECT SECTION
         BCT   R4,CHFORM6A
         LR    R11,R6              RELOAD RECORD ADDR
         BAL   R12,TIME
         B     CHFORM0
         EJECT
DEVFORM  BAL   R12,TIME            SET UP PRINT LINE
         MVC   SAMPINTV(4),32(R11) SAVE NUMBER OF SAMPLES
         SPACE 1
DEVFORM0 BC    15,DEVFORM6
         LH    R4,50(0,R11)        LOAD NO. OF DEVICE SECTIONS
         LA    R5,48(0,R11)        DEVICE CONTROL SECTION ADDR
         AH    R5,0(0,R5)          1ST DEVICE DATA SECTION
         SPACE 1
DEVFORM1 TM    3(R5),X'01'         DEVICE ONLINE
         BO    DEVFORM3            YES, PROCESS
         SPACE 1
DEVFORM2 AH    R5,DEVSIZE          NEXT DEVICE SECTION
         BCT   R4,DEVFORM1
         B     SMFGET
         SPACE 1
DEVFORM3 L     R1,16(0,R5)         I/O COUNT
         C     R1,SAMPINTV         MIN COUNT EQUAL SAMPLE COUNT
         BL    DEVFORM2            NO, TRY NEXT
         L     R8,=A(DVSLIST)      DEVICE TOTALS LIST
         SR    R6,R6
         L     R7,24(0,R5)         NO. OF QUEUED REQUESTS
         MH    R7,=H'100'
         D     R6,SAMPINTV         AVG. REQUESTS X 100
         SR    R14,R14
         L     R15,20(0,R5)        NO. OF BUSY SAMPLES
         MH    R15,=H'100'
         D     R14,SAMPINTV        PERCENT BUSY
         ST    R7,DEVQUE
         ST    R15,DEVBUSY
         CH    R7,=H'10'           AT LEAST .10 QUEUED REQUESTS
         BNL   DEVFORM4            YES, PROCESS
         CH    R15,=H'30'          AT LEAST 30 PERCENT BUSY
         BL    DEVFORM2            NO, TRY NEXT
         EJECT
DEVFORM4 UNPK  LINE+7(5),0(3,R5)   UNIT NAME
         MVI   LINE+10,C' '
         MVI   LINE+11,C' '
         NC    LINE+7(3),=3X'0F'
         TR    LINE+7(3),=C'0123456789ABCDEF'
         MVC   LINE+14(6),8(R5)    VOLSER
         SPACE 1
DEVFORMA CLI   0(R8),C' '          EMPTY SLOT
         BNE   DEVFORMB            NO, MATCH IT
         MVC   0(3,R8),LINE+7      UNIT NAME
         MVC   3(6,R8),LINE+14     VOLSER
         B     DEVFORMD            GO PROCESS
         SPACE 1
DEVFORMB CLI   0(R8),X'FF'         END OF SLOTS
         BE    DEVFORMD            YES, CONTINUE PROCESS
         CLC   0(3,R8),LINE+7      UNIT MATCH
         BNE   DEVFORMC            NO, TRY NEXT
         CLC   3(6,R8),LINE+14     VOLSER MATCH
         BE    DEVFORMD            YES, GO PROCESS
         SPACE 1
DEVFORMC LA    R8,108(0,R8)        NEXT SLOT
         B     DEVFORMA
         SPACE 1
DEVFORMD L     R1,16(0,R5)         I/O COUNT
         CVD   R1,DOUBLE
         MVC   LINE+23(10),=X'40206B2020206B202120'
         ED    LINE+23(10),DOUBLE+4
         LH    R14,10(0,R8)        OCCURRENCE COUNT
         LA    R14,1(0,R14)
         STH   R14,10(0,R8)
         CVD   R15,DOUBLE          PERCENT BUSY
         LA    R2,4
         BAL   R12,DVTOTL1
         UNPK  LINE+45(2),DOUBLE+6(2)
         OI    LINE+46,X'F0'
         MVI   LINE+47,C'.'
         MH    R14,=H'100'
         SRDL  R14,32
         D     R14,SAMPINTV        HUNDREDTHS OF PERCENT BUSY
         CVD   R15,DOUBLE
         UNPK  LINE+48(2),DOUBLE+6(2)
         OI    LINE+49,X'F0'
         LA    R2,8
         LR    R15,R7              QLENGTH X 100
         BAL   R12,DVTOTL1
         SR    R6,R6
         LR    R2,R7               SAVE QLENGTH X 100
         D     R6,=F'100'          QLENGTH AND HUNDREDTHS
         CVD   R7,DOUBLE
         MVC   LINE+53(5),=X'402021204B'
         ED    LINE+53(4),DOUBLE+6
         CVD   R6,DOUBLE
         UNPK  LINE+58(2),DOUBLE+6(2)
         OI    LINE+59,X'F0'
         SR    R14,R14
         L     R15,16(0,R5)        I/O COUNT
         SR    R6,R6
         LR    R7,R2               LOAD QLENGTH X 100
         MH    R7,=H'100'
         SR    R2,R2
         BAL   R12,DVTOTL
         SR    R14,R14
         L     R15,16(0,R5)        I/O COUNT
         D     R14,SAMPINTV        I/O PER SAMPLE
         LR    R2,R15              LOAD REQ/SAMPLE
         MH    R2,=H'100'
         CVD   R15,DOUBLE
         MVC   LINE+63(5),=X'402021204B'
         ED    LINE+63(4),DOUBLE+6
         MH    R14,=H'100'
         SRDL  R14,32
         D     R14,SAMPINTV        HUNDREDTHS OF I/O COUNT PER SAMPLE
         AR    R2,R15              ADD HUNDREDTHS
         CVD   R15,DOUBLE
         UNPK  LINE+68(2),DOUBLE+6(2)
         OI    LINE+69,X'F0'
         DR    R6,R2               PERCENT QUEUED
         CVD   R7,DOUBLE
         LA    R14,0(0,R7)         SAVE FOR ASTERISKS
         MVC   LINE+73(5),=X'402021204B'
         ED    LINE+73(4),DOUBLE+6
         MH    R6,=H'100'
         SRDL  R6,32
         DR    R6,R2               HUNDREDTHS OF PERCENT QUEUED
         CVD   R7,DOUBLE
         UNPK  LINE+78(2),DOUBLE+6(2)
         OI    LINE+79,X'F0'
         SRL   R14,1               DIVIDE BY 2
         CH    R14,=H'50'          MAX
         BNH   *+8
         LH    R14,=H'50'          FORCE MAX
         LA    R15,LINE+82         ADDR FOR ASTERISK PROPAGATION
         BAL   R12,ASTERISK
         SR    R14,R14
         L     R15,DEVBUSY         LOAD PERCENT BUSY
         A     R15,DEVQUE          ADD QLENGTH
         M     R14,=F'10'          SET TO MICROSECONDS
         M     R14,SAMPINTV        MULTIPLY BY RMF INTERVAL
         D     R14,16(0,R5)        DIVIDE BY SIO COUNT
         CVD   R15,DOUBLE          AVG TIME TO SERVICE REQUEST
         LA    R2,12
         BAL   R12,DVTOTL1
         MVC   LINE+34(7),=X'4020206B202120'
         ED    LINE+34(7),DOUBLE+5
         MVC   DEVLINE(4),LINE     SAVE TIME FOR DEVNAME OUTPUT
         MVC   DEVLINE+6(2),LINE+8 SAVE UNIT NAME FOR DEVNAME OUTPUT
         L     R2,=A(DEVNAME)
         PUT   (R2),DEVLINE
         L     R10,=A(DEVHDR)
         L     R11,=A(DVNLIST-12)  DEVICE OUTPUT DCB LIST
         SPACE 1
DEVFORM5 LA    R11,12(0,R11)       NEXT DEVICE ENTRY
         CLI   4(R11),X'00'        END OF ACTIVE ENTRIES
         BE    DEVFORM2            YES, DONT PRINT
         CLC   4(2,R11),LINE+7     DEVICE ID MATCH
         BNE   DEVFORM5            NO, NEXT
         LA    R2,8(0,R11)         LINE COUNT
         L     R11,0(0,R11)        DCB ADDR
         BAL   R12,PRINT
         B     DEVFORM2
         SPACE 1
DEVFORM6 MVI   DEVFORM0+1,X'00'
         MVC   DEVSIZE(2),52(R11)  SAVE DEVICE DATA SECTION SIZE
         MVC   LINE(4),LINE+10
         LH    R4,50(0,R11)        NO OF DEVICE SECTIONS
         LA    R5,48(0,R11)        DEVICE CONTROL SECTION ADDR
         AH    R5,0(0,R5)          1ST DEVICE DATA SECTION
         LR    R6,R11              SAVE RECORD ADDR
         SPACE 1
DEVFORM7 MVC   LINE+10(6),=CL6'UNIT='
         UNPK  LINE+16(5),0(3,R5)
         MVI   LINE+19,C' '
         MVI   LINE+20,C' '
         NC    LINE+16(3),=8X'0F'
         TR    LINE+16(3),=C'0123456789ABCDEF'
         MVC   LINE+24(4),=CL4'VOL='
         MVC   LINE+29(6),8(R5)
         MVC   LINE+40(8),=CL8'DEVTYPE='
         UNPK  LINE+49(9),4(5,R5)
         MVI   LINE+57,C' '
         NC    LINE+49(8),=8X'0F'
         TR    LINE+49(8),=C'0123456789ABCDEF'
         L     R10,=A(MAPHDR)
         LA    R2,DVCLINCT
         L     R11,=A(DLIST)
         BAL   R12,PRINT
         AH    R5,DEVSIZE          NEXT SECTION
         BCT   R4,DEVFORM7
         LR    R11,R6              RELOAD RECORD ADDR
         BAL   R12,TIME
         B     DEVFORM0
         EJECT
DVTOTL   SR    R14,R14
         D     R14,=F'1000'        DIVIDE LARGE VALUES BY 1000
         LA    R15,1(0,R15)        ROUND UP
         SPACE 1
DVTOTL1  L     R1,DVSSMPA(R2,R8)
         LA    R1,1(0,R1)
         ST    R1,DVSSMPA(R2,R8)   ADD 1 TO AVG SAMPLES
         LR    R1,R15
         A     R1,DVSTOTA(R2,R8)
         ST    R1,DVSTOTA(R2,R8)   ADD TO AVG TOTAL
         CLC   LINE(4),SELLO       SEL TIME RANGE
         BL    *+36
         CLC   LINE(4),SELHI       SEL TIME RANGE
         BH    *+26
         L     R1,DVSSMP1(R2,R8)
         LA    R1,1(0,R1)
         ST    R1,DVSSMP1(R2,R8)   ADD 1 TO SEL SAMPLES
         LR    R1,R15
         A     R1,DVSTOT1(R2,R8)
         ST    R1,DVSTOT1(R2,R8)   ADD TO SEL TOTAL
         C     R15,DVSMIN(R2,R8)
         BNL   *+8
         ST    R15,DVSMIN(R2,R8)   SAVE MIN VALUE
         C     R15,DVSMAX(R2,R8)
         BNH   *+8
         ST    R15,DVSMAX(R2,R8)   SAVE MAX VALUE
         BR    R12
         EJECT
PGFORM   BAL   R12,TIME            SET UP PRINT LINE
         L     R8,=A(PGNLIST)      LOAD PERF GROUP OUTPUT DCBLIST
         L     R15,=A(INTERVAL)
         BALR  R12,R15             GET RMF INTERVAL
         LA    R15,500(0,R15)      ROUND UP MILLISECS
         SR    R14,R14
         D     R14,=F'1000'
         ST    R15,SAMPINTV        SAVE INTERVAL SECONDS
         SPACE 1
PGFORM1  BC    15,PGFORM6
         CLI   4(R8),X'00'         END OF ACTIVE DCBS
         BE    SMFGET              YES, NEXT SMF RECORD
         CLC   4(1,R8),31(R11)     PERF GROUP MATCH
         BE    PGFORM2             YES, GO PROCESS
         LA    R8,1756(0,R8)        NEXT DCB ENTRY
         B     PGFORM1
         SPACE 1
PGFORM2  LH    R4,50(0,R11)        NO. OF PERIODS
         LA    R5,48(0,R11)        WORKLOAD CONTROL SECTION ADDR
         AH    R5,0(0,R5)          1ST PERIOD DATA SECTION
         MVC   LINE+6(2),62(R11)   CURRENT IPS TO PRINT
         XC    PERIOD(4),PERIOD
         CLC   8(4,R5),=F'0'       ZERO SERVICE
         BE    SMFGET              YES, DONT PROCESS
         CH    R4,=H'1'            ONLY ONE PERIOD
         BE    *+10                YES, NO ALL TOTALS
         MVC   1452(4,R8),=X'AAAAAAAA'
         EJECT
PGFORM3  L     R6,PERIOD
         LA    R6,1(0,R6)          PERIOD NUMBER
         ST    R6,PERIOD
         ST    R6,PERSAV
         CVD   R6,DOUBLE
         MVC   LINE+9(3),5(R8)     PERF GROUP NUMBER
         MVI   LINE+12,C'-'
         UNPK  LINE+13(1),DOUBLE+7(1)   PERIOD NUMBER
         OI    LINE+13,X'F0'
         CLC   8(4,R5),=F'0'       2ND PERIOD ZERO SERVICE
         BE    PGFORM5             YES, SAY ZEROS
         MVC   LINE+15(10),=X'40206B2020206B202120'
         MVC   LINE+26(10),=X'40206B2020206B202120'
         MVC   LINE+37(10),=X'40206B2020206B202120'
         MVC   LINE+48(10),=X'40206B2020206B202120'
         L     R15,24(0,R5)        IOC SERVICE
         CVD   R15,DOUBLE
         SR    R2,R2
         BAL   R12,PGTOTL
         ED    LINE+15(10),DOUBLE+4
         L     R15,28(0,R5)        CPU SERVICE
         CVD   R15,DOUBLE
         LA    R2,4
         BAL   R12,PGTOTL
         ED    LINE+26(10),DOUBLE+4
         L     R15,20(0,R5)        MSO SERVICE
         CVD   R15,DOUBLE
         LA    R2,8
         BAL   R12,PGTOTL
         ED    LINE+37(10),DOUBLE+4
         L     R15,8(0,R5)         TOT SERVICE
         CVD   R15,DOUBLE
         LA    R2,12
         BAL   R12,PGTOTL
         ED    LINE+48(10),DOUBLE+4
         SR    R14,R14
         L     R15,8(0,R5)         TOT SERVICE
         D     R14,SAMPINTV        PERSEC SERVICE
         CVD   R15,DOUBLE
         LA    R2,16
         BAL   R12,PGTOTL1
         MVC   LINE+58(7),=X'4020206B202120'
         ED    LINE+58(7),DOUBLE+5
         SR    R14,R14
         L     R15,28(0,R5)        CPU SERVICE
         OI    80(R11),X'F0'       MAKE IT
         MVI   82(R11),X'F0'          PACKABLE
         PACK  DOUBLE(8),80(4,R11)
         CVB   R1,DOUBLE           CPU COEF
         ST    R1,CPUCOEF          SAVE COEFFICIENT
         M     R14,=F'1000'
         DR    R14,R1              CPU VALUE
         LR    R7,R15              SAVE CPU VALUE
         SR    R14,R14
         L     R15,20(0,R5)        MSO SERVICE
         OI    84(R11),X'F0'       MAKE IT
         MVI   86(R11),X'F0'          PACKABLE
         PACK  DOUBLE(8),84(4,R11)
         CVB   R1,DOUBLE           MSO COEF
         M     R14,=F'1000'
         DR    R14,R1              MSO VALUE
         SR    R14,R14
         M     R14,=F'50'          MULT BY 200K IN FRAMES
         LTR   R7,R7               CPU SERVICE ZERO
         BZ    *+6                 YES, NO DIVIDE
         DR    R14,R7              WORKING SET SIZE
         CVD   R15,DOUBLE
         LA    R2,20
         MVC   PERSAV(4),=F'1'     FORCE SAMPLE ADD
         BAL   R12,PGTOTL1
         MVC   LINE+66(7),=X'4020206B202120'
         ED    LINE+66(7),DOUBLE+5
         SR    R14,R14
         L     R15,32(0,R5)        TRANSACTION RESIDENCY TIME
         D     R14,=F'1000'
         SR    R14,R14
         M     R14,=F'1024'
         D     R14,=F'1000'
         LA    R1,1(0,R15)         SAVE TRANS RES IN SECS
         SR    R14,R14
         L     R15,8(0,R5)         TOTAL SERVICE
         DR    R14,R1              ABSORPTION RATE
         CVD   R15,DOUBLE
         LA    R2,24
         BAL   R12,PGTOTL1
         MVC   LINE+75(7),=X'4020206B202120'
         ED    LINE+75(7),DOUBLE+5
         SR    R14,R14
         L     R15,4(0,R5)         TRANSACTION ACTIVE TIME
         D     R14,=F'1000'
         SR    R14,R14
         M     R14,=F'1024'
         D     R14,=F'1000'
         LA    R1,1(0,R15)         SAVE TRANS ACTIVE IN SECS
         SR    R14,R14
         L     R15,8(0,R5)         TOTAL SERVICE
         DR    R14,R1              TRANSACTION SERVICE RATE
         CVD   R15,DOUBLE
         LA    R2,28
         BAL   R12,PGTOTL1
         MVC   LINE+82(7),=X'4020206B202120'
         ED    LINE+82(7),DOUBLE+5
         SR    R14,R14
         L     R15,16(0,R5)        WORKLOAD LEVEL
         D     R14,=F'256'         WORKLOAD UNITS
         CVD   R15,DOUBLE
         MVC   LINE+90(5),=X'402021204B'
         ED    LINE+90(4),DOUBLE+6
         SRDL  R14,32
         M     R14,=F'100'
         D     R14,=F'256'         WORKLOAD HUNDREDTHS
         CVD   R15,DOUBLE
         UNPK  LINE+95(2),DOUBLE+6(2)
         OI    LINE+96,X'F0'
         MVC   LINE+97(7),=X'4020206B202120'
         L     R15,36(0,R5)        NO. OF SWAPS
         CVD   R15,DOUBLE
         LA    R2,32
         BAL   R12,PGTOTL1
         ED    LINE+97(7),DOUBLE+5
         SR    R14,R14
         L     R15,4(0,R5)         TRANSACTION ACTIVE TIME
         M     R14,=F'1024'
         D     R14,=F'1000'
         A     R15,=F'500'         ROUND UP
         SR    R14,R14
         D     R14,=F'1000'        TRANS ACTIVE IN SECS
         SR    R14,R14
         D     R14,SAMPINTV        AVG TRANSACTIONS ACTIVE
         CVD   R15,DOUBLE
         C     R15,=F'1'           ADJUST AVG UNLESS EQUAL 1
         BE    *+8
         LA    R15,1(0,R15)
         LA    R2,36
         BAL   R12,PGTOTL1
         MVC   LINE+104(5),=X'402021204B'
         ED    LINE+104(4),DOUBLE+6
         SRDL  R14,32
         M     R14,=F'100'
         D     R14,SAMPINTV        AVG TRANS ACTIVE HUNDREDTHS
         CVD   R15,DOUBLE
         UNPK  LINE+109(2),DOUBLE+6(2)
         OI    LINE+110,X'F0'
         MVC   LINE+112(4),=X'40202120'
         L     R15,0(0,R5)         ENDED TRANSACTIONS
         CVD   R15,DOUBLE
         LA    R2,40
         BAL   R12,PGTOTL1
         ED    LINE+112(4),DOUBLE+6
         MVC   LINE+119(13),=C'000.00.00.000'
         LTR   R15,R15             ANY ENDED TRANSACTIONS
         BZ    PGFORM4             NO, BYPASS DIVIDE ZERO
         SR    R14,R14
         L     R15,12(0,R5)        ELAPSED TIME OF ENDED TRANS
         M     R14,=F'1024'
         D     R14,=F'1000'        MILLISECS
         SR    R14,R14
         D     R14,0(0,R5)         AVG ENDED TIME
         LR    R7,R15              SAVE MILLISECS
         LTR   R15,R15             ONLY USE NONZERO VALUES
         BZ    *+18
         LA    R2,44
         MVC   PERSAV(4),=F'1'     FORCE SAMPLE ADD
         BAL   R12,PGTOTL
         LR    R15,R7              RELOAD MILLISECS
         SR    R14,R14
         D     R14,=A(1000*60*60)  HOURS
         CVD   R15,DOUBLE
         UNPK  LINE+119(3),DOUBLE+6(2)
         OI    LINE+121,X'F0'
         MVI   LINE+122,C'.'
         SRDL  R14,32
         D     R14,=A(1000*60)     MINUTES
         CVD   R15,DOUBLE
         UNPK  LINE+123(2),DOUBLE+6(2)
         OI    LINE+124,X'F0'
         MVI   LINE+125,C'.'
         SRDL  R14,32
         D     R14,=A(1000)        SECONDS AND MILLISECS
         CVD   R15,DOUBLE
         UNPK  LINE+126(2),DOUBLE+6(2)
         OI    LINE+127,X'F0'
         MVI   LINE+128,C'.'
         CVD   R14,DOUBLE
         UNPK  LINE+129(3),DOUBLE+6(2)
         OI    LINE+131,X'F0'
         EJECT
PGFORM4  LA    R2,8(0,R8)          LOAD LINE COUNT ADDR
         L     R10,=A(PGHDR)
         LR    R7,R11              SAVE RECORD ADDR
         L     R11,0(0,R8)         PG OUTPUT DCB ADDR
         BAL   R12,PRINT           GO PRINT
         LR    R11,R7              RELOAD RECORD ADDR
         LA    R5,44(0,R5)         NEXT PERIOD
         BCT   R4,PGFORM3
         B     SMFGET
         SPACE 1
PGFORM5  MVC   LINE+16(5),=C'ZEROS'
         B     PGFORM4
         SPACE 3
PGFORM6  MVI   PGFORM1+1,X'00'
         MVC   LINE(4),LINE+10     CLEAR TIME
         MVC   LINE+10(18),=CL18'RESOURCE FACTORS -'
         MVC   LINE+34(4),=CL4'IOC='
         MVC   LINE+39(3),64(R11)  IOC
         MVC   LINE+45(4),=CL4'CPU='
         MVC   LINE+50(3),67(R11)  CPU
         MVC   LINE+56(4),=CL4'ERV='
         MVC   LINE+61(6),70(R11)  ERV
         MVC   LINE+72(21),=CL21'SERVICE DEFINITIONS -'
         MVC   LINE+99(4),=CL4'IOC='
         MVC   LINE+104(4),76(R11) IOC
         MVC   LINE+111(4),=CL4'CPU='
         MVC   LINE+116(4),80(R11) CPU
         MVC   LINE+123(4),=CL4'MSO='
         MVC   LINE+128(4),84(R11) MSO
         LA    R2,MAPLNCT1
         L     R10,=A(MAPHDR)
         LR    R6,R11
         L     R11,=A(MAP1)
         MVI   AREA,X'11'
         BAL   R12,PRINT
         MVI   AREA,X'09'
         LR    R11,R6
         BAL   R12,TIME            GO SET UP PRINT LINE
         B     PGFORM1
         EJECT
PGTOTL   SR    R14,R14
         D     R14,=F'1000'        DIVIDE LARGE VALUES BY 1000
         LA    R15,1(0,R15)        ROUND UP
         SPACE 1
PGTOTL1  MH    R6,=H'288'          PERIOD TOTAL INCR
         SH    R6,=H'288'          MINUS 1 GROUP
         LA    R6,0(R6,R8)         POINT TO TOTALS GROUP
         L     R1,PGNSMPA(R2,R6)
         LA    R1,1(0,R1)
         ST    R1,PGNSMPA(R2,R6)   ADD 1 TO AVG SAMPLES
         LR    R1,R15
         A     R1,PGNTOTA(R2,R6)
         ST    R1,PGNTOTA(R2,R6)   ADD TO AVG TOTAL
         CLC   LINE(4),SELLO       SEL TIME RANGE
         BL    *+36
         CLC   LINE(4),SELHI       SEL TIME RANGE
         BH    *+26
         L     R1,PGNSMP1(R2,R6)
         LA    R1,1(0,R1)
         ST    R1,PGNSMP1(R2,R6)   ADD 1 TO SEL SAMPLES
         LR    R1,R15
         A     R1,PGNTOT1(R2,R6)
         ST    R1,PGNTOT1(R2,R6)   ADD TO SEL TOTAL
         C     R15,PGNMIN(R2,R6)
         BNL   *+8
         ST    R15,PGNMIN(R2,R6)   SAVE MIN VALUE
         C     R15,PGNMAX(R2,R6)
         BNH   *+8
         ST    R15,PGNMAX(R2,R6)   SAVE MAX VALUE
         LA    R6,1448(0,R8)       ALL TOTALS THIS PERF GROUP
         CLC   PERSAV(4),=F'1'     PERIOD 1
         BNE   PGTOTL2             NO, DONT ADD TO SAMPLES
         L     R1,PGNSMPA(R2,R6)
         LA    R1,1(0,R1)
         ST    R1,PGNSMPA(R2,R6)   ADD 1 TO AVG SAMPLES
         EJECT
PGTOTL2  LR    R1,R15
         A     R1,PGNTOTA(R2,R6)
         ST    R1,PGNTOTA(R2,R6)   ADD TO AVG TOTAL
         CLC   LINE(4),SELLO       SEL TIME RANGE
         BL    *+46
         CLC   LINE(4),SELHI       SEL TIME RANGE
         BH    *+36
         CLC   PERSAV(4),=F'1'     PERIOD 1
         BNE   PGTOTL3             NO, DONT ADD TO SAMPLES
         L     R1,PGNSMP1(R2,R6)
         LA    R1,1(0,R1)
         ST    R1,PGNSMP1(R2,R6)   ADD 1 TO SEL SAMPLES
         SPACE 1
PGTOTL3  LR    R1,R15
         A     R1,PGNTOT1(R2,R6)
         ST    R1,PGNTOT1(R2,R6)   ADD TO SEL TOTAL
         C     R15,PGNMIN(R2,R6)
         BNL   *+8
         ST    R15,PGNMIN(R2,R6)   SAVE MIN VALUE
         C     R15,PGNMAX(R2,R6)
         BNH   *+8
         ST    R15,PGNMAX(R2,R6)   SAVE MAX VALUE
         L     R6,PERIOD           RELOAD PERIOD NUMBER
         ST    R6,PERSAV           SAVE CURRENT PERIOD
         BR    R12
         EJECT
TRFORM   BAL   R12,TIME            GO SET TIME IN PRINT LINE
         L     R8,=A(TRCLIST)      LOAD TRACE OUTPUT
         MVC   SAMPINTV(4),32(R11) NO. OF SAMPLES
         LA    R5,0(0,R11)         TRACE DATA SECTION
         SPACE 1
TRFORM1  CLI   0(R8),X'FF'         END OF ENTRIES
         BE    SMFGET              YES, IGNORE RECORD
         CLI   0(R8),C' '          NO MATCH
         BE    TRFORM2
         CLC   0(8,R8),56(R5)      MATCHING TRACE NAME
         BE    TRFORM3             YES, PROCESS
         LA    R8,104(0,R8)        NEXT ENTRY
         B     TRFORM1
         SPACE 1
TRFORM2  MVC   0(8,R8),56(R5)      FILL IN NAME
         SPACE 1
TRFORM3  L     R15,72(0,R5)        MINIMUM VALUE
         LTR   R15,R15             NO VALUE PRESENT
         BM    SMFGET              YES, BYPASS
         SR    R2,R2
         BAL   R12,TRTOTL
         L     R15,76(0,R5)        MAXIMUM VALUE
         LA    R15,0(0,R15)
         LA    R2,4
         BAL   R12,TRTOTL
         SR    R14,R14
         SR    R15,R15
         CLC   SAMPINTV(4),=F'0'   ZERO SAMPLES
         BZ    *+28                YES, BYPASS 0C9
         CLC   80(4,R5),=F'0'      ZERO AVG
         BE    *+18                YES, BYPASS 0C7
         PACK  DOUBLE(8),80(8,R5)
         CVB   R15,DOUBLE
         D     R14,SAMPINTV        AVERAGE VALUE
         LA    R2,8
         BAL   R12,TRTOTL
         L     R15,100(0,R5)       END VALUE
         LA    R2,12
         BAL   R12,TRTOTL
         B     SMFGET
         EJECT
TRTOTL   L     R1,TRCSMPA(R2,R8)
         LA    R1,1(0,R1)
         ST    R1,TRCSMPA(R2,R8)   ADD 1 TO AVG SAMPLES
         LR    R1,R15
         A     R1,TRCTOTA(R2,R8)
         ST    R1,TRCTOTA(R2,R8)   ADD TO AVG TOTAL
         CLC   LINE(4),SELLO       SEL TIME RANGE
         BL    *+36
         CLC   LINE(4),SELHI       SEL TIME RANGE
         BH    *+26
         L     R1,TRCSMP1(R2,R8)
         LA    R1,1(0,R1)
         ST    R1,TRCSMP1(R2,R8)   ADD 1 TO SEL SAMPLES
         SPACE 1
TRTOTL1  LR    R1,R15
         A     R1,TRCTOT1(R2,R8)
         ST    R1,TRCTOT1(R2,R8)   ADD TO SEL TOTAL
         C     R15,TRCMIN(R2,R8)
         BNL   *+8
         ST    R15,TRCMIN(R2,R8)   SAVE MIN VALUE
         C     R15,TRCMAX(R2,R8)
         BNH   *+8
         ST    R15,TRCMAX(R2,R8)   SAVE MAX VALUE
         BR    R12
         EJECT
PRINT    L     R15,=A(PRINT0)
         BR    R15
         SPACE 3
TIME     L     R15,=A(TIME0)
         BR    R15
         SPACE 3
ASTERISK LTR   R14,R14             ZERO ASTERISKS
         BCR   8,R12               YES
         BCTR  R14,0
         EX    R14,ASTMOVE         PROPAGATE
         BR    R12
         SPACE 1
ASTMOVE  MVC   0(0,R15),ASTLINE    SET ASTERISKS IN PRINT LINE
         SPACE 3
INTERVAL XC    DOUBLE(8),DOUBLE
         MVI   DOUBLE+7,X'0F'
         MVO   DOUBLE(8),24(1,R11) INTERVAL MINUTES
         CVB   R14,DOUBLE
         MH    R14,=H'60'          CONVERT TO SECONDS
         MVO   DOUBLE(8),25(1,R11) INTERVAL SECONDS
         CVB   R15,DOUBLE
         AR    R15,R14
         SR    R14,R14
         M     R14,=F'1000'        CONVERT TO MILLISECONDS
         MVC   DOUBLE+6(2),26(R11) INTERVAL MILLISECONDS
         CVB   R14,DOUBLE
         AR    R15,R14             INTERVAL TOTAL IN MILLISECONDS
         BR    R12
         SPACE 3
TIME0    UNPK  LINE(6),16(4,R11)
         MVI   LINE+4,C' '
         MVC   LINE+5(127),LINE+4
         BR    R12
         EJECT
PRINT0   L     R1,0(0,R2)          LOAD CURRENT LINE COUNT
         L     R15,=A(PRINT1)
         LTR   R1,R1               LINE COUNT ZERO
         BCR   7,R15               NO, GO PRINT LINE
         PUT   (R11),EJECT
         PUT   (R11),DSNHDR
         PUT   (R11),(R10)         PRINT HDR
         PUT   (R11),DASH
         SPACE 1
PRINT1   L     R1,0(0,R2)          LOAD CURRENT LINE COUNT
         LA    R1,1(0,R1)          ADD 1 TO LINE COUNT
         ST    R1,0(0,R2)             AND SAVE IT
         PUT   (R11),AREA
         MVI   LINE+4,C' '
         MVC   LINE+5(127),LINE+4
         L     R1,0(0,R2)          LOAD CURRENT LINE COUNT
*        CH    R1,=H'50'           50 LINES PER PAGE
         CH    R1,=H'78'           78 LINES PER PAGE
         BCR   4,R12               NO, EXIT
         XC    0(4,R2),0(R2)       INDICATE HDR NEEDED NEXT TIME
         BR    R12
         EJECT
EOJ      BALR  R3,0
         DROP  R3
         USING EOJ0,R3
         SPACE 1
EOJ0     LA    R1,CLOSLIST
         CLOSE MF=(E,(1))
         L     R4,=A(CHNLIST)      CHANNEL OUTPUT DCB LIST
         L     R6,=A(PGNLIST)      PERF GROUP OUTPUT DCB LIST
         L     R7,=A(DVNLIST)      DEVICE OUTPUT DCB LIST
         SPACE 1
EOJ1     CLC   4(4,R4),=F'0'       END OF LIST
         BE    EOJ2                YES, GO CLOSE PG DCBS
         L     R5,0(0,R4)          LOAD DCB ADDR
         CLOSE ((R5))
         LA    R4,240(0,R4)        NEXT ENTRY
         B     EOJ1
         SPACE 1
EOJ2     CLI   4(R6),X'00'         END OF LIST
         BE    EOJ3                YES, GO CLOSE DEV DCBS
         L     R5,0(0,R6)          LOAD DCB ADDR
         CLOSE ((R5))
         LA    R6,1756(0,R6)       NEXT ENTRY
         B     EOJ2
         SPACE 1
EOJ3     CLI   4(R7),X'00'         END OF LIST
         BNE   EOJ3A               NO, CONTINUE
         L     R15,=A(TOTAL)       TOTAL ROUTINE ADDR
         BR    R15
         SPACE 1
EOJ3A    L     R5,0(0,R7)          LOAD DCB ADDR
         CLOSE ((R5))
         LA    R7,12(0,R7)         NEXT ENTRY
         B     EOJ3
         EJECT
         CNOP  0,8
TOTAL    LR    R3,R15
         DROP  R3
         DROP  R9
         USING TOTAL,R3
         L     R15,=A(SMFBR)
         CLI   1(R15),X'00'        WAS THE SMF DATA SET EMPTY
         BNE   TOTAL6              YES, EXIT
         SPACE 3
TOTAL1   LA    R2,MAPLNCT1
         SR    R10,R10             NO TOTAL COUNT
         L     R11,=A(MAP1)
         MVI   AREA,X'13'
         BAL   R12,TPRINT
         MVI   AREA,X'1B'
         BAL   R12,TPRINT
         MVI   AREA,X'09'
         MVC   LINE+118(14),=CL14'PERCENT BUSY'
         LA    R4,C1               CPU HEADERS
         LA    R5,CPUSMPA          1ST CPU COUNTER FIELD
         LA    R6,1                NUMBER OF GROUPS
         CLC   4(4,R5),=F'0'       CPU1 ZEROS FOR SAMPLES
         BE    *+8                 YES, JUST PRINT CPU 0 VALUES
         LA    R6,2                NUMBER OF GROUPS
         LA    R7,8                BYTES TO NEXT GROUP
         BAL   R8,TFORM
         L     R5,=A(CPUPCNT)      PERCENT ACCUMULATORS
         MVC   LINE(10),=CL10'CPU BUSY'
         BAL   R8,PCTFORM
         L     R11,=A(MAP1)
         LA    R2,MAPLNCT1
         MVI   AREA,X'1B'
         BAL   R12,TPRINT
         MVI   AREA,X'1B'
         BAL   R12,TPRINT
         MVI   AREA,X'09'
         MVC   LINE+118(14),=CL14'PAGES/SECOND'
         LA    R4,P1               PAG HEADERS
         LA    R5,PAGSMPA          1ST PAG COUNTER FIELD
         LA    R6,23               NUMBER OF GROUPS
         LA    R7,96               BYTES TO NEXT GROUP
         BAL   R8,TFORM
         MVI   AREA,X'1B'
         BAL   R12,TPRINT
         MVI   AREA,X'1B'
         BAL   R12,TPRINT
         L     R5,=A(PAGPCNT)      PERCENT ACCUMULATORS
         MVC   LINE(10),=CL10'PAGING'
         BAL   R8,PCTFORM
         MVI   AREA,X'1B'
         BAL   R12,TPRINT
         LA    R2,MAPLNCT2
         L     R11,=A(MAP2)
         MVI   AREA,X'09'
         MVC   LINE+118(14),=CL14'FRAMES'
         LA    R4,F1               FRM HEADERS
         LA    R5,FRMSMPA          1ST FRM COUNTER FIELD
         LA    R6,4                NUMBER OF GROUPS
         LA    R7,32               BYTES TO NEXT GROUP
         MVC   LINE(8),=CL8'PAGEABLE'
         BAL   R8,TFORM
         MVI   AREA,X'0B'
         BAL   R12,TPRINT
         MVI   AREA,X'09'
         LA    R4,F5               FRM HEADERS
         LA    R5,FRMSMPA+16       4TH FRM COUNTER FIELD
         LA    R6,4                NUMBER OF GROUPS
         LA    R7,32               BYTES TO NEXT GROUP
         MVC   LINE(8),=CL8'FIXED'
         BAL   R8,TFORM
         MVI   AREA,X'13'
         BAL   R12,TPRINT
         MVI   AREA,X'1B'
         BAL   R12,TPRINT
         MVI   AREA,X'09'
         MVC   LINE+118(14),=CL14'SWAPS/INTERVAL'
         LA    R4,S1               SWP HEADERS
         LA    R5,SWPSMPA          1ST SWP COUNTER FIELD
         LA    R6,11               NUMBER OF GROUPS
         LA    R7,44               BYTES TO NEXT GROUP
         LA    R10,1               FORCE TOTAL COUNT
         BAL   R8,TFORM
         SR    R10,R10             NO TOTAL COUNT
         XC    MAPLNCT2(4),MAPLNCT2 FORCE EJECT PAGE
         MVI   AREA,X'11'
         MVC   LINE+118(14),=CL14'PERCENT BUSY'
         L     R4,=A(CHNLIST)      CHANNEL OUTPUT LIST
         LA    R7,8                BYTES TO NEXT GROUP
         EJECT
TOTAL2   CLC   4(4,R4),=F'0'       ALL CHANNELS DONE
         BE    TOTAL4              YES, GO PROCESS PERF GROUPS
         SR    R1,R1
         IC    R1,5(0,R4)          CHANNEL ADDR
         MVC   LINE(21),=CL21'CHANNEL  (X,Y)   BUSY'
         C     R1,CHNCOMP          NEW CHANNEL
         BNL   TOTAL3A             YES, GO PROCESS
         B     TOTAL4              TERMINATE CHAN TOTALS ON LOW CHAN
         SPACE 1
TOTAL2A  SR    R1,R1
         IC    R1,7(0,R4)          CHANNEL ADDR
         MVC   LINE(21),=CL21'CHANNEL  (X,Y)   BUSY'
         C     R1,CHNCOMP          NEW CHANNEL
         BNL   TOTAL3B             YES, GO PROCESS
         B     TOTAL4              TERMINATE CHAN TOTALS ON LOW CHAN
         SPACE 1
TOTAL2B  LA    R4,240(0,R4)        NEXT CHANNEL ENTRY
         B     TOTAL2
         EJECT
TOTAL3A  MVC   LINE+10(1),8(R4)
         MVC   LINE+12(1),9(R4)
         MVC   CHSAVE(5),LINE+9    SAVE CHANNEL ID
         LA    R5,16(0,R4)         1ST HALF DATA ADDR
         LA    R6,1
         ST    R1,CHNCOMP
         BAL   R8,TFORM
         LA    R5,64(0,R4)         CPU0 CH PERCENT ACCUMULATORS
         MVC   LINE(2),=CL2'CH'
         MVC   LINE+3(5),CHSAVE
         BAL   R8,PCTFORM
         L     R11,=A(MAP2)
         LA    R2,MAPLNCT2
         LA    R7,8                BYTES TO NEXT GROUP
         B     TOTAL2A
         SPACE 1
TOTAL3B  MVC   LINE+10(1),10(R4)
         MVC   LINE+12(1),11(R4)
         MVC   CHSAVE(5),LINE+9    SAVE CHANNEL ID
         LA    R5,20(0,R4)         2ND HALF DATA ADDR
         LA    R6,1
         ST    R1,CHNCOMP
         BAL   R8,TFORM
         LA    R5,152(0,R4)        CPU1 CH PERCENT ACCUMULATORS
         MVC   LINE(2),=CL2'CH'
         MVC   LINE+3(5),CHSAVE
         BAL   R8,PCTFORM
         L     R11,=A(MAP2)
         LA    R2,MAPLNCT2
         LA    R7,8                BYTES TO NEXT GROUP
         B     TOTAL2B
         SPACE 3
TOTAL4   L     R11,=A(MAP3)
         LA    R2,MAPLNCT3
         L     R4,=A(PGNLIST)      PERF GROUP OUTPUT
         LA    R7,48               BYTES TO NEXT GROUP
         MVI   AREA,X'09'
         XC    PERIOD(4),PERIOD    ZERO PERIOD
         ST    R4,PGSVADDR         SAVE RECORD START
         EJECT
TOTAL5   L     R1,PERIOD           LOAD CURRENT PERIOD
         LA    R1,1(0,R1)
         ST    R1,PERIOD           SAVE NEW PERIOD
         CLC   12(4,R4),=X'EEEEEEEE'  END OF PERIODS
         BE    TOTAL5B1            YES, NEXT PERF GROUP
         CLC   12(4,R4),=X'AAAAAAAA' ALL TOTALS REQUESTED
         BE    TOTAL5B2            YES, GO PROCESS
         CLC   16(4,R4),=F'0'      ZERO CPU SERVICE
         BE    TOTAL5B             YES, BYPASS THIS PERF GROUP PERIOD
         MVC   LINE(12),=CL12'PGN='
         L     R1,PGSVADDR         LOAD PERF GROUP ENTRY ADDR
         MVC   LINE+5(3),5(R1)     PERF GROUP NUMBER
         MVC   LINE+12(14),W1
         MVC   LINE+118(14),=CL14'THOUSANDS OF'
         LA    R5,12(0,R4)         IOC SERVICE
         LA    R6,1
         BAL   R8,TFORM
         MVC   LINE(12),=CL12'PER='
         L     R1,PERIOD
         CVD   R1,DOUBLE
         UNPK  LINE+5(1),DOUBLE+7(1)
         OI    LINE+5,X'F0'
         CLC   4(4,R4),=X'AAAAAAAA'
         BNE   *+10
         MVC   LINE+5(3),=C'ALL'
         MVC   LINE+12(14),W2
         MVC   LINE+118(14),=CL14'SERVICE UNITS'
         LA    R5,16(0,R4)         CPU SERVICE
         LA    R6,1
         BAL   R8,TFORM
         MVC   LINE+12(14),W3
         LA    R5,20(0,R4)         MSO SERVICE
         LA    R6,1
         BAL   R8,TFORM
         MVC   LINE+12(14),W4
         LA    R5,24(0,R4)         TOTAL SERVICE
         LA    R6,1
         BAL   R8,TFORM
         MVC   LINE+12(14),W5
         MVC   LINE+118(14),=CL14'SERVICE UNITS'
         LA    R5,28(0,R4)         PERSEC SERVICE
         LA    R6,1
         BAL   R8,TFORM
         MVC   LINE+12(14),W6
         MVC   LINE+118(14),=CL14'FRAMES'
         LA    R5,32(0,R4)         WORKING SET SIZE
         LA    R6,1
         BAL   R8,TFORM
         MVC   LINE+12(14),W7
         MVC   LINE+118(14),=CL14'SERVICE/SEC'
         LA    R5,36(0,R4)         ABSORPTION SERVICE RATE
         LA    R6,1
         BAL   R8,TFORM
         MVC   LINE+12(14),W8
         LA    R5,40(0,R4)         TRANSACTION SERVICE RATE
         LA    R6,1
         BAL   R8,TFORM
         MVC   LINE+12(14),W9
         LA    R5,44(0,R4)         NO. OF SWAPS
         LA    R6,1
         LA    R10,1               FORCE TOTAL COUNT
         BAL   R8,TFORM
         SR    R10,R10             NO TOTAL COUNT
         MVC   LINE+12(14),W10
         LA    R5,48(0,R4)         AVG TRANSACTIONS
         LA    R6,1
         BAL   R8,TFORM
         MVC   LINE+12(14),W11
         LA    R5,52(0,R4)         ENDED TRANSACTIONS
         LA    R6,1
         LA    R10,1               FORCE TOTAL COUNT
         BAL   R8,TFORM
         SR    R10,R10             NO TOTAL COUNT
         MVC   LINE+12(14),W12
         MVC   LINE+118(14),=CL14'SECONDS'
         LA    R5,56(0,R4)         AVG TIME OF ENDED TRANSACTIONS
         LA    R6,1
         BAL   R8,TFORM
         LA    R5,16(0,R4)         CPU SERVICE
         LA    R6,3
         AR    R5,R7
         SR    R14,R14
         L     R15,=F'100000'
         D     R14,CPUCOEF
         SR    R14,R14
         M     R14,0(0,R5)         CPU SERVICE * 1000/CPUCOEF
         D     R14,MIPRATE         CPU SECONDS
         ST    R15,0(0,R5)         AVG CPU SECS TOTAL
         AR    R5,R7
         EJECT
TOTAL5A  AR    R5,R7
         SR    R14,R14
         L     R15,=F'100000'
         D     R14,CPUCOEF
         SR    R14,R14
         M     R14,0(0,R5)         CPU SERVICE * 1000/CPUCOEF
         D     R14,MIPRATE         CPU SECONDS
         ST    R15,0(0,R5)         SEL/MIN/MAX CPU SECONDS TOTAL
         BCT   R6,TOTAL5A
         LA    R5,16(0,R4)         CPU SECONDS
         LA    R6,1
         LA    R10,1               FORCE TOTAL COUNT
         MVC   LINE+12(14),W13
         MVI   AREA,X'19'
         BAL   R8,TFORM
         SR    R10,R10             NO TOTAL COUNT
         MVI   AREA,X'09'
         CLC   MAPLNCT3(4),=F'39'  END OF PAGE
         BL    *+10                NO, CONTINUE
         XC    MAPLNCT3(4),MAPLNCT3
         CLC   4(4,R4),=X'AAAAAAAA'
         BE    TOTAL5B             DONT RE-ADD ALL TOTALS
         LA    R5,16(0,R4)         CPU SECONDS
         AR    R5,R7
         L     R15,0(0,R5)         TOTAL SECONDS
         A     R15,TOTAVG
         ST    R15,TOTAVG
         AR    R5,R7
         AR    R5,R7
         L     R15,0(0,R5)         TOTAL SECONDS
         A     R15,SELAVG
         ST    R15,SELAVG
         SPACE 1
TOTAL5B  LA    R4,288(0,R4)        NEXT PERIOD TOTALS
         B     TOTAL5
         SPACE 1
TOTAL5B1 L     R4,PGSVADDR         CURRENT PERF GROUP
         LA    R4,1756(0,R4)       NEXT PERF GROUP
         ST    R4,PGSVADDR
         XC    PERIOD(4),PERIOD
         CLI   4(R4),X'00'         ALL PERF GROUPS DONE
         BE    TOTAL5C             YES, EXIT
         B     TOTAL5
         SPACE 1
TOTAL5B2 LA    R4,8(0,R4)
         B     TOTAL5              PROCESS ALL TOTALS
         EJECT
TOTAL5C  L     R11,=A(MAP1)
         LA    R2,MAPLNCT1
         PACK  DOUBLE(8),DEVLINE+4(2)
         CVB   R1,DOUBLE
         MH    R1,=H'60'           INTERVAL SECONDS
         SR    R14,R14
         L     R15,CPUSMPA
         LTR   R15,R15             ANY TOTAL SAMPLES
         BZ    TOTAL6              NO, BYPASS 0C9
         MR    R14,R1
         LR    R1,R15              TOTAL SECONDS IN TIME PERIOD
         SR    R14,R14
         L     R15,CPUTOTA
         D     R14,CPUSMPA
         L     R6,=F'100'
         SR    R6,R15              WAIT PERCENT
         SR    R14,R14
         L     R15,TOTAVG          CPU SECONDS TOTAL AVG
         M     R14,=F'100'         PERCENT
         DR    R14,R1              PRODUCTIVE CPU PERCENT
         L     R14,=F'100'         TOTAL PERCENT
         SR    R14,R6              MINUS WAIT
         SR    R14,R15             MINUS PRODUCTIVE
         MVC   LINE+12(7),=CL7'AVG CPU'
         CVD   R6,DOUBLE           WAIT PERCENT
         UNPK  LINE+30(2),DOUBLE+6(2)
         OI    LINE+31,X'F0'
         MVC   LINE+35(7),=CL7'WAITING'
         CVD   R15,DOUBLE          PRODUCTIVE PERCENT
         UNPK  LINE+50(2),DOUBLE+6(2)
         OI    LINE+51,X'F0'
         MVC   LINE+55(7),=CL7'TCBTIME'
         CVD   R14,DOUBLE          OVERHEAD PERCENT
         UNPK  LINE+70(2),DOUBLE+6(2)
         OI    LINE+71,X'F0'
         MVC   LINE+75(8),=CL8'OVERHEAD'
         LR    R6,R15              PRODUCTIVE PERCENT
         AR    R14,R15             PRODUCTIVE PLUS
         MH    R14,=H'100'            OVERHEAD TIMES 100
         SRDL  R14,32
         DR    R14,R6              NON-WAIT TO OVERHEAD RATIO
         LA    R15,5(0,R15)        ROUND TO NEAREST TENTH
         CVD   R15,DOUBLE
         UNPK  LINE+90(3),DOUBLE+6(2)
         MVC   LINE+93(1),LINE+92
         MVC   LINE+92(1),LINE+91
         OI    LINE+93,X'F0'
         MVI   LINE+91,C'.'
         MVC   LINE+97(5),=CL5'RATIO'
         BAL   R12,TPRINT
         PACK  DOUBLE(8),DEVLINE+4(2)
         CVB   R1,DOUBLE
         MH    R1,=H'60'           INTERVAL SECONDS
         SR    R14,R14
         L     R15,CPUSMP1
         LTR   R15,R15             ANY SELECTED SAMPLES
         BZ    TOTAL6              NO, BYPASS 0C9
         MR    R14,R1
         LR    R1,R15              TOTAL SECONDS IN TIME PERIOD
         SR    R14,R14
         L     R15,CPUTOT1
         D     R14,CPUSMP1
         L     R6,=F'100'
         SR    R6,R15              WAIT PERCENT
         SR    R14,R14
         L     R15,SELAVG          CPU SECONDS TOTAL AVG
         M     R14,=F'100'         PERCENT
         DR    R14,R1              PRODUCTIVE CPU PERCENT
         L     R14,=F'100'         TOTAL PERCENT
         SR    R14,R6              MINUS WAIT
         SR    R14,R15             MINUS PRODUCTIVE
         MVC   LINE+12(7),=CL7'SEL CPU'
         CVD   R6,DOUBLE           WAIT PERCENT
         UNPK  LINE+30(2),DOUBLE+6(2)
         OI    LINE+31,X'F0'
         MVC   LINE+35(7),=CL7'WAITING'
         CVD   R15,DOUBLE          PRODUCTIVE PERCENT
         UNPK  LINE+50(2),DOUBLE+6(2)
         OI    LINE+51,X'F0'
         MVC   LINE+55(7),=CL7'TCBTIME'
         CVD   R14,DOUBLE          OVERHEAD PERCENT
         UNPK  LINE+70(2),DOUBLE+6(2)
         OI    LINE+71,X'F0'
         MVC   LINE+75(8),=CL8'OVERHEAD'
         LR    R6,R15              PRODUCTIVE PERCENT
         AR    R14,R15             PRODUCTIVE PLUS
         MH    R14,=H'100'            OVERHEAD TIMES 100
         SRDL  R14,32
         DR    R14,R6              NON-WAIT TO OVERHEAD RATIO
         LA    R15,5(0,R15)        ROUND TO NEAREST TENTH
         CVD   R15,DOUBLE
         UNPK  LINE+90(3),DOUBLE+6(2)
         MVC   LINE+93(1),LINE+92
         MVC   LINE+92(1),LINE+91
         OI    LINE+93,X'F0'
         MVI   LINE+91,C'.'
         MVC   LINE+97(5),=CL5'RATIO'
         BAL   R12,TPRINT
         EJECT
TOTAL6   L     R4,=A(TRCLIST)      TRACE ENTRY OUTPUT
         LA    R7,16               BYTES TO NEXT GROUP
         L     R11,=A(MAP3)
         LA    R2,MAPLNCT3
         XC    MAPLNCT3(4),MAPLNCT3
         MVI   AREA,X'09'
         SPACE 1
TOTAL7   CLI   0(R4),X'FF'         ALL TRACE ENTRIES DONE
         BE    TOTAL8              YES, DEVICE TOTALS NEXT
         CLI   0(R4),X'40'         ALL TRACE ENTRIES DONE
         BE    TOTAL8              YES, DEVICE TOTALS NEXT
         MVC   LINE(8),0(R4)       SET UP TRACE NAME
         MVC   LINE+12(14),N1
         LA    R5,8(0,R4)          MINIMUM VALUE
         LA    R6,1
         BAL   R8,TFORM1
         MVC   LINE+12(14),N2
         LA    R5,12(0,R4)         MAXIMUM VALUE
         LA    R6,1
         BAL   R8,TFORM1
         MVC   LINE+12(14),N3
         LA    R5,16(0,R4)         AVERAGE VALUE
         LA    R6,1
         BAL   R8,TFORM1
         MVC   LINE+12(14),N4
         LA    R5,20(0,R4)         END VALUE
         LA    R6,1
         MVI   AREA,X'11'
         BAL   R8,TFORM1
         MVI   AREA,X'09'
         CLC   MAPLNCT3(4),=F'40'  10 GROUPS PER PAGE
         BL    *+10
         XC    MAPLNCT3(4),MAPLNCT3 FORCE PAGE EJECT
         SPACE 1
TOTAL7A  LA    R4,104(0,R4)        NEXT TRACE ENTRY
         B     TOTAL7
         EJECT
TOTAL8   L     R4,=A(DVSLIST)      DEVICE ENTRY OUTPUT
         LA    R7,16               BYTES TO NEXT GROUP
         XC    MAPLNCT3(4),MAPLNCT3 FORCE PAGE EJECT
         MVI   AREA,X'09'
         SPACE 1
TOTAL8A  CLI   0(R4),X'FF'         ALL DEVICE ENTRIES DONE
         BE    TOTALX              YES, EXIT
         CLI   0(R4),X'40'         ALL DEVICE ENTRIES DONE
         BE    TOTALX              YES, EXIT
         MVC   LINE(3),0(R4)       UNIT NAME
         MVC   LINE+5(6),3(R4)     VOLSER
         MVC   LINE+14(12),D1
         MVC   LINE+118(14),=CL14'THOUSANDS'
         LA    R5,12(0,R4)         SIO COUNT
         LA    R6,1
         BAL   R8,TFORM1
         MVC   LINE+14(12),D2
         LH    R14,10(0,R4)        OCCURRENCE COUNT
         CVD   R14,DOUBLE
         MVC   LINE(12),=X'40206B2020206B2021204040'
         ED    LINE(10),DOUBLE+4
         LA    R5,16(0,R4)         PERCENT BUSY
         LA    R6,1
         BAL   R8,TFORM1
         MVC   LINE+14(12),D3
         MVC   LINE+118(14),=CL14'QLEN  X 100'
         LA    R5,20(0,R4)         QLENGTH
         LA    R6,1
         BAL   R8,TFORM1
         MVC   LINE+14(12),D4
         MVC   LINE+118(14),=CL14'MILLISECS'
         LA    R5,24(0,R4)         AVG SERVICE TIME
         LA    R6,1
         MVI   AREA,X'11'
         BAL   R8,TFORM1
         MVI   AREA,X'09'
         CLC   MAPLNCT3(4),=F'40'  10 GROUPS PER PAGE
         BL    *+10
         XC    MAPLNCT3(4),MAPLNCT3 FORCE PAGE EJECT
         LA    R4,108(0,R4)        NEXT DEVICE ENTRY
         B     TOTAL8A
         EJECT
TOTALX   LA    R1,CLOSEMAP
         CLOSE MF=(E,(1))
         L     R13,SAVE+4
         RETURN (14,12),RC=0
         EJECT
PCTFORM  MVI   AREA,X'11'
         LA    R6,LINE-1
         LA    R7,10               NUMBER OF AREAS
         L     R9,0(0,R5)          TOTAL OCCURRENCES
         LTR   R9,R9               ANY OCCURRENCES
         BZ    PCTFORM2            NO, JUST PRINT HDR
         LA    R5,4(0,R5)          OCCURRENCE COUNTERS
         MVC   PCTPREV(4),=F'100'  INIT PCT PRINT PERCENT
         SPACE 1
PCTFORM1 LA    R6,12(0,R6)         NEXT AREA ADDR
         L     R15,0(0,R5)         LOAD COUNT
         SR    R14,R14
         M     R14,=F'100'
         DR    R14,R9              PERCENT OF TOTAL OCCURRENCES
         LR    R1,R15              SAVE RESULT
         SRDL  R14,31              REMAINDER X 2
         DR    R14,R9              CALCULATE ROUNDING
         AR    R1,R15              ROUND UP 1 IF NECESSARY
         L     R15,PCTPREV         LOAD PRINT PERCENT
         LTR   R15,R15             ZERO YET
         BNZ   *+12                NO, CONTINUE
         CVD   R1,DOUBLE           USE REMAINDER OVER 100 IF ANY
         B     *+14                CONTINUE
         CVD   R15,DOUBLE
         SR    R15,R1              NEW PRINT PERCENT
         ST    R15,PCTPREV
         MVC   DOUBLE(4),=X'40202021'
         ED    DOUBLE(4),DOUBLE+6
         MVC   0(3,R6),DOUBLE+1
         L     R15,4(0,R5)         LOAD COUNT
         SR    R14,R14
         M     R14,=F'100'
         DR    R14,R9              PERCENT OF TOTAL OCCURRENCES
         LR    R1,R15              SAVE RESULT
         SRDL  R14,31              REMAINDER X 2
         DR    R14,R9              CALCULATE ROUNDING
         AR    R1,R15              ROUND UP 1 IF NECESSARY
         L     R15,PCTPREV         LOAD PRINT PERCENT
         LTR   R15,R15             ZERO YET
         BNZ   *+12                NO, CONTINUE
         CVD   R1,DOUBLE           USE REMAINDER OVER 100 IF ANY
         B     *+14                CONTINUE
         CVD   R15,DOUBLE
         SR    R15,R1              NEW PRINT PERCENT
         ST    R15,PCTPREV
         MVC   DOUBLE(4),=X'40202021'
         ED    DOUBLE(4),DOUBLE+6
         MVC   5(3,R6),DOUBLE+1
         LA    R5,8(0,R5)          NEXT COUNT GROUP
         BCT   R7,PCTFORM1
         L     R15,0(0,R5)         LOAD 100 PERCENT COUNT
         SR    R14,R14
         M     R14,=F'100'
         DR    R14,R9              PERCENT OF TOTAL OCCURRENCES
         LR    R1,R15              SAVE RESULT
         SRDL  R14,31              REMAINDER X 2
         DR    R14,R9              CALCULATE ROUNDING
         AR    R1,R15              ROUND UP 1 IF NECESSARY
         L     R15,PCTPREV         LOAD PRINT PERCENT
         LTR   R15,R15             ZERO YET
         BNZ   *+12                NO, CONTINUE
         CVD   R1,DOUBLE           USE REMAINDER OVER 100 IF ANY
         B     *+14                CONTINUE
         CVD   R15,DOUBLE
         SR    R15,R1              NEW PRINT PERCENT
         ST    R15,PCTPREV
         MVC   DOUBLE(4),=X'40202021'
         ED    DOUBLE(4),DOUBLE+6
         MVC   10(3,R6),DOUBLE+1
         SPACE 1
PCTFORM2 LA    R2,PCTLINCT
         L     R11,=A(PCTMAP)
         MVC   MAPHDRSV(4),=A(PCTHDR)
         BAL   R12,TPRINT
         MVC   MAPHDRSV(4),=A(MAPHDR)
         BR    R8
         EJECT
TFORM    CLI   0(R4),X'00'         HDR PRESENT
         BE    TFORM1              NO, BYPASS
         MVC   LINE+12(14),0(R4)   MOVE IN HDR
         LA    R4,14(0,R4)         NEXT HDR ADDR
         SPACE 1
TFORM1   MVC   LINE+30(15),T1
         MVC   LINE+50(15),T2
         MVC   LINE+70(15),T3
         MVC   LINE+90(15),T4
         LR    R9,R5               COUNT FIELDS ADDR
         L     R1,0(0,R9)          AVG SAMPLES
         AR    R9,R7               NEXT FIELD
         SR    R14,R14
         L     R15,0(0,R9)         AVG TOTAL
         LTR   R10,R10             FORCE TOTAL COUNT PRINT
         BZ    TFORM2              NO,BYPASS
         MVC   LINE(12),=X'40206B2020206B2021204040'
         CVD   R15,DOUBLE
         ED    LINE(10),DOUBLE+4
         SPACE 1
TFORM2   LTR   R15,R15             ZERO DATA
         BZ    *+6                 YES, BYPASS DIVIDE
         DR    R14,R1              AVG
         CVD   R15,DOUBLE
         ED    LINE+70(10),DOUBLE+4
         EJECT
TFORM3   CLC   LINE+12(3),=C'CPU'  CPU
         BNE   TFORM3A
         TM    LINE+16,X'F0'       NUMERIC CPU ID
         BNO   TFORM4              NO, IGNORE
         MVC   GRPHTYPE(3),=C'CPU'
         MVC   GRPHTYPE+3(1),LINE+16  CPU 0 OR CPU 1
         B     TFORM3X
         SPACE 1
TFORM3A  CLC   LINE+12(14),P2      ACTUAL PAGING
         BNE   TFORM3B
         MVC   GRPHTYPE(4),=C'PAGE'
         B     TFORM3X
         SPACE 1
TFORM3B  CLC   LINE(8),=CL8'CHANNEL'
         BNE   TFORM4
         MVC   GRPHTYPE(2),=C'CH'
         MVC   GRPHTYPE+2(1),LINE+10
         MVC   GRPHTYPE+3(1),LINE+12
         SPACE 1
TFORM3X  MVC   GRPHXXIS(3),LINE+77
         MVC   GRPHYXIS(2),TIMELO
         ST    R2,REGSAVE
         L     R2,=A(TODMAP)
         PUT   (R2),TODAREA
         L     R2,REGSAVE
         SPACE 1
TFORM4   AR    R9,R7               NEXT FIELD
         L     R1,0(0,R9)          SEL SAMPLES
         AR    R9,R7               NEXT FIELD
         SR    R14,R14
         L     R15,0(0,R9)         SEL TOTAL
         LTR   R15,R15             ZERO DATA
         BZ    *+6                 YES, BYPASS DIVIDE
         DR    R14,R1              SEL
         CVD   R15,DOUBLE
         ED    LINE+90(10),DOUBLE+4
         AR    R9,R7               NEXT FIELD
         L     R15,0(0,R9)         MIN
         C     R15,=X'7FFFFFFF'    HIGH VALUE
         BNE   *+6                 NO, BYPASS
         SR    R15,R15             MAKE IT ZERO
         CVD   R15,DOUBLE
         ED    LINE+30(10),DOUBLE+4
         AR    R9,R7               NEXT FIELD
         L     R15,0(0,R9)         MAX TOTAL
         CVD   R15,DOUBLE
         ED    LINE+50(10),DOUBLE+4
         BAL   R12,TPRINT
         LA    R5,4(0,R5)          NEXT GROUP
         BCT   R6,TFORM
         BR    R8
         EJECT
TPRINT   L     R1,0(0,R2)          LOAD CURRENT LINE COUNT
         LTR   R1,R1               LINE COUNT ZERO
         BNZ   TPRINT1             NO, GO PRINT LINE
         PUT   (R11),EJECT
         PUT   (R11),DSNHDR
         L     R9,MAPHDRSV         LOAD CURRENT MAPHDR
         PUT   (R11),(R9)          PRINT HDR
         PUT   (R11),DASH
         SPACE 1
TPRINT1  L     R1,0(0,R2)          LOAD CURRENT LINE COUNT
         LA    R1,1(0,R1)          ADD 1 TO LINE COUNT
         ST    R1,0(0,R2)             AND SAVE IT
         PUT   (R11),AREA
         MVI   LINE,C' '
         MVC   LINE+1(131),LINE
         L     R1,0(0,R2)          LOAD CURRENT LINE COUNT
*        CH    R1,=H'48'           48 LINES PER PAGE
         CH    R1,=H'78'           78 LINES PER PAGE
         BCR   4,R12               NO, EXIT
         XC    0(4,R2),0(R2)       INDICATE HDR NEEDED NEXT TIME
         BR    R12
         EJECT
T1       DC    X'40206B2020206B202120',CL5'  MIN'
T2       DC    X'40206B2020206B202120',CL5'  MAX'
T3       DC    X'40206B2020206B202120',CL5'  AVG'
T4       DC    X'40206B2020206B202120',CL5'  SEL'
         SPACE 1
