//RMFMAP   JOB (SYS),'RUN RMFMAP',CLASS=S,MSGCLASS=X,
//             MSGLEVEL=(1,1)
//MAPMP PROC SYS='MVSC',     SYSTEM ID
//         INTVL='15',       RMF REPORTING INTERVAL (MINUTES)
//         SELLO='0000',     SELECTED AVERAGE PERIOD START TIME
//         SELHI='2359',     SELECTED AVERAGE PERIOD STOP TIME
//         TIMELO='0000',    AVERAGE PERIOD START TIME
//         TIMEHI='2359',    AVERAGE PERIOD STOP TIME
//         DATELO='01001',   RECORD DATE RANGE START DATE
//         DATEHI='99350',   RECORD DATE RANGE STOP DATE
//         RMFDSN=,          THE RMF RECORD INPUT DATA SET
//         MIP=302           SERVICE UNITS PER SECOND OF TASK
//*                          EXECUTION TIME.  CPU SECONDS
//*                          CALCULATION IS AFFECTED BY THIS NUMBER.
//*                          SEE MVS INIT AND TUNING GUIDE,
//*                          SELECTING CPU SERVICE DEFINITION
//*                          COEFFICIENT FOR TABLE OF VALUES.
//*
//MAPMP    EXEC PGM=RMFMAP,
// PARM='&SYS&INTVL&SELLO&SELHI&TIMELO&TIMEHI&DATELO&DATEHI&MIP'
//STEPLIB    DD DISP=SHR,DSN=WEGSCD.LINKLIB
//*
//SMF    DD  DSN=&RMFDSN.,   RMF RECORD INPUT (70,71,72,73,74,76)
//       DISP=SHR,DCB=BFTEK=A
//*
//*
//*  SUMMARY REPORTS FOR CHANNELS, PERFORMANCE GROUPS, AND
//*  DEVICES ARE CONSTRAINED BY THE DD CARDS SPECIFIED FOR
//*  THE RESPECTIVE DETAIL REPORTS.
//*  IF YOU SPECIFY 10 PERFORMANCE GROUPS FOR DETAIL
//*  REPORTS YOU WILL GET SUMMARY DATA FOR THOSE SAME 10
//*  PERFORMANCE GROUPS.
//*  IF YOU SPECIFY 2 CONTROL UNITS OF DEVICES FOR DETAIL
//*  REPORTS, YOU WILL GET SUMMARY DATA ONLY FOR THE DEVICES
//*  ON THOSE CONTROL UNITS.  DEVICE SUMMARY IS ALSO LIMITED TO
//*  THE FIRST 50 UNIQUE ENTRIES.
//*  TRACE SUMMARY DATA IS PRODUCED FOR ALL TRACE ENTRIES SPECIFIED
//*  IN THE RMF PARAMETERS UP TO A MAXIMUM OF 50 UNIQUE ENTRIES.
//*
//MAP1   DD  SYSOUT=*   SUMMARY RPT -   CPU AND PAGING
//MAP2   DD  SYSOUT=*   SUMMARY RPT -   FRAMES, SWAPS, AND CHANNELS
//TODMAP DD  DUMMY      TOD OUTPUT -    INPUT TO GRAPH PROGRAM
//SHFMAP DD  DUMMY      TOD OUTPUT -    INPUT TO GRAPH PROGRAM
//PCTMAP DD  SYSOUT=*   SUMMARY RPT -   CUMULATIVE CPU/PAGING/CHANNEL
//MAP3   DD  SYSOUT=*   SUMMARY RPT -   PERF. GRPS, TRACE AND DEVICES
//*
//CPU    DD  SYSOUT=*   BAR GRAPH -     CPU BUSY
//PAG1   DD  SYSOUT=*   BAR GRAPH -     TOTAL PAGING
//PAG2   DD  SYSOUT=*   BAR GRAPH -     PAGE RECLAIMS
//PAG3   DD  SYSOUT=*   BAR GRAPH -     ADDRESS SPACE PAGING
//PAG4   DD  SYSOUT=*   BAR GRAPH -     COMMON AREA PAGING
//PAG5   DD  SYSOUT=*   BAR GRAPH -     VIO PAGING
//PAG6   DD  SYSOUT=*   BAR GRAPH -     SWAP PAGING AND PAGE FAULTS
//FRAME  DD  SYSOUT=*   DETAIL RPT -    PAGE FRAME UTILIZATION
//SWAP   DD  SYSOUT=*   DETAIL RPT -    SWAP COUNTS
//*
//CLIST  DD  SYSOUT=*   LIST RPT -      CHANNEL DESCRIPTIONS
//*
//* CHACBC IS THE DDNAME FORMAT OF THE CHANNEL BAR GRAPH DDNAMES
//*   WHERE 'A' AND 'B' ARE CPU IDS (0 OR 1) IN ANY COMBINATION AND
//*   'C' IS ANY CHANNEL ID (0 - F).  TO PRODUCE ACCURATE SUMMARY
//*   REPORTS FOR CHANNELS, THE CHANNELS MUST BE MAPPED AGAINST THE
//*   DD CARDS IN ASCENDING ORDER PRIOR TO ANY CROSS MAPPING SUCH AS
//*   MAPPING PRIMARY AND ALTERNATE CHANNELS TOGETHER.
//*   THE EXAMPLE PROVIDED BELOW FOR THE CHANNEL DD CARDS IS FOR A
//*   168MP WITH 8 CHANNELS ON EACH SIDE.
//*
//*   NOTE THAT A MAXIMUM OF 20 CHANNEL DD CARDS IS ALLOWED
//*
//*H0010 DD  SYSOUT=*   BAR GRAPH -     CPU0 CHAN0   CPU1 CHAN0
//CH0111 DD  SYSOUT=*   BAR GRAPH -     CPU0 CHAN1   CPU1 CHAN1
//*H0212 DD  SYSOUT=*   BAR GRAPH -     CPU0 CHAN2   CPU1 CHAN2
//*H0313 DD  SYSOUT=*   BAR GRAPH -     CPU0 CHAN3   CPU1 CHAN3
//*H0414 DD  SYSOUT=*   BAR GRAPH -     CPU0 CHAN4   CPU1 CHAN4
//*H0515 DD  SYSOUT=*   BAR GRAPH -     CPU0 CHAN5   CPU1 CHAN5
//*H0616 DD  SYSOUT=*   BAR GRAPH -     CPU0 CHAN6   CPU1 CHAN6
//*H0717 DD  SYSOUT=*   BAR GRAPH -     CPU0 CHAN7   CPU1 CHAN7
//*H0102 DD  SYSOUT=*   BAR GRAPH -     CPU0 CHAN1   CPU0 CHAN2
//*H0103 DD  SYSOUT=*   BAR GRAPH -     CPU0 CHAN1   CPU0 CHAN3
//*H0203 DD  SYSOUT=*   BAR GRAPH -     CPU0 CHAN2   CPU0 CHAN3
//*H0307 DD  SYSOUT=*   BAR GRAPH -     CPU0 CHAN3   CPU0 CHAN7
//*H1112 DD  SYSOUT=*   BAR GRAPH -     CPU1 CHAN1   CPU1 CHAN2
//*H1113 DD  SYSOUT=*   BAR GRAPH -     CPU1 CHAN1   CPU1 CHAN3
//*H1213 DD  SYSOUT=*   BAR GRAPH -     CPU1 CHAN2   CPU1 CHAN3
//*H1317 DD  SYSOUT=*   BAR GRAPH -     CPU1 CHAN3   CPU1 CHAN7
//*
//DEVNAME DD SYSOUT=*   OFFENSIVE DEVICE OUTPUT (INPUT TO OTHER PGM)
//*
//DLIST  DD  SYSOUT=*   LIST RPT -      VOLSER LIST (1ST RMF INTRVAL)
//*
//* DVXX IS THE DDNAME FORMAT OF THE DEVICE DETAIL REPORT DDNAMES
//*   WHERE 'XX' IS THE CONTROL UNIT ID OF THE DEVICES TO BE REPORTED
//*
//*   NOTE THAT A MAXIMUM OF 20 DEVICE DD CARDS IS ALLOWED
//*
//*V11   DD  SYSOUT=*   DETAIL RPT -    DEVICES (110-11F)
//*V14   DD  SYSOUT=*   DETAIL RPT -    DEVICES (140-14F)
//DV15   DD  SYSOUT=*   DETAIL RPT -    DEVICES (150-15F)
//*V17   DD  SYSOUT=*   DETAIL RPT -    DEVICES (170-17F)
//*V28   DD  SYSOUT=*   DETAIL RPT -    DEVICES (280-28F)
//*V29   DD  SYSOUT=*   DETAIL RPT -    DEVICES (290-29F)
//*V3C   DD  SYSOUT=*   DETAIL RPT -    DEVICES (3C0-3CF)
//*V3D   DD  SYSOUT=*   DETAIL RPT -    DEVICES (3D0-3DF)
//*
//* PGNNN IS THE DDNAME FORMAT OF THE PERFORMANCE GROUP DETAIL
//*   REPORTS WHERE NNN IS ANY NUMBER (001 - 999).
//*
//*   NOTE THAT A MAXIMUM OF 30 PERFORMANCE GROUPS ARE ALLOWED
//*
//PG001  DD  SYSOUT=*   DETAIL RPT -    PERFORMANCE GROUP 1
//*G002  DD  SYSOUT=*   DETAIL RPT -    PERFORMANCE GROUP 2
//*G003  DD  SYSOUT=*   DETAIL RPT -    PERFORMANCE GROUP 3
//*G004  DD  SYSOUT=*   DETAIL RPT -    PERFORMANCE GROUP 4
//*G005  DD  SYSOUT=*   DETAIL RPT -    PERFORMANCE GROUP 5
//*G006  DD  SYSOUT=*   DETAIL RPT -    PERFORMANCE GROUP 6
//*G007  DD  SYSOUT=*   DETAIL RPT -    PERFORMANCE GROUP 7
//*G008  DD  SYSOUT=*   DETAIL RPT -    PERFORMANCE GROUP 8
//*G009  DD  SYSOUT=*   DETAIL RPT -    PERFORMANCE GROUP 9
//*G010  DD  SYSOUT=*   DETAIL RPT -    PERFORMANCE GROUP 10
//*G011  DD  SYSOUT=*   DETAIL RPT -    PERFORMANCE GROUP 11
//*G012  DD  SYSOUT=*   DETAIL RPT -    PERFORMANCE GROUP 12
//*G013  DD  SYSOUT=*   DETAIL RPT -    PERFORMANCE GROUP 13
//*G014  DD  SYSOUT=*   DETAIL RPT -    PERFORMANCE GROUP 14
//*G015  DD  SYSOUT=*   DETAIL RPT -    PERFORMANCE GROUP 15
//*G016  DD  SYSOUT=*   DETAIL RPT -    PERFORMANCE GROUP 16
//*
//       PEND
//MAPMP   EXEC  MAPMP,RMFDSN='SMFARC.ALL'
//SYSUDUMP  DD  SYSOUT=*
//
