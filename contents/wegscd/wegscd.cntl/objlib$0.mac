//WEGSCDOB JOB (WEGSCD,MAINT,LIB),'BUILD OBJLIB',CLASS=A,
//             MSGCLASS=X,MSGLEVEL=(1,1)
//*------------------------------------------------------------------*
//ADD     PROC NAME=,MAC1='SYS1.MACLIB'
//ASM     EXEC PGM=IFOX00,REGION=1024K,
//             PARM='NODECK,OBJ'
//SYSLIB    DD DISP=SHR,DSN=SYS1.MACLIB
//          DD DISP=SHR,DSN=&MAC1
//SYSUT1    DD DSN=&&SYSUT1,UNIT=SYSSQ,SPACE=(1700,(600,100)),
//             SEP=(SYSLIB)
//SYSUT2    DD DSN=&&SYSUT2,UNIT=SYSSQ,SPACE=(1700,(300,50)),
//             SEP=(SYSLIB,SYSUT1)
//SYSUT3    DD DSN=&&SYSUT3,UNIT=SYSSQ,SPACE=(1700,(300,50))
//SYSPRINT  DD SYSOUT=*
//SYSPUNCH  DD DUMMY
//SYSGO     DD DISP=SHR,DSN=WEGSCD.OBJ(&NAME)
//        PEND
//*------------------------------------------------------------------*
//TIMEDAT EXEC ADD,NAME=TIMEDATE
//ASM.SYSIN DD DISP=SHR,DSN=CBT249.FILE270(TIMEDATE)
//*------------------------------------------------------------------*
//TIME    EXEC ADD,NAME=TIME
//ASM.SYSIN DD DISP=SHR,DSN=CBT310.FILE038.PDS(TIME),
//             UNIT=SYSDA,VOL=SER=CBT310
//*------------------------------------------------------------------*
//IFORTY  EXEC ADD,NAME=IFORTY
//ASM.SYSIN DD DISP=SHR,DSN=WEGSCD.SRC(IFORTY)
//*------------------------------------------------------------------*
//*CPUTIM  EXEC ADD,NAME=CPUTIM,MAC1='SYS1.AMODGEN'
//*ASM.SYSIN DD DISP=SHR,DSN=WEGSCD.SRC(CPUTIM)
//*------------------------------------------------------------------*
//JOBNAM  EXEC ADD,NAME=JOBNAM,MAC1='SYS1.AMODGEN'
//ASM.SYSIN DD DISP=SHR,DSN=WEGSCD.SRC(JOBNAM)
//*------------------------------------------------------------------*
//IHETAB  EXEC ADD,NAME=IHETAB80
//ASM.SYSIN DD DISP=SHR,DSN=WEGSCD.WSMF.SRC(IHETAB)
