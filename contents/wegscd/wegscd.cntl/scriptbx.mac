//WEGSCDSC JOB (DOUG),'Try SCRIPT',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//        EXEC PGM=SUPERGEN
//STEPLIB   DD DSN=SYSC.LINKLIB,DISP=SHR
//SYSIN     DD DUMMY
//SYSPRINT  DD SYSOUT=*
//SYSUT1    DD *
.IN +5 -5
.BX 1 40
.SK;.LA ONE;.CE TWO;.RA THREE
.SK;.BX
This is a continued box showing
formatted text in a box.
.BX OFF
