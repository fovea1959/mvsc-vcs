//WEGSCDCT JOB (001,002),'ASM CLOCKSTC',CLASS=A,MSGCLASS=X
//        EXEC ASMFCL
//ASM.SYSIN DD *
CLOCKSTC CSECT ,
         STM   R14,R12,12(R13)    SAVE CALLERS REGISTERS
         LR    R12,R15            ESTABLISH
         USING CLOCKSTC,R12                BASE REGISTER
*
         LA    R1,SAVEA1           CHAIN
         ST    R13,4(,R1)              ON
         ST    R1,8(,R13)                SAVE
         LR    R13,R1                        AREA
*
* COMMUNICATIONS PARAMETER LIST (MAPPED BY THE IEZCOM MACRO).
*   THE COM PARAMETER LIST CONSISTS OF TWO WORDS.
*
* COMECBPT DS    A       ADDRESS OF ECB FOR STOP/MODIFY
* COMCIBPT DS    A       ADDRESS OF COMMAND INPUT BUFFER
*
* TO GET THE ADDRESS OF THE COM PARAMETER AREA WE CAN USE THE EXTRACT
* MACRO. COMPTR IS A FULLWORD WHERE THE ADDRESS OF THE COM PARAMETER
* AREA WILL BE STORED. WE REQUEST THE COM PARAMETER AREA BY SPECIFYING
* FIELDS=COMM
*
         EXTRACT COMPTR,FIELDS=COMM    GET POINTER TO COMM FIELDS
*
* NEXT WE LOAD THE ADDRESS OF THE COM PARM AREA INTO REGISTER 1.
* NOW WE HAVE TO CHECK TO SEE IF THERE IS A COMMAND INPUT BUFFER
* (CIB) RELATED TO A START COMMAND. IF WE ARE RUNNING AS A STARTED
* TASK THERE SHOULD BE A CIB, OTHERWISE THERE IS NO CIB AND THE
* POINTER IS ZERO.
*
         L     R1,COMPTR          POINTER TO COMM FIELDS
         LA    R2,4(,R1)          CIB ORIGIN
         L     R3,0(,R2)          PONTER TO FIRST CIB
         LTR   R3,R3              ANY START CIB PRESENT
         BZ    SETCIB             NO - CONTINUE
*
* IF THERE IS A CIB AS THE RESULT OF A START COMMAND WE NEED TO
* FREE THE CIB. FOR THIS WE USE THE QEDIT MACRO AND PASS TWO
* PARAMETERS. ORIGIN REFERS THE THE ADDRESS OF THE COMCIBPT FIELD
* (THE SECOND WORD IN THE COM PARMAMETER LIST) AND BLOCK POINTS
* THE THE CIB WE WISH TO FREE.
*
         QEDIT ORIGIN=(R2),BLOCK=(R3)   FREE START CIB
*
* NOW WE SET A LIMIT ON HOW MANY CIBS MAY BE QUEUED TO OUR JOB
* AT ONE TIME. INITIALLY THIS VALUE IS ZERO WHICH MEANS THAT MODIFY
* COMMANDS WILL NOT BE ACCEPTED BY OUR JOB. WE WANT TO ALLOW ONE CIB
* TO BE QUEUED AT A TIME SO WE
* SET THE LIMIT USING THE QEDIT MACRO. HERE WE SPECIFY THE ORIGIN
* (AGAIN THE ADDRESS OF THE COMCIBPT FIELD) AND SPECIFY A LIMIT WITH
* THE CIBCTR PARAMETER.
*
SETCIB   DS    0H
         QEDIT ORIGIN=(R2),CIBCTR=1     SET CIB LIMIT TO ONE AT A TIME
*
* NOW WE WILL WAIT FOR A COMMAND FROM THE CONSOLE. WE DO THIS BY
* WAITING ON THE ECB POINTED TO BY THE COMECBPT FIELD. WE COULD
* ALSO BE DOING SOME WORK AND CHECK TO SEE IF THE ECB HAS BEEN
* POSTED TO INTERRUPT WHATEVER WE ARE CURRENTY DOING. HERE WE
* JUST WAIT FOR A COMMAND.
*
LOOP     DS    0H
         L     R1,COMPTR          COMM FIELDS
         LA    R2,0(,R1)          ECB ADDRESS PTR
         L     R3,0(,R2)          ECB ADDRESS
*
LOOPI    DS   0H
*
         TM    0(R3),X'40'             WAS COMM ECB posted?
         BO    OPERCOMM                YES, GO
*
         TIME  DEC                     GET THE TIME

         ST    0,CTIME
*
         UNPK  UPTIME(7),CTIME(4)
         MVC   CURTIME(2),UPTIME
         MVC   CURTIME+3(2),UPTIME+2
         MVC   CURTIME+6(2),UPTIME+4
*
         MVC   DISPTIME+21(8),CURTIME
DISPTIME WTO   'THE TIME IS: XX:XX:XX'
*
SLEEP    DS   0H
*        WAIT FOR X SECONDS
         STIMER WAIT,BINTVL=WAITTIME
*
         B     LOOPI
*
OPERCOMM DS   0H
*
* WHEN THE ECB IS POSTED WE RESUME EXECUTION AND GET THE ADDRESS
* OF THE CIB.
*
         L     R1,COMPTR          POINTER TO COMM FIELD
         LA    R2,4(,R1)          CIB ORIGIN
         L     R3,0(,R2)          PONTER TO FIRST CIB
*
*
* THE CIB IS MAPPED BY THE IEZCIB MACRO AND CONTAINS THE FOLLOWING
* FIELDS:
* CIBNEXT  DS    A      POINTER TO NEXT CIB ON CHAIN OR ZERO IF LAST
* CIBVERB  DS    X      VERB INDICATING TYPE OF COMMAND
* *                     X'04' - START, X'40' - STOP, X'44' - MODIFY
* CIBLEN   DS    X      LENGTH IN DOUBLEWORDS OF CIB
*          DS    XL4    RESERVED
* CIBASID  DS    H
* CIBCONID DS    X      CONSOLE ID - FROM WHERE COMMAND WAS ISSUED
*          DS    X      RESERVED
* CIBDATLN DS    H      LENGTH, IN BYTES, OF CIB DATA
* CIBDATA  DS    0C     DATA FROM MODIFY COMMAND
*
* THE VERB TELLS US IN THE CIB WAS CREATED AS A RESULT OF A START,
* STOP, OR MODIFY CONSOLE COMMAND. CIBDATALN IS THE LENGTH OF DATA
* ASSOCIATED WITH THE COMMAND. CIBDATA IS A VARIABLE LENGTH FIELD
* THAT CONTAINS THE DATA FROM THE START OR MODIFY COMMAND.
*
* NOW WE CHECK THE VERB TO DETERMINE WHAT TYPE OF COMMAND WE ARE
* DEALING WITH. WE ONLY EXPECT TO FIND EITHER A STOP OR A MODIFY
* COMMAND.
*
         CLI   4(R3),X'44'        IS IT A MODIFY COMMAND
         BE    MODIFY
*
         CLI   4(R3),X'40'        IS IT A STOP COMMAND
         BE    STOP
*
         WTO   '***  UNKNOWN CIB TYPE ***',ROUTCDE=(1,11)
         B     FREECIB
*
* HERE WE PROCESS A MODIFY COMMAND. WE POINT TO THE DATA AND GET
* THE DATA LENGTH FROM THE CIB.
*
MODIFY   DS   0H
         WTO   '***  MODIFY COMMAND RECEIVED ***',ROUTCDE=(1,11)
*
         LH    R5,14(,R3)         GET COMMAND LENGTH
         LA    R6,16(,R3)         POINT TO COMMAND
*
* SEE IF WE WANT TO CHANGE THE DELAY
*
         CLC   0(12,R6),=CL12'SET DELAY = '
         BNE   NOTSETD
         PACK  PACKWRK,12(2,R6)
         CVB   R1,PACKWRK
         MH    R1,=H'100'
         ST    R1,WAITTIME
*
NOTSETD  DS    0H
*
* NEXT WE COPY THE DATA INTO A MESSAGE AREA AND BAL TO A ROUTINE
* THAT WILL WTO THE MESSAGE TO THE CONSOLE.
*
         LR    R1,R5              COPY LENGTH
         BCTR  R1,0               SUBTRACT ONE
         MVC   WORK(4),=C'*** '
         EX    R1,MODMVC
*MODMVC  MVC   WORK+4(1),0(R6)
         LA    R1,WORK+4
         AR    R1,R5
         MVC   0(4,R1),=C' ***'
         LA    R1,WORK
         LA    R0,8(,R5)
         BAL   R14,WTO
*
         B     FREECIB
*
* HERE IS THE ROUTINE TO ISSUE THE WTO.
* FIRST WE SAVE THE CALLER?S REGISTERS, SET UP A NEW SAVE AREA,
* AND THEN CHECK THE LENGTH OF THE MESSAGE.
*
WTO      DS    0H
         STM   R14,R12,12(R13)
         LA    R3,SAVEA2
         ST    R13,4(,R3)
         ST    R3,8(,R13)
         LR    R13,R3
*
         LR    R10,R0             SAVE LENGTH
         LR    R11,R1             SAVE PTR TO TEXT
*
         LA    R1,1
         CR    R10,R1
         BL    WTO020
*
         LA    R1,80              MAX LEN
         CR    R10,R1
         BNH   WTO010
*
         LR    R10,R1
*
* NOW WE BUILD THE SVC 35 PARAMETER LIST.
*
WTO010   DS    0H
         MVC   WTOWORK(4),=X'00008000'
         LA    R1,4(,R10)
         STH   R1,WTOWORK
         BCTR  R10,0
         EX    R10,WTOMVC
*WTOMVC  MVC   WTOWORK+4(1),0(R11)
         LA    R1,WTOWORK
         LA    R1,5(R10,R1)
         MVC   0(4,R1),=X'00008020'
*
* NOW WE POINT TO THE PARAMETER LIST, ISSUE THE WTO SVC,
* AND THEN RETURN TO THE CALLER.
*
         LA    R1,WTOWORK
         SVC   35
*
WTO020   DS    0H
         L     R13,4(,R13)
         LM    R14,R12,12(R13)
         BR    R14
*
*
* IF THE VERB INDICATES A STOP COMMAND WE ISSUE A WTO AND EXIT.
*
STOP     DS   0H
         WTO   '***  STOP COMMAND RECEIVED ***',ROUTCDE=(1,11)
         B     EXIT
*
* ONCE WE HAVE PROCESSED A MODIFY COMMAND WE NEED TO FREE THE CIB
* SO OUR PROGRAM CAN ACCEPT ANOTHER MODIFY COMMAND. WE FREE IT USING
* QEDIT THE SAME WAY WE DID WITH THE START CIB.
*
FREECIB  DS    0H
         L     R1,COMPTR          POINTER TO COMM FIELDS
         LA    R2,4(,R1)          CIB ORIGIN
         L     R3,0(,R2)          PONTER TO FIRST CIB
*
         QEDIT ORIGIN=(R2),BLOCK=(R3)   FREE THE CIB
*
         B     LOOP
*
EXIT     DS    0H
         L     R13,4(,R13)        RESTORE
         LM    R14,R12,12(R13)           REGISTERS
         SLR   R15,R15            SET RETURN CODE = 0
         BR    R14                RETURN TO CALLER
*
MODMVC   MVC   WORK+4(1),0(R6)
WTOMVC   MVC   WTOWORK+4(1),0(R11)
*
WORK     DS    CL80
WTOWORK  DS    CL88
*
CURTIME  DC    C'HH:MM:SS '
WAITTIME DC    F'1000'            SETUP FOR 10 SEC DELAY

CTIME    DS    F
UPTIME   DS    CL7
         DS    0D
PACKWRK  DS    CL8
*
         DS    0D
COMPTR   DC    A(0)
*
SAVEA1   DC    18F'0'
SAVEA2   DC    18F'0'
*
R0       EQU   0
R1       EQU   1
R2       EQU   2
R3       EQU   3
R4       EQU   4
R5       EQU   5
R6       EQU   6
R7       EQU   7
R8       EQU   8
R9       EQU   9
R10      EQU   10
R11      EQU   11
R12      EQU   12
R13      EQU   13
R14      EQU   14
R15      EQU   15
         END  ,
/*
//LKED.SYSLMOD DD DISP=SHR,DSN=WEGSCD.LINKLIB
//LKED.SYSIN  DD *
  NAME CLOCKSTC(R)
/*
//
