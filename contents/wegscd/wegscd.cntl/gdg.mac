//WEGSCDGD JOB 'GENERATE GDG',CLASS=A,MSGCLASS=X
//DELETE  EXEC PGM=IDCAMS
//SYSPRINT  DD SYSOUT=*
//SYSIN     DD *
  DELETE SYSO.SMFARC GDG FORCE
/*
//CREATE  EXEC PGM=IDCAMS
//* THE MODEL GOES ON THE VOLUME WITH THE CATALOG
//MODEL     DD DSN=SYSO.SMFARC,DISP=(NEW,KEEP),
//             UNIT=3350,VOL=SER=MVS000,SPACE=(TRK,0),
//             DCB=(RECFM=VBS,LRECL=32756,BLKSIZE=32760)
//SYSPRINT  DD SYSOUT=*
//SYSIN     DD *
  DEFINE GDG (NAME(SYSO.SMFARC) LIMIT(255) NOEMPTY SCRATCH)
/*
//GEN1    EXEC PGM=IEFBR14
//NEWGEN    DD DSN=SYSO.SMFARC(+1),DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,VOL=SER=SMFARC,SPACE=(TRK,(1,1))
