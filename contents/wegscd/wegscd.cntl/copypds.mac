//WEGSCDR  JOB (DOUG,5278),CPY,CLASS=A,MSGCLASS=X
//ASM     EXEC PGM=IEBCOPY
//SYSPRINT  DD SYSOUT=*
//SYSUT1    DD DSN=WEGSCD.DYNAMASK,DISP=SHR
//SYSUT2    DD DSN=MVSCUS.DYNAMASK,UNIT=3350,VOL=SER=MVSCUS,
//             SPACE=(TRK,(15,1,4),RLSE),
//             DISP=(,KEEP,DELETE),
//             DCB=(RECFM=FB,BLKSIZE=19040,LRECL=80)
//SYSIN     DD *
  COPY INDD=SYSUT1,OUTDD=SYSUT2
/*
//
