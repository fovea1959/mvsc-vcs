//WEGSCDTA JOB (),'TEST ASM/FORT',CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1)
//ASM     EXEC ASMFC,PARM.ASM='OBJECT,NODECK'
//ASM.SYSGO DD DSN=WEGSCD.OBJ(ADDEM),DISP=SHR
//ASM.SYSIN DD DSN=WEGSCD.SRC(ADDEM),DISP=SHR
//F       EXEC FORTGCLG
//FORT.SYSIN DD *
      CALL ADDEM(1.5, 2.5, X)
      WRITE (6, 10) X
   10 FORMAT(1X, F8.2)
      STOP
      END
