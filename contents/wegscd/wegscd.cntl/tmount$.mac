//TMOUNTAS JOB (SETUP),'COMPILE TMOUNT',CLASS=A,MSGCLASS=X
//*
//* STEP 1: ASSEMBLE SOURCE WITH DYNAMIC PARM & WTO ALERTS
//*
//ASM      EXEC PGM=IFOX00,PARM='OBJ,NODECK'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSPRINT DD SYSOUT=*
//SYSGO    DD DSN=&&OBJMOD,DISP=(MOD,PASS),UNIT=SYSDA,
//            SPACE=(CYL,(1,1)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=400)
//SYSIN    DD *
TMOUNT   CSECT
         STM   14,12,12(13)        SAVE REGISTERS
         BALR  12,0                ESTABLISH BASE REGISTER
         USING *,12
         ST    13,SAVEAREA+4       CHAIN SAVE AREAS
         LA    11,SAVEAREA
         ST    11,8(13)
         LR    13,11
*
* PARSE PARM PASSED FROM JCL EXEC STATEMENT
*
         L     2,0(1)              R2 POINTS TO PARM LENGTH HALFWORD
         LH    3,0(2)              R3 = LENGTH OF PARM STRING
         LTR   3,3                 IS PARM LENGTH ZERO?
         BZ    NOPARM              IF YES, FAIL THE MOUNT
         CH    3,=H'64'            CHECK MAXIMUM FILENAME LENGTH
         BH    NOPARM              IF TOO LONG, EXHAUST EXCP CAPACITY
*
         BCTR  3,0                 DECREMENT BY 1 FOR EXECUTE (EX)
         EX    3,MOVPARM           DYNAMICALLY COPY PARM TO DATA AREA
         LA    3,1(,3)             RESTORE R3 TO TRUE BYTE COUNT
         STH   3,CCWSTART+6        CCW COUNT FIELD GETS PARM LENGTH
*
* OPEN THE TAPE DEVICE VIA THE JCL DD STATEMENT
*
         OPEN  (TAPEDCB,(UPDATE))
         TM    TAPEDCB+48,X'10'    DID THE DCB OPEN SUCCESSFULLY?
         BZ    OPENFAIL            IF NOT, TERMINATE WITH ERROR
*
* EXECUTE CHANNEL PROGRAM TO ISSUE 0x4B AUTOMOUNT TO HERCULES
*
         EXCP  IOBLOCK             SUBMIT CCW VIA EXCP
         WAIT  1,ECB=MYECB         WAIT FOR I/O COMPLETION
*
         CLI   MYECB,X'7F'         CHECK FOR SUCCESSFUL POST
         BNE   IOFAIL              IF NOT 7F, I/O ERROR OCCURRED
*
         CLOSE (TAPEDCB)
         WTO   'TM001I AUTOMOUNT SEQUENCE COMPLETED SUCCESSFULLY',     X
               ROUTCDE=(2,11),DESC=(6)
         SR    15,15               RETURN CODE = 0
         B     EXIT
*
NOPARM   WTO   'TM002E AUTOMOUNT FAILED: INVALID OR MISSING PARM STRINGX
               ',ROUTCDE=(1,2),DESC=(2)
         LA    15,12               RETURN CODE = 12
         B     EXIT
OPENFAIL WTO   'TM003E AUTOMOUNT FAILED: TAPEDD DD STATEMENT IS MISSINGX
               ',ROUTCDE=(1,2),DESC=(2)
         LA    15,8                RETURN CODE = 8
         B     EXIT
IOFAIL   WTO   'TM004E AUTOMOUNT FAILED: HERCULES DRIVER REJECTED MOUNTX
               ',ROUTCDE=(1,2),DESC=(2)
         LA    15,4                RETURN CODE = 4
*
EXIT     L     13,SAVEAREA+4       RESTORE OLD SAVE AREA
         L     14,12(13)           RESTORE RETURN REGISTER
         LM    0,12,20(13)         RESTORE REMAINING REGISTERS
         BR    14                  RETURN TO MVS
*
* EX TARGET AND DATA STRUCTURES
*
MOVPARM  MVC   TAPEVOL(0),2(2)     TARGET OF EX INSTRUCTION
*
SAVEAREA DC    18F'0'
MYECB    DC    F'0'
*
IOBLOCK  EQU   *
         DC    X'02'               IOB FLAGS
         DC    X'00'               IOB SENSE CODE
         DC    A(MYECB)            POINTER TO ECB
         DC    A(0)                IOB CSW AT COMPLETION
         DC    A(CCWSTART)         POINTER TO THE CCW
         DC    A(TAPEDCB)          POINTER TO TARGET DCB
         DC    A(0)                RESERVED FIELD
         DC    F'0'                RESERVED FIELD
*
CCWSTART CCW   X'4B',TAPEVOL,X'20',0 X'4B'=SET DIAGNOSE, X'20'=SLI FLAG
*
TAPEDCB  DCB   DSORG=PS,MACRF=(E),DDNAME=TAPEDD
*
TAPEVOL  DC    CL64' '             BUFFER HOUSING MOUNTED FILENAME
         END
/*
//*
//* STEP 2: LINK-EDIT THE MODULE INTO SYS2.LINKLIB
//*
//LKED     EXEC PGM=IEWL,PARM='XREF,LIST,LET'
//SYSLIN   DD DSN=&&OBJMOD,DISP=(OLD,DELETE)
//SYSUT1   DD UNIT=SYSDA,SPACE=(TRK,(10,5))
//SYSPRINT DD SYSOUT=*
//SYSLMOD  DD DSN=SYS2.LINKLIB(TMOUNT),DISP=SHR
/*
