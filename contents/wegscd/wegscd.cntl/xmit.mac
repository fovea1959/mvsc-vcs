//WEGSCD   JOB (DOUG,5278),XMIT370.PIX,CLASS=A,MSGCLASS=A
//S1      EXEC PGM=XMIT370
//STEPLIB   DD DSN=SYSC.LINKLIB,DISP=SHR
//XMITLOG   DD SYSOUT=*
//SYSPRINT  DD SYSOUT=*
//SYSUT1    DD DSN=CTON.PICTURE,UNIT=3350,VOL=SER=WEGSCD,
//             DISP=SHR
//SYSUT2    DD DSN=&&SYSUT2,UNIT=SYSALLDA,SPACE=(3120,(30000,30000)),
//             DISP=(,DELETE,DELETE)
//XMITOUT   DD DSN=CTON.PICTURE.XMI,DISP=(NEW,KEEP),
//             VOL=SER=WEGSCD,UNIT=3350,
//             SPACE=(TRK,(2700,200),RLSE)
//SYSIN     DD DUMMY
//SYSUDUMP  DD SYSOUT=*
//S2      EXEC PGM=XMIT370
//STEPLIB   DD DSN=SYSC.LINKLIB,DISP=SHR
//XMITLOG   DD SYSOUT=*
//SYSPRINT  DD SYSOUT=*
//SYSUT1    DD DSN=MARK.LIB.PICTURES.TEST,UNIT=3350,VOL=SER=WEGSCD,
//             DISP=SHR
//SYSUT2    DD DSN=&&SYSUT2,UNIT=SYSALLDA,SPACE=(3120,(30000,30000)),
//             DISP=(,DELETE,DELETE)
//XMITOUT   DD DSN=MARK.LIB.PICTURES.TEST.XMI,DISP=(NEW,KEEP),
//             VOL=SER=WEGSCD,UNIT=3350,
//             SPACE=(TRK,(600,200),RLSE)
//SYSIN     DD DUMMY
//SYSUDUMP  DD SYSOUT=*
