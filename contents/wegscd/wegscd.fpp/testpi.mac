//TESTFPP  JOB (FPP,TEST),'TEST FPP',REGION=0K,
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1)
//*
//T1      EXEC PGM=FPP,REGION=0K,
// PARM='-f -D_NDIGITS=900'
//STEPLIB   DD DISP=SHR,DSN=WEGSCD.LINKLIB
//SYSIN     DD DISP=SHR,DSN=WEGSCD.PI(PI#F@@)
//STDOUT    DD SYSOUT=*
//SYSPRINT  DD SYSOUT=*
//SYSTERM   DD SYSOUT=*
//*
//T2      EXEC PGM=FPP,REGION=0K,
// PARM='-f -D_NDIGITS=900'
//STEPLIB   DD DISP=SHR,DSN=WEGSCD.LINKLIB
//SYSIN     DD DISP=SHR,DSN=WEGSCD.PI(PI#F@@)
//STDOUT    DD DSN=&PPSRC,DISP=(NEW,PASS),
//             UNIT=3350,SPACE=(TRK,(10,10),RLSE),
