/*
 * subst.c - minimal preprocessor: object-like symbol substitution plus
 *           conditionals with integer and string expressions.
 *
 * Build:  cc -O2 -o subst subst.c
 * Usage:  subst [-DNAME[=value]] [-UNAME] ... < input > output
 *
 * Supported directives:
 *     #define NAME value     #undef NAME
 *     #ifdef NAME            #ifndef NAME
 *     #if EXPR               #elif EXPR
 *     #else                  #endif
 *
 * Expressions (lowest to highest precedence):
 *     ××   &&   == !=   < <= > >=   + -   * / %   ! - +(unary)
 *     integers (decimal or 0x hex), strings ("..." or '...'),
 *     defined(NAME) / defined NAME, macro names, parentheses
 *
 * Directive lines, and lines in skipped regions, are replaced with blan
 * lines so line numbers stay the same. A trailing backslash continues a
 * directive onto the next line.
 *
 * Exit status: 0 on success, 1 if any directive problem was reported
 * (output is still written), 2 for a bad command line.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <stdarg.h>

#define MAX_DEPTH 64    /* macro expansion nesting */
#define MAX_COND  64    /* #if nesting */

struct macro {
    char *name, *value;
    struct macro *next;
};
static struct macro *macros;

struct cond {
    int parent;     /* enclosing region was active */
    int active;     /* current branch is being output */
    int taken;      /* some branch of this #if has already been active *
    int seen_else;
    long line;      /* line of the opening directive */
};
static struct cond cstack[MAX_COND];
static int csp;

static int nerrors;     /* number of directive problems reported */

typedef struct { char *p; size_t len, cap; } Buf;

/* Report a problem with a directive and remember that it happened. */
static void diag(long lineno, const char *fmt, ...)
{
    va_list ap;
    fprintf(stderr, "line %ld: ", lineno);
    va_start(ap, fmt);
    vfprintf(stderr, fmt, ap);
    va_end(ap);
    fputc('\n', stderr);
    nerrors++;
}

static void *xrealloc(void *p, size_t n)
{
    p = realloc(p, n);
    if (!p) { perror("realloc"); exit(1); }
    return p;
}

static char *xstrndup(const char *s, size_t n)
{
    char *d = xrealloc(NULL, n + 1);
    memcpy(d, s, n);
    d[n] = '\0';
    return d;
}

static void buf_putn(Buf *b, const char *s, size_t n)
{
    if (b->len + n + 1 > b->cap) {
        b->cap = (b->len + n + 1) * 2;
        b->p = xrealloc(b->p, b->cap);
    }
    memcpy(b->p + b->len, s, n);
    b->len += n;
    b->p[b->len] = '\0';
}

static int ident_start(int c) { return isalpha(c) ×× c == '_'; }
static int ident_char(int c)  { return isalnum(c) ×× c == '_'; }

/* ---------- macro table ---------- */

static struct macro *find_macro(const char *name, size_t len)
{
    struct macro *m;
    for (m = macros; m; m = m->next)
        if (strlen(m->name) == len && memcmp(m->name, name, len) == 0)
            return m;
    return NULL;
}

static void define_macro(const char *name, size_t nlen, const char *valu
{
    struct macro *m = find_macro(name, nlen);
    if (m) {
        free(m->value);
    } else {
        m = xrealloc(NULL, sizeof *m);
        m->name = xstrndup(name, nlen);
        m->next = macros;
        macros = m;
    }
    m->value = xstrndup(value, strlen(value));
}

static void undef_macro(const char *name, size_t nlen)
{
    struct macro **pp, *m;
    for (pp = &macros; (m = *pp) != NULL; pp = &m->next)
        if (strlen(m->name) == nlen && memcmp(m->name, name, nlen) == 0)
            *pp = m->next;
            free(m->name); free(m->value); free(m);
            return;
        }
}

/* ---------- substitution ---------- */

/* Expand identifiers in s into out. `stack` holds macros currently bein
   expanded so that self-referential definitions cannot recurse forever.
static void expand(const char *s, Buf *out, struct macro **stack, int sp
{
    while (*s) {
        if (*s == '"' ×× *s == '\'') {          /* string: copy untouche
            char q = *s;
            const char *t = s + 1;
            while (*t && *t != q) {
                if (*t == '\\' && t[1]) t++;
                t++;
            }
            if (*t) t++;                         /* include closing quot
            buf_putn(out, s, (size_t)(t - s));
            s = t;
        } else if (ident_start((unsigned char)*s)) {
            const char *t = s;
            struct macro *m;
            int i, active = 0;
            while (ident_char((unsigned char)*t)) t++;
            m = find_macro(s, (size_t)(t - s));
            for (i = 0; m && i < sp; i++)
                if (stack[i] == m) active = 1;
            if (m && !active && sp < MAX_DEPTH) {
                stack[sp] = m;
                expand(m->value, out, stack, sp + 1);
            } else {
                buf_putn(out, s, (size_t)(t - s));
            }
            s = t;
        } else if (isdigit((unsigned char)*s)) {  /* number: 1E5, 0x1F,
            const char *t = s;
            while (ident_char((unsigned char)*t) ×× *t == '.') t++;
            buf_putn(out, s, (size_t)(t - s));
            s = t;
        } else {
            buf_putn(out, s, 1);
            s++;
        }
    }
}

/* ---------- #if expression evaluator ---------- */

/* A value is either an integer or a string (pointer into the source tex
   so nothing needs to be freed). */
typedef struct {
    int is_str;
    long n;
    const char *s;
    size_t len;
} Val;

typedef struct {
    const char *p;
    int depth;          /* macro-value nesting */
    const char *err;    /* first error, or NULL */
} Parser;

static Val mkint(long n) { Val v; v.is_str = 0; v.n = n; v.s = NULL; v.l

static int truth(Val v) { return v.is_str ? v.len > 0 : v.n != 0; }

static void fail(Parser *ps, const char *msg) { if (!ps->err) ps->err =

static void pws(Parser *ps)
{
    while (*ps->p == ' ' ×× *ps->p == '\t') ps->p++;
}

static int accept(Parser *ps, const char *op)
{
    size_t n = strlen(op);
    pws(ps);
    if (strncmp(ps->p, op, n) == 0) { ps->p += n; return 1; }
    return 0;
}

static Val parse_or(Parser *ps);

static Val primary(Parser *ps)
{
    const char *p;
    pws(ps);
    p = ps->p;

    if (*p == '(') {
        Val v;
        ps->p++;
        v = parse_or(ps);
        if (!accept(ps, ")")) fail(ps, "missing ')'");
        return v;
    }

    if (isdigit((unsigned char)*p)) {
        char *end;
        long n;
        if (p[0] == '0' && (p[1] == 'x' ×× p[1] == 'X'))
            n = strtol(p + 2, &end, 16);
        else
            n = strtol(p, &end, 10);
        ps->p = end;
        if (ident_char((unsigned char)*end)) fail(ps, "malformed number"
        return mkint(n);
    }

    if (*p == '"' ×× *p == '\'') {
        char q = *p;
        const char *t = p + 1;
        Val v;
        while (*t && *t != q) t++;
        if (!*t) {
            fail(ps, "unterminated string");
            ps->p = t;
            return mkint(0);
        }
        v.is_str = 1; v.n = 0; v.s = p + 1; v.len = (size_t)(t - p - 1);
        ps->p = t + 1;
        return v;
    }

    if (ident_start((unsigned char)*p)) {
        const char *t = p;
        size_t len;
        struct macro *m;

        while (ident_char((unsigned char)*t)) t++;
        len = (size_t)(t - p);
        ps->p = t;

        if (len == 7 && memcmp(p, "defined", 7) == 0) {
            int paren = accept(ps, "(");
            const char *n;
            size_t nl;
            pws(ps);
            n = ps->p;
            while (ident_char((unsigned char)*ps->p)) ps->p++;
            nl = (size_t)(ps->p - n);
            if (nl == 0) { fail(ps, "defined needs a name"); return mkin
            if (paren && !accept(ps, ")")) fail(ps, "missing ')' after d
            return mkint(find_macro(n, nl) != NULL);
        }

        m = find_macro(p, len);
        if (!m) return mkint(0);                /* undefined name -> 0 *
        if (ps->depth >= MAX_DEPTH) {
            fail(ps, "macro nesting too deep");
            return mkint(0);
        } else {
            Parser sub;
            Val v;
            sub.p = m->value; sub.depth = ps->depth + 1; sub.err = NULL;
            pws(&sub);
            if (!*sub.p) return mkint(0);       /* empty value -> 0 */
            v = parse_or(&sub);
            pws(&sub);
            if (!sub.err && *sub.p) sub.err = "macro value is not a vali
            if (sub.err) fail(ps, sub.err);
            return v;
        }
    }

    fail(ps, "syntax error in expression");
    return mkint(0);
}

static Val unary(Parser *ps)
{
    pws(ps);
    if (*ps->p == '!' && ps->p[1] != '=') {
        Val v;
        ps->p++;
        v = unary(ps);
        return mkint(!truth(v));
    }
    if (*ps->p == '-' ×× *ps->p == '+') {
        char c = *ps->p++;
        Val v = unary(ps);
        if (v.is_str) { fail(ps, "arithmetic on a string"); return mkint
        return mkint(c == '-' ? -v.n : v.n);
    }
    return primary(ps);
}

static Val mul(Parser *ps)
{
    Val l = unary(ps);
    for (;;) {
        char c;
        Val r;
        pws(ps);
        c = *ps->p;
        if (c != '*' && c != '/' && c != '%') break;
        ps->p++;
        r = unary(ps);
        if (l.is_str ×× r.is_str) { fail(ps, "arithmetic on a string");
        if (c != '*' && r.n == 0) { fail(ps, "division by zero"); l = mk
        l = mkint(c == '*' ? l.n * r.n : c == '/' ? l.n / r.n : l.n % r.
    }
    return l;
}

static Val add(Parser *ps)
{
    Val l = mul(ps);
    for (;;) {
        char c;
        Val r;
        pws(ps);
        c = *ps->p;
        if (c != '+' && c != '-') break;
        ps->p++;
        r = mul(ps);
        if (l.is_str ×× r.is_str) { fail(ps, "arithmetic on a string");
        l = mkint(c == '+' ? l.n + r.n : l.n - r.n);
    }
    return l;
}

enum { OP_EQ, OP_NE, OP_LT, OP_LE, OP_GT, OP_GE };

static int compare(Parser *ps, Val a, Val b, int op)
{
    int c;
    if (a.is_str && b.is_str) {
        size_t n = a.len < b.len ? a.len : b.len;
        c = memcmp(a.s, b.s, n);
        if (c == 0) c = (a.len > b.len) - (a.len < b.len);
    } else if (!a.is_str && !b.is_str) {
        c = (a.n > b.n) - (a.n < b.n);
    } else {
        fail(ps, "cannot compare a string with an integer");
        return 0;
    }
    switch (op) {
    case OP_EQ: return c == 0;
    case OP_NE: return c != 0;
    case OP_LT: return c < 0;
    case OP_LE: return c <= 0;
    case OP_GT: return c > 0;
    default:    return c >= 0;
    }
}

static Val relational(Parser *ps)
{
    Val l = add(ps);
    for (;;) {
        int op;
        Val r;
        if      (accept(ps, "<=")) op = OP_LE;
        else if (accept(ps, ">=")) op = OP_GE;
        else if (accept(ps, "<"))  op = OP_LT;
        else if (accept(ps, ">"))  op = OP_GT;
        else break;
        r = add(ps);
        l = mkint(compare(ps, l, r, op));
    }
    return l;
}

static Val equality(Parser *ps)
{
    Val l = relational(ps);
    for (;;) {
        int op;
        Val r;
        if      (accept(ps, "==")) op = OP_EQ;
        else if (accept(ps, "!=")) op = OP_NE;
        else break;
        r = relational(ps);
        l = mkint(compare(ps, l, r, op));
    }
    return l;
}

static Val parse_and(Parser *ps)
{
    Val l = equality(ps);
    while (accept(ps, "&&")) {
        Val r = equality(ps);
        l = mkint(truth(l) && truth(r));
    }
    return l;
}

static Val parse_or(Parser *ps)
{
    Val l = parse_and(ps);
    while (accept(ps, "××")) {
        Val r = parse_and(ps);
        l = mkint(truth(l) ×× truth(r));
    }
    return l;
}

/* Evaluate a whole #if/#elif expression; errors give a warning and fals
static int eval_cond(const char *s, long lineno)
{
    Parser ps;
    Val v;
    ps.p = s; ps.depth = 0; ps.err = NULL;
    v = parse_or(&ps);
    pws(&ps);
    if (!ps.err && *ps.p) ps.err = "unexpected text after expression";
    if (ps.err) {
        diag(lineno, "#if: %s (treated as false)", ps.err);
        return 0;
    }
    return truth(v);
}

/* ---------- input ---------- */

static char *read_line(FILE *fp)
{
    size_t cap = 128, len = 0;
    char *buf = xrealloc(NULL, cap);
    int c;

    while ((c = fgetc(fp)) != EOF && c != '\n') {
        if (len + 1 >= cap) { cap *= 2; buf = xrealloc(buf, cap); }
        buf[len++] = (char)c;
    }
    if (c == EOF && len == 0) { free(buf); return NULL; }
    if (len > 0 && buf[len - 1] == '\r') len--;
    buf[len] = '\0';
    return buf;
}

static const char *skip_ws(const char *s)
{
    while (*s == ' ' ×× *s == '\t') s++;
    return s;
}

static int is_directive(const char *line) { return *skip_ws(line) == '#'

/* If s begins with the whole word kw, return a pointer just past it. */
static const char *keyword(const char *s, const char *kw)
{
    size_t n = strlen(kw);
    if (strncmp(s, kw, n) == 0 && !ident_char((unsigned char)s[n]))
        return s + n;
    return NULL;
}

/* ---------- conditionals ---------- */

static int region_active(void)
{
    return csp == 0 ×× cstack[csp - 1].active;
}

static void push_cond(long lineno, int parent, int cond)
{
    if (csp >= MAX_COND) {
        diag(lineno, "conditionals nested too deeply");
        exit(1);
    }
    cstack[csp].parent    = parent;
    cstack[csp].active    = parent && cond;
    cstack[csp].taken     = cstack[csp].active;
    cstack[csp].seen_else = 0;
    cstack[csp].line      = lineno;
    csp++;
}

static void do_ifdef(const char *s, long lineno, int want_defined)
{
    const char *n;
    size_t nlen;
    int parent = region_active(), cond = 0;

    s = skip_ws(s);
    n = s;
    while (ident_char((unsigned char)*s)) s++;
    nlen = (size_t)(s - n);

    if (nlen == 0)
        diag(lineno, "#%s needs a name", want_defined ? "ifdef" : "ifnde
    else
        cond = ((find_macro(n, nlen) != NULL) == want_defined);

    push_cond(lineno, parent, cond);
}

static void do_if(const char *s, long lineno)
{
    int parent = region_active();
    /* Don't evaluate (or complain about) expressions in skipped regions
    push_cond(lineno, parent, parent ? eval_cond(s, lineno) : 0);
}

static void do_elif(const char *s, long lineno)
{
    struct cond *c;
    if (csp == 0) {
        diag(lineno, "#elif without #if");
        return;
    }
    c = &cstack[csp - 1];
    if (c->seen_else) {
        diag(lineno, "#elif after #else");
        c->active = 0;
        return;
    }
    if (!c->parent ×× c->taken)
        c->active = 0;
    else
        c->active = eval_cond(s, lineno);
    if (c->active) c->taken = 1;
}

static void do_else(long lineno)
{
    struct cond *c;
    if (csp == 0) {
        diag(lineno, "#else without #if");
        return;
    }
    c = &cstack[csp - 1];
    if (c->seen_else)
        diag(lineno, "duplicate #else");
    c->seen_else = 1;
    c->active = c->parent && !c->taken;
    if (c->active) c->taken = 1;
}

static void do_endif(long lineno)
{
    if (csp == 0)
        diag(lineno, "#endif without #if");
    else
        csp--;
}

/* ---------- directives ---------- */

static void do_directive(const char *line, long lineno)
{
    const char *s = skip_ws(skip_ws(line) + 1);   /* after '#' */
    const char *rest, *n;
    size_t nlen;

    /* Conditional directives are processed even in skipped regions so
       that nesting is tracked correctly. */
    if ((rest = keyword(s, "ifdef")) != NULL)  { do_ifdef(rest, lineno,
    if ((rest = keyword(s, "ifndef")) != NULL) { do_ifdef(rest, lineno,
    if ((rest = keyword(s, "if")) != NULL)     { do_if(rest, lineno);
    if ((rest = keyword(s, "elif")) != NULL)   { do_elif(rest, lineno);
    if (keyword(s, "else") != NULL)            { do_else(lineno);
    if (keyword(s, "endif") != NULL)           { do_endif(lineno);

    if (!region_active())
        return;                         /* ignore everything else when s

    if ((rest = keyword(s, "define")) != NULL) {
        char *val;
        size_t vlen;
        s = skip_ws(rest);
        n = s;
        if (!ident_start((unsigned char)*s)) {
            diag(lineno, "#define needs a name");
            return;
        }
        while (ident_char((unsigned char)*s)) s++;
        nlen = (size_t)(s - n);
        if (*s == '(') {
            diag(lineno, "function-like macros are not supported (%.*s)"
                 (int)nlen, n);
            return;
        }
        s = skip_ws(s);
        vlen = strlen(s);
        while (vlen > 0 && isspace((unsigned char)s[vlen - 1])) vlen--;
        val = xstrndup(s, vlen);
        define_macro(n, nlen, val);
        free(val);
    } else if ((rest = keyword(s, "undef")) != NULL) {
        s = skip_ws(rest);
        n = s;
        while (ident_char((unsigned char)*s)) s++;
        nlen = (size_t)(s - n);
        if (nlen) undef_macro(n, nlen);
        else diag(lineno, "#undef needs a name");
    } else {
        diag(lineno, "unsupported directive");
    }
}

int main(int argc, char **argv)
{
    int i;
    char *line;
    long lineno = 0;
    Buf b = { NULL, 0, 0 };
    struct macro *stack[MAX_DEPTH];

    for (i = 1; i < argc; i++) {
        if (strncmp(argv[i], "-D", 2) == 0 && argv[i][2]) {
            const char *d = argv[i] + 2, *eq = strchr(d, '=');
            if (eq) {
                char *v = xstrndup(eq + 1, strlen(eq + 1));
                define_macro(d, (size_t)(eq - d), v);
                free(v);
            } else {
                define_macro(d, strlen(d), "1");
            }
        } else if (strncmp(argv[i], "-U", 2) == 0 && argv[i][2]) {
            undef_macro(argv[i] + 2, strlen(argv[i] + 2));
        } else {
            fprintf(stderr, "usage: %s [-DNAME[=val]] [-UNAME] "
                            "< input > output\n", argv[0]);
            return 2;
        }
    }

    while ((line = read_line(stdin)) != NULL) {
        lineno++;
        if (is_directive(line)) {
            long startline = lineno;
            size_t n;
            putchar('\n');
            /* join backslash-continued lines */
            while ((n = strlen(line)) > 0 && line[n - 1] == '\\') {
                char *next = read_line(stdin);
                line[n - 1] = ' ';
                if (!next) break;
                lineno++;
                line = xrealloc(line, n + strlen(next) + 1);
                strcpy(line + n, next);
                free(next);
                putchar('\n');
            }
            do_directive(line, startline);
        } else if (!region_active()) {
            putchar('\n');              /* skipped line: keep numbering
        } else {
            b.len = 0;
            if (b.p) b.p[0] = '\0';
            expand(line, &b, stack, 0);
            if (b.p) fputs(b.p, stdout);
            putchar('\n');
        }
        free(line);
    }

    while (csp > 0) {
        csp--;
        diag(cstack[csp].line, "unterminated conditional (missing #endif
    }

    return nerrors ? 1 : 0;
}
