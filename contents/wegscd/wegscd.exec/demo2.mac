/* REXX */

/* IMPORT THE API LIBRARY */
CALL IMPORT FSSAPI

/* ADDRESS THE FSS SUBSYSTEM */
ADDRESS FSS

/* SWITCH TO FULL SCREEN MODE */
CALL FSSINIT

/* CALL INTERNAL FUNCTION TO BUILD THE MENU SCREEN */
CALL MENU

/* SHOW SCREEN UNTIL PFK03 PRESSED */
MSGT= ''
DO FOREVER
  /* UPDATE FIELD VALUES */
  CALL UPDATE

  /* REFRESH / SHOW SCREEN */
  RCKEY=FSSREFRESH()

  CALL FSSCOLOR '_MSG', #WHITE
  MSGT= ''

  IF RCKEY==#PFK03 × RCKEY==#PFK15 THEN LEAVE
  SEL = FSSFGET('_ZCMD')

  IF SEL <> '' THEN DO
    CALL TCPINIT
    RC = TCPOPEN('LOCALHOST', 1234)
    IF RC = 0 THEN DO
      S = _FD
      CALL TCPSEND S, E2A(SEL) ×× D2C(10)
      CALL TCPTERM
      MSGT=SEL ×× ' sent'
    END
    ELSE DO
      CALL FSSCOLOR '_MSG', #RED
      MSGT = 'SEND FAILED'
    END
  END
  ELSE DO
    CALL FSSCOLOR '_MSG', #PINK
    MSGT = 'Enter your badge ID!'
  END
END

CALL FSSCLOSE
EXIT

MENU:
  CALL INFO1
  CALL INFO2
  CALL MSG
  CALL OPTION
  CALL HEADING1
  CALL HEADING2
  CALL LOGO
  CALL FOOTER
  CALL PFKEYS
RETURN

UPDATE:
  /*
  CALL FSSFSET   '_TERMID', "CUU0C2"
  CALL FSSCOLOR  '_TERMID',#RED
  */
  CALL FSSFSET   '_SYSID' , MVSVAR('SYSNAME')
  CALL FSSFSET   '_USRID' , USERID()
  CALL FSSFSET   '_DATE'  , TODAY('SHGERMAN')
  CALL FSSFSET   '_TIME'  , TIME()
  CALL FSSFSET   '_MSG'   , MSGT
  CALL FSSFSET   '_ZCMD'  , ''
  CALL FSSCURSOR '_ZCMD'
RETURN

INFO1:
  /*
  CALL FSSTEXT "Terminal",1,1,,#PROT+#BLUE
  CALL FSSFIELD '_TERMID',1,11, 8,#PROT+#BLUE
  */
  CALL FSSTEXT "System"  ,2,1,,#PROT+#BLUE
  CALL FSSFIELD '_SYSID' ,2,11, 8,#PROT+#BLUE
  CALL FSSTEXT "TSO User",3,1,,#PROT+#BLUE
  CALL FSSFIELD '_USRID' ,3,11, 8,#PROT+#BLUE
RETURN

INFO2:
  CALL FSSTEXT "Date",1,66,,#PROT+#BLUE
  CALL FSSFIELD '_DATE',1,72,8,#PROT+#BLUE
  CALL FSSTEXT "Time",2,66,,#PROT+#BLUE
  CALL FSSFIELD '_TIME',2,72,8,#PROT+#BLUE
RETURN

MSG:
  CALL FSSFIELD '_MSG'   ,4,1,40, #PROT+#HI+#WHITE, ''
RETURN

OPTION:
  CALL FSSTEXT "ID #   ===>",5,1,,#PROT+#GREEN
  CALL FSSFIELD '_ZCMD',5,13,8,#TURQ+#NUM+#USCORE,''
RETURN

HEADING1:
  /*
  CALL FSSTEXT "The MVS 3.8j Tur(n)key System",7,15,,#PROT+#YELLOW
  CALL FSSTEXT "TK4- Version 1.00 Update 08 -- MVS PUT 8505",8,8,,#PROT+
  */
RETURN

HEADING2:
  /*
  CALL FSSTEXT "TSO Applications",10,22,,#PROT+#YELLOW+#REVERSE
  */
RETURN

LOGO:
  CALL FSSTEXT "          ",7,1,,#PROT+#BLUE+#REVERSE
  CALL FSSTEXT " ",8,1,,#PROT+#BLUE+#REVERSE
  CALL FSSTEXT " ",8,10,,#PROT+#BLUE+#REVERSE
  CALL FSSTEXT "          ",9,1,,#PROT+#BLUE+#REVERSE
  CALL FSSTEXT " ",10,1,,#PROT+#BLUE+#REVERSE
  CALL FSSTEXT " ",10,10,,#PROT+#BLUE+#REVERSE
  CALL FSSTEXT " ",11,1,,#PROT+#BLUE+#REVERSE
  CALL FSSTEXT " ",11,10,,#PROT+#BLUE+#REVERSE

  CALL FSSTEXT "X",8,4,,#PROT+#RED+#BLINK
RETURN

FOOTER:
  /*
  CALL FSSTEXT "Enter"       ,21,20,,#PROT+#GREEN
  CALL FSSTEXT "X"           ,21,26,,#PROT+#TURQ
  CALL FSSTEXT "to Terminate",21,28,,#PROT+#GREEN
  */
RETURN

PFKEYS:
  CALL FSSTEXT "PF3=Terminate",23,2,,#PROT+#BLUE
RETURN
