      IMPLICIT REAL*4 (A-H, O-Z)
      INTEGER W /800/, H /600/
C
      DATA X0 /-2.5/, X1 /1.5/
      DATA Y0 /1.5/, Y1 /-1.5/
C
      INTEGER IR(1024), IG(1024), IB(1024)
      INTEGER IIR, IIG, IIB
      INTEGER MAXITR /0/
C
      NAMELIST /MBROT/ W, H, X0, X1, Y0, Y1
      NAMELIST /ONEONE/ IX, IY, CR, CI, IRES, ITER
C
      WRITE (8, 9989)
9989  FORMAT (32H# {jobname:.2}_cl_r4_{jobid}.txt)
      WRITE(8, MBROT)
C
      DO 100 I = 1, 1024
       READ(5,9990,END=110) IIR, IIG, IIB
9990   FORMAT(3I5)
       MAXITR = I
       IR(I) = IIR
       IG(I) = IIG
       IB(I) = IIB
       WRITE(6,9991) I, IIR, IIG, IIB
9991   FORMAT (5H RGB=, 4I5)
100   CONTINUE
110   MAXITR = MAXITR - 1
      WRITE (6, 9992) MAXITR
9992  FORMAT (8H MAXITR=, I4)
      IF (MAXITR .GT. 0) GOTO 200
       WRITE (6, 9993)
9993   FORMAT (22H NO PALLETTE, ABORTING)
       STOP 8888
C
200   CONTINUE
      XS = AMIN1(X0,X1)
      YS = AMAX1(Y0,Y1)
      XSPAN = ABS(X1-X0)
      YSPAN = ABS(Y1-Y0)
C
      WRITE (7, 9999)
9999  FORMAT (32H# {jobname:.2}_cl_r4_{jobid}.ppm)
      WRITE (7, 9998) W, H
9998  FORMAT (2HP3, 2I5, 5H  256)
C
      DO 1000 IY = 1, H
       CI = YS - ((IY-1)*YSPAN/H)
C
       DO 500 IX = 1, W
        CR = XS + ((IX-1)*XSPAN/W)
        IRES = IMAND (CR, CI, ITER, MAXITR)
        IF (IX .NE. 1 .OR. IY .NE. 1) GOTO 405
C        WRITE(8, ONEONE)
C        WRITE(8, 5656) IRES, ITER
5656     FORMAT(5HIRES=, I7, 7H, ITER=, I7)
405     CONTINUE
        IF (IRES .GT. 0) GOTO 410
C        not in the set, so color it
         WRITE (7, 9997) IR(ITER), IG(ITER), IB(ITER)
9997     FORMAT (3I5)
        GOTO 420
410     CONTINUE
C        in the set. it gets black
         WRITE (7, 9996)
9996     FORMAT (5H0 0 0)
420     CONTINUE
500    CONTINUE
1000  CONTINUE
      STOP
      END
      FUNCTION IMAND (CR, CI, ITER, IMX)
C     non zero return value means in set
      IMPLICIT REAL*4 (A-H, O-Z)
      ZR = 0.0
      ZI = 0.0
      ZRSQR = 0.0
      ZISQR = 0.0
      ITER = 0
      DO 100 I = 1, IMX
       ZI = ZR * ZI
       ZI = ZI + ZI
       ZI = ZI + CI
       ZR = ZRSQR - ZISQR + CR
       ZRSQR = ZR * ZR
       ZISQR = ZI * ZI
       IF (ZRSQR + ZISQR .LT. 4.0) GOTO 90
        IMAND = 0
        ITER = I
        IF (I .EQ. 1) ITER = 2
        RETURN
90     CONTINUE
100   CONTINUE
      IMAND = 1
      ITER = I
      RETURN
      END
