//PIFG#@ JOB   (001),'PI FORTG',REGION=6144K,
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),TIME=1440
//*
//JOBPROC   DD DISP=SHR,DSN=WEGSCD.PI
//*
//*
//ALLOC   EXEC PI@ALLOC,DSN='WEGSCD.PI.FG'
//*
//*
//FPP     EXEC PI@FPP,M='PI#F@@',P='-D_NDIGITS=90',
//             COND=(0,NE)
//SRCOUT    DD DSN=&PPSRC,DISP=(NEW,PASS),
//             UNIT=3350,SPACE=(TRK,(10,10),RLSE),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=19040)
//*
//*
//CALC    EXEC FORTGCLG,
//             COND=(0,NE),
//             REGION.FORT=384K,PARM.FORT='NOLIST',
//             PARM.LKED=LET,
//             TIME.GO=1440,REGION.GO=6144K
//FORT.SYSLIN DD UNIT=SYSDA
//FORT.SYSABEND DD SYSOUT=*
//FORT.SYSIN DD DSN=&PPSRC,DISP=(OLD,PASS)
//GO.FT06F001 DD SYSOUT=*
//GO.FT07F001 DD DSN=*.ALLOC.CREATE.ANSWER,DISP=(OLD,PASS)
//*
//*
//CHECK   EXEC PI@CHECK,COND=(0,NE)
//ANSWER    DD DSN=*.ALLOC.CREATE.ANSWER,DISP=(OLD,PASS)
