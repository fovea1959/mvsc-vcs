//PIF77#@ JOB (001),'PI F77',REGION=0K,
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),TIME=1440
//*
//JOBPROC   DD DISP=SHR,DSN=WEGSCD.PI
//*
//SCRATCH EXEC PGM=IDCAMS
//SYSPRINT  DD SYSOUT=*
//SYSIN     DD *
  DELETE WEGSCD.PI.F77
  SET MAXCC=0
/*
//*
//CREATE  EXEC PGM=IEFBR14
//ANSWER    DD DSN=WEGSCD.PI.F77,
//             DCB=(RECFM=FB,LRECL=133,BLKSIZE=9310),
//             UNIT=3350,SPACE=(TRK,(10,10)),
//             DISP=(NEW,CATLG,DELETE)
//*
//*
//CPP     EXEC PIFPP,M='PI#F@@',P='-D_NDIGITS=9000'
//SRCOUT    DD DSN=&PPSRC,DISP=(NEW,PASS),
//             UNIT=3350,SPACE=(TRK,(10,10),RLSE),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=19040)
//*
//*
//CALC    EXEC F77CLG,
//             PARM.LKED=LET,
//             TIME.GO=1440,REGION.GO=6144K
//FORT.SYSIN DD DSN=&PPSRC,DISP=(OLD,PASS)
//GO.FT06F001 DD DSN=*.CREATE.ANSWER,DISP=(OLD,PASS)
//GO.FT07F001 DD SYSOUT=*
//*
//*
//CHECK   EXEC CHECK#PI,COND=(0,NE)
//ANSWER    DD DSN=*.CREATE.ANSWER,DISP=(OLD,PASS)
