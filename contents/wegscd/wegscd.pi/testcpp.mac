//WEGSCDCP JOB (001),'Test CPP',CLASS=A,MSGCLASS=X,MSGLEVEL=0
//CPP     EXEC PGM=GCC,REGION=4096K,
// PARM='-DVV=44 -E -nostdinc -o dd:out -'
//* following gives no output
//* PARM='-DVV=44 -traditional -E -nostdinc -o dd:out -'
//STEPLIB   DD DISP=SHR,DSN=GCC.LINKLIB
//SYSIN     DD *
      INT A = VV
      INTEGER N(VV)
C
      DO 10 I = 1, 10
        PRINT *, I
10    CONTINUE
