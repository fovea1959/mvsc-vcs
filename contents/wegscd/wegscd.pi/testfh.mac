//PIFH2#@ JOB (001),'PI FORTH, O=2',REGION=6144K,
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),TIME=1440
//*
//*
//CREATE  EXEC PGM=IEFBR14
//PPSTV     DD DSN=&PPSRC,DISP=(NEW,PASS),
//             UNIT=3350,SPACE=(TRK,(10,10)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=19040)
//*
//*
//PP      EXEC PGM=FPP,REGION=2048K,
// PARM='-f -D_NDIGITS=900'
//STEPLIB   DD DISP=SHR,DSN=WEGSCD.LINKLIB
//SYSIN     DD DISP=SHR,DSN=WEGSCD.PI(PI#F@@)
//SYSPRINT  DD DSN=&PPSRC,DISP=(MOD,PASS)
//*SYSPRINT  DD SYSOUT=*
//SYSTERM   DD SYSOUT=*
//*
//*
//CALC    EXEC FORTHCLG,
//             REGION.FORT=384K,PARM.FORT='LIST,OPT=2',
//             PARM.LKED=LET,
//             TIME.GO=1440,REGION.GO=6144K
//FORT.SYSLIN DD UNIT=SYSDA
//FORT.SYSABEND DD SYSOUT=*
//FORT.SYSIN DD DSN=&PPSRC,DISP=(OLD,PASS)
//GO.FT06F001 DD SYSOUT=*
//GO.FT07F001 DD SYSOUT=*
//
