C     ARRSIZ = 'desired digits' * 14 / 4
C     ARRSIZ = 315000 means 90000 digits
C     ARRSIZ = 630000 means 180000 digits
#ifdef _NDIGITS
#define _ARRSIZ eval((_NDIGITS*14/4)+1)
#else
#error you forgot to define _NDIGITS
#endif
C
      INTEGER N/_NDIGITS/, ARRSIZ /_ARRSIZ/
C
      INTEGER ARR(_ARRSIZ)
      INTEGER I, IREV, J, JREV, SUM, CARRY, D
C
      NAMELIST /PARMS/ N, ARRSIZ
      WRITE (6, PARMS)
C
      CALL OUTINI
      CALL OUT (0, 'Ld')
C
      CARRY = 0
C
      DO 10 I = 1, ARRSIZ
        ARR(I) = 2000
10    CONTINUE
C
      DO 1000 IREV = 1, ARRSIZ, 14
       I = ARRSIZ - IREV + 1
C
       SUM = 0
       DO 500 JREV = 1, I
        J = I - JREV + 1
C
        SUM = SUM*J + 10000*ARR(J)
        ARR(J) = MOD (SUM, J*2 - 1)
        SUM = SUM / (J*2 - 1)
500    CONTINUE
C
       D = CARRY + (SUM/10000)
C       WRITE (6, 9999) D
9999   FORMAT (5H D = , I4)
       CALL OUT4 (D)
       CARRY = MOD (SUM, 10000)
1000  CONTINUE
      CALL OUTFL
      STOP
      END
      SUBROUTINE OUTINI
      COMMON /OUTBUF/ OI, O
      INTEGER OI
      INTEGER O(80)
C
      INTEGER SPACE/1H /
      OI = 1
      DO 10 I = 1, 80
       O(I) = SPACE
10    CONTINUE
      RETURN
      END
      SUBROUTINE OUT4 (N)
      INTEGER I, N, NN
      NN = N
      DO 10 I = 1, 4
       J = MOD (NN / 1000, 10)
C       WRITE (6, 9999) I, J
9999   FORMAT (5H I = , I2, 5H J = , I4)
       CALL OUT (J, 'i4')
       NN = NN * 10
10    CONTINUE
      RETURN
      END
      SUBROUTINE OUT (I, Y)
      COMMON /OUTBUF/ OI, O
      INTEGER OI
      INTEGER O(80)
C
      INTEGER Y
      INTEGER DIGIT(10) /1H0,1H1,1H2,1H3,1H4,1H5,1H6,1H7,1H8,1H9/
      O(OI) = DIGIT(I+1)
      OI = OI + 1
      IF (OI .GT. 80) CALL OUTFL
      RETURN
      END
      SUBROUTINE OUTFL
      COMMON /OUTBUF/ OI, O
      INTEGER OI
      INTEGER O(80)
      WRITE (7, 99) O
99    FORMAT (80A1)
      CALL OUTINI
      RETURN
      END
