C     ARRSIZ = (10 * 'desired digits') div 3
#ifdef _NDIGITS
#define _ARRSIZ eval(_NDIGITS*10/3)
#else
#error you forgot to define _NDIGITS
#endif
C
      INTEGER ARRSIZ/_ARRSIZ/, N/_NDIGITS/
      INTEGER I, J, K, Q, X, NINES, PREDIG
      INTEGER A(_ARRSIZ)
C
      NAMELIST /PARMS/ N, ARRSIZ
      WRITE (6, PARMS)
C
      CALL OUTINI
C
      DO 10 J = 1, ARRSIZ
       A(J) = 2
10    CONTINUE
C
      NINES = 0
      PREDIG = 0
C
      DO 1000 J = 1, N
       Q = 0
       DO 500 II = 1, ARRSIZ
        I = ARRSIZ - II + 1
C
        X = 10 * A(I) + Q * I
        A(I) = MOD (X, 2 * I - 1)
        Q = X / (2 * I - 1)
 500   CONTINUE
C
       A(1) = MOD (Q, 10)
       Q = Q / 10
       IF (Q .NE. 9) GOTO 600
C       Q == 9
        NINES = NINES + 1
        GOTO 999
  600  IF (Q .NE. 10) GOTO 700
C       Q == 10
        CALL OUT (PREDIG + 1, 'Q+')
        IF (NINES .EQ. 0) GOTO 601
         DO 605 K = 1, NINES
          CALL OUT (0, 'QQ')
  605    CONTINUE
  601   CONTINUE
        PREDIG = 0
        NINES = 0
        GOTO 999
  700   CONTINUE
C       Q IS SOMETHING ELSE
        CALL OUT (PREDIG, 'qx')
        PREDIG = Q
        IF (NINES .EQ. 0) GOTO 705
         DO 703 K = 1, NINES
          CALL OUT (9, 'q9')
  703    CONTINUE
         NINES = 0
  705   CONTINUE
  999  CONTINUE
 1000 CONTINUE
      CALL OUT (PREDIG, 'qp')
      CALL OUTFL
      STOP
      END
      SUBROUTINE OUTINI
      COMMON /OUTBUF/ OI, O
      INTEGER OI
      INTEGER O(80)
C
      INTEGER SPACE/1H /
      OI = 1
      DO 10 I = 1, 80
       O(I) = SPACE
10    CONTINUE
      RETURN
      END
      SUBROUTINE OUT (I, Y)
      COMMON /OUTBUF/ OI, O
      INTEGER OI
      INTEGER O(80)
C
      INTEGER Y
      INTEGER DIGIT(10) /1H0,1H1,1H2,1H3,1H4,1H5,1H6,1H7,1H8,1H9/
      O(OI) = DIGIT(I+1)
      OI = OI + 1
      IF (OI .GT. 80) CALL OUTFL
      RETURN
      END
      SUBROUTINE OUTFL
      COMMON /OUTBUF/ OI, O
      INTEGER OI
      INTEGER O(80)
      WRITE (7, 99) O
99    FORMAT (80A1)
      CALL OUTINI
      RETURN
      END
