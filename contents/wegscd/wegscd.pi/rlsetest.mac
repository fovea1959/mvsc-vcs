//RLSETEST JOB (001),'TEST RELEASE',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1)
//*
//SCRATCH EXEC PGM=IDCAMS
//SYSPRINT  DD SYSOUT=*
//SYSIN     DD *
  DELETE WEGSCD.XXXX
  SET MAXCC=0
/*
//*
//CREATE  EXEC PGM=IEFBR14
//ANSWER    DD DSN=WEGSCD.XXXX,
//             DCB=(RECFM=FB,LRECL=133,BLKSIZE=9310),
//             UNIT=3350,SPACE=(TRK,(10,10)),
//             DISP=(NEW,CATLG,DELETE)
//*
//COPY    EXEC PGM=IEBGENER
//SYSPRINT  DD SYSOUT=*
//SYSUT2    DD DSN=*.CREATE.ANSWER,SPACE=(,,RLSE),DISP=(OLD,PASS)
//SYSUT1    DD *
 HI BOB.
//SYSIN     DD DUMMY
