//             DISP=(NEW,PASS,DELETE),
//             SPACE=(TRK,(10,10),RLSE),UNIT=SYSDA
//********************************************************************
//S2      EXEC PGM=PICOMPR
//STEPLIB   DD DSN=WEGSCD.LINKLIB,DISP=SHR
//PI        DD DISP=SHR,DSN=WEGSCD.PI#1M
//ANSWER    DD DISP=SHR,DSN=*.S1.GO.SYSPRINT
//SYSPRINT  DD SYSOUT=*
//SYSTERM   DD SYSOUT=*
//SYSIN     DD DUMMY
//
