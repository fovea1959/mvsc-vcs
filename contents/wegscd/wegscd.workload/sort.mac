//DISKSORT JOB (1),SORTTEST,MSGLEVEL=(1,1),CLASS=A,MSGCLASS=X
/*JOBPARM LINES=2100
//SORTDG  EXEC PGM=IEBDG
//SEQOUT    DD UNIT=3350,VOL=SER=WORK00,
//             DCB=(LRECL=80,RECFM=FB,BLKSIZE=8000),
//             DSN=&&SORTTEMP,DISP=(NEW,PASS),
//             SPACE=(CYL,(100,20),RLSE)
//SYSPRINT  DD SYSOUT=*
//SYSIN     DD *
 DSD OUTPUT=(SEQOUT)
 FD NAME=F1,LENGTH=10,STARTLOC=1,FORMAT=RA
 FD NAME=F2,LENGTH=10,STARTLOC=11,FORMAT=ZD,INDEX=1
 FD NAME=F3,LENGTH=60,STARTLOC=21
 CREATE QUANTITY=1000000,NAME=(F1,F2,F3)
 END
/*
//*
//ORIGINL EXEC PGM=IEBGENER
//SYSUT1    DD DSN=&&SORTTEMP,DISP=(OLD,PASS)
//SYSUT2    DD SYSOUT=D
//SYSPRINT  DD SYSOUT=*
//SYSIN     DD DUMMY
//*
//SORT    EXEC PGM=SORT,REGION=1024K,PARM='MSG=AP'
//* =============================================================
//* VVVVV   IMPORTANT
//SORTOUT   DD SYSOUT=D,DCB=(LRECL=80,BLKSIZE=80,RECFM=F)
//* ›››››   IMPORTANT
//* =============================================================
//STEPLIB   DD DSN=SYSC.LINKLIB,DISP=SHR
//SYSOUT    DD SYSOUT=*
//SYSUDUMP  DD SYSOUT=*
//SYSPRINT  DD SYSOUT=*
//SORTLIB   DD DSN=SYSC.SORTLIB,DISP=SHR
//SORTWK01  DD UNIT=3350,SPACE=(CYL,(40,20))
//SORTWK02  DD UNIT=3350,SPACE=(CYL,(40,20))
//SORTWK03  DD UNIT=3350,SPACE=(CYL,(40,20))
//SORTWK04  DD UNIT=3350,SPACE=(CYL,(40,20))
//SORTWK05  DD UNIT=3350,SPACE=(CYL,(40,20))
//SORTWK06  DD UNIT=3350,SPACE=(CYL,(40,20))
//SYSIN     DD *
 SORT FIELDS=(1,10,BI,A)
 RECORD TYPE=F,LENGTH=(80)
 END
/*
//SORTIN    DD DSN=&&SORTTEMP,DISP=(OLD,PASS)
