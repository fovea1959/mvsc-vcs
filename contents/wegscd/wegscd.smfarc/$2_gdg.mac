//WEGSCDGD JOB 'GENERATE GDG',CLASS=A,MSGCLASS=X
//CREATE  EXEC PGM=IDCAMS
//* THE MODEL GOES ON THE VOLUME WITH THE CATALOG
//MODEL     DD DSN=SMFARC.DATA,DISP=(NEW,KEEP),
//             UNIT=3350,VOL=SER=SMFARC,SPACE=(TRK,0),
//             DCB=(RECFM=VBS,LRECL=32756,BLKSIZE=32760)
//SYSPRINT  DD SYSOUT=*
//SYSIN     DD *
  DEFINE GDG (NAME(SMFARC.DATA) LIMIT(255) NOEMPTY SCRATCH)
