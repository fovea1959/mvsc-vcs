//WEGSCD   JOB (1),'SETUP USER CATS',CLASS=S,MSGLEVEL=(1,1),
//             MSGCLASS=A
//*
//IDCAMS01 EXEC PGM=IDCAMS,REGION=4096K
//SYSPRINT DD  SYSOUT=*
//SMFARC   DD  UNIT=3350,DISP=OLD,VOL=SER=SMFARC
//SYSIN    DD  *

  DEFINE USERCATALOG ( -
         NAME (UCSMFARC) -
         VOLUME (SMFARC) -
         TRACKS (030 0) -
         FOR (9999) )

  DEFINE ALIAS ( -
         NAME (SMFARC) -
         RELATE (UCSMFARC) )

//
