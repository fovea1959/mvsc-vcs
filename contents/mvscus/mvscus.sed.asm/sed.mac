* Function 'usage' page table
@@PGT0   DS    0F
         DC    A(@@PG0)
@@LC0    EQU   *
         DC    C'Usage: %s [OPTION]... {script-only-if-no-other-s'
         DC    C'cript} [input-file]...'
         DC    X'15'
         DC    X'15'
         DC    C'  -n, --quiet, --silent'
         DC    X'15'
         DC    C'                 suppress automatic printing of '
         DC    C'pattern space'
         DC    X'15'
         DC    C'  -e script, --expression=script'
         DC    X'15'
         DC    C'                 add the script to the commands '
         DC    C'to be executed'
         DC    X'15'
         DC    C'  -f script-file, --file=script-file'
         DC    X'15'
         DC    C'                 add the contents of script-file'
         DC    C' to the commands to be executed'
         DC    X'15'
         DC    C'      --help     display this help and exit'
         DC    X'15'
         DC    C'  -V, --version  output version information and '
         DC    C'exit'
         DC    X'15'
         DC    X'15'
         DC    C'If no -e, --expression, -f, or --file option is '
         DC    C'given, then the first'
         DC    X'15'
         DC    C'non-option argument is taken as the sed script t'
         DC    C'o interpret.  All'
         DC    X'15'
         DC    C'remaining arguments are names of input files; if'
         DC    C' no input files are'
         DC    X'15'
         DC    C'specified, then the standard input is read.'
         DC    X'15'
         DC    X'15'
         DC    X'0'
@@LC1    EQU   *
