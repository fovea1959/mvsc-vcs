VOLMAP   TITLE 'PRINT VTOC DISK MAP AND CONDENSED VTOC LISTING'
*---------------------------------------------------------------------*
* This utility produces a map print of a disk volume, which type
* is specified in the PARM of the 'EXEC' JCL statement.
* The following types can be specified:
*  1. TYPE=3380
*  2. TYPE=3380E
*  3. TYPE=3380K
*  4. TYPE=3390
*  5. TYPE=33902
*  6. TYPE=33903
*  7. TYPE=3350
*  8. TYPE=3330
*  9. TYPE=3331
* 10. TYPE=3340
* 11. TYPE=3375
* In the second part of VOLMAP, the disk map, which is in storage
* will we made suitable for printing.
* Input:  SYSUT1:   IEHLIST 'LISTVTOC VOL=uuuu=vvvvvv,FORMAT' output
* Output: SYSUT2:   Condensed VTOC listing of all data sets with
*                   data set sequence numbers.
*         SYSPRINT: Map off the entire volume, depending of the
*                   EXEC. parm. each occupied track does contain
*                   a data set number (see SYSUT2). The free tracks
*                   are blank. a 'lost' track (not described by any
*                   DSCB or VPSM (ix VTOC)) is marked as '****'
*                   and a double described track (described by 2
*                   or more DSCB's or VPSM)) is marked as '===='
*
* Author: Rob Prins
*
* Change log:
* 1985/02/24: Add 3380 extended capacity support, TYPE=3380E and 3380K
* 2024/09/09: Module heavily reworked and improved. 3350 volume added.
* 2024/10/14: 3330, 3330-1 and 3340 volumes added.
* 2024/10/20: 3375 volumes added.
*---------------------------------------------------------------------*
VOLMAP   CSECT
         SAVE  (14,12),,*
         LR    R12,R15                 SETUP BASE
         USING VOLMAP,R12
         LA    R1,SAV0001              SAVE AREA
         ST    R1,8(,R13)              FORWARD POINTER
         ST    R13,4(,R1)              BACKWARD POINTER
         LR    R13,R1                  This is our save area
MAIN001  DS    0H
         XC    #DSCTR,#DSCTR           Clear data set counter
         XC    RTNCODE,RTNCODE         Clear return code
         MVC   TYPE,=CL8'TYPE'         Obtain TYPE= parameter
         CALL  PARMSCAN,(TYPE,PARM)    Obtain parm in // EXEC
         LTR   15,15                   Parameter found?
         BNZ   MAIN040                 No: default is 3390
         CLC   =C'3380E',PARM+2        3380 dual capacity?
         BE    MAIN020                 Yes: process
         CLC   =C'3380K',PARM+2        3380 triple capacity?
         BE    MAIN030                 Yes: process
         CLC   =C'3380',PARM+2         Normal 3380?
         BE    MAIN010                 Yes: process
         CLC   =C'33902',PARM+2        3390 model 2?
         BE    MAIN050                 Yes: process
         CLC   =C'33903',PARM+2        3390 model 3?
         BE    MAIN060                 Yes: process
         CLC   =C'3390',PARM+2         3390?
         BE    MAIN040                 Yes: process
         CLC   =C'3330',PARM+2         3330?
         BE    MAIN062                 Yes: process
         CLC   =C'3331',PARM+2         3330-1?
         BE    MAIN064                 Yes: process
         CLC   =C'3340',PARM+2         3340?
         BE    MAIN066                 Yes: process
         CLC   =C'3375',PARM+2         3375
         BE    MAIN068                 Yes: process
         CLC   =C'3350',PARM+2         3350?
         BE    MAIN070                 Yes: carry
         B     MAIN040                 Default 3390
MAIN010  MVC   TRKSCYL,=F'15'          3380 -> 15 tracks/cylinder
         MVC   TOTTR,=AL4(15*885)      Total tracks on a 3380
         B     MAIN150                 Carry
MAIN020  MVC   TRKSCYL,=F'15'          3380E -> 15 tracks/cylinder
         MVC   TOTTR,=AL4(15*1770)     Total tracks on a 3380E
         B     MAIN150                 BRANCH
MAIN030  MVC   TRKSCYL,=F'15'          3380K -> 15 tracks/cylinder
         MVC   TOTTR,=AL4(15*2655)     Total tracks on a 3380K
         B     MAIN150                 BRANCH
MAIN040  MVC   TRKSCYL,=F'15'          3390 -> 15 tracks/cylinder
         MVC   TOTTR,=AL4(15*1113)     Total tracks on a 3390
         B     MAIN150                 BRANCH
MAIN050  MVC   TRKSCYL,=F'15'          3390  -> 15 tracks/cylinder
         MVC   TOTTR,=AL4(15*2226)     Total tracks on a 3390-2
         B     MAIN150                 BRANCH
MAIN060  MVC   TRKSCYL,=F'15'          3390  -> 15 tracks/cylinder
         MVC   TOTTR,=AL4(15*3339)     Total tracks on a 3390-3
         B     MAIN150                 BRANCH
MAIN062  MVC   TRKSCYL,=F'19'          3330  -> 19 tracks/cylinder
         MVC   TOTTR,=AL4(19*404)      Total tracks on a 3330
         B     MAIN160                 BRANCH
MAIN064  MVC   TRKSCYL,=F'19'          3330-1  -> 19 tracks/cylinder
         MVC   TOTTR,=AL4(19*808)      Total tracks on a 3330-1
         B     MAIN160                 BRANCH
MAIN066  MVC   TRKSCYL,=F'12'          3340  -> 12 tracks/cylinder
         MVC   TOTTR,=AL4(12*696)      Total tracks on a 3340
         B     MAIN140                 BRANCH
MAIN068  MVC   TRKSCYL,=F'12'          3375  -> 12 tracks/cylinder
         MVC   TOTTR,=AL4(12*959)      Total tracks on a 3375
         B     MAIN140                 BRANCH
MAIN070  MVC   TRKSCYL,=F'30'          3350  -> 30 tracks/cylinder
         MVC   TOTTR,=AL4(30*555)      Total tracks on a 3350
         MVC   MAPDCB+DCBLRECL-IHADCB(2),=AL2(164)
         MVC   MAPDCB+DCBBLKSI-IHADCB(2),=AL2(1640)
         B     MAIN200                 BRANCH
MAIN140  MVI   HEAD12,C' '         Blank track 12 and higher in header
         MVC   HEAD12+1(14),HEAD12
MAIN150  MVI   HEAD15,C' '         Blank track 15 and higher in header
         MVC   HEAD15+1(19),HEAD15
MAIN160  MVI   HEAD19,C' '         Blank track 19 and higher in header
         MVC   HEAD19+1(164),HEAD19
MAIN200  DS    0H
*
*        Obtain 120,000 bytes storage.
*        This size should be at least twice the number of tracks
*        of the largest device type (3390-3).
*
         GETMAIN RU,LV=120000          Obtain room for the disk map
         LR    R11,R1                  Start address in register 11
         ST    R11,MAPADDR             Save this address
         L     R4,=A(60000)            For BCT = half length DISKMAP
MAIN210  DS    0H
         MVC   0(2,R11),=X'270F'       FILLUP WITH ALL X'270F' (9999)
         LA    R11,2(,R11)             Next entry
         BCT   R4,MAIN210              Loop until 60K entries cleared
         L     R11,MAPADDR             PICKUP START DISK MAP
         XC    0(2,11),0(11)           1st entry is label with
*                                      number = 0000
         OPEN  (IEHLIST,,MAPDCB,(OUTPUT),SYSUT2,(OUTPUT))
*
         L     R4,X'4C'(0)             A(CVT)
         UNPK  DAYNB(6),56(4,R4)       Julian date from CVT
         OI    DAYNB+5,X'F0'           CLEAR SIGN
* From now: R4 = data set counter and R5 = line counter
         XR    R4,R4                   Clear register 4
         XR    R5,R5                   Clear register 5
         MVI   DSNLINE+1,X'40'         PREPARE HEADERS TILL PUT
         MVC   DSNLINE+2(119),DSNLINE+1
         MVC   DSNAME(35),=CL35'List of data sets on volume serial'
         BAS   R14,READIEH             Read first IEHLIST record
         MVC   EXT(6),VOLUME           Volume serial
         MVC   DSO(12),=C'Julian date.'
         MVC   BLK(5),DAYNB+1
         MVC   HEADER1(121),DSNLINE    Header complete
         PUT   SYSUT2,HEADER1          WRITE HEADER
         MVC   DSNLINE,LABEL1          MOVE VTOC LINE
         BAS   R14,READIEH             Line after 'CONTENTS OF ...'
         BAS   R14,READIEH             Read format 4 line
         BAS   R14,READIEH             2ND FORMAT 4 LINE
         OI    PRTSW,X'01'             SET SWITCH ON
         MVI   F4FIL,C' '              BLANK BEGINNING OF
         MVC   F4FIL+1(L'F4FIL-1),F4FIL    FORMAT4 SPACE LINE
         MVC   $XTENT,=C'00'
         MVC   $OWCYL+1,F4SCYL         MOVE
         MVC   $OWHEAD,F4STRK              VTOC
         MVC   $IGHCYL+1,F4TCYL                BOUNDARIES
         MVC   $IGHHEAD,F4TTRK                    TO FORMAT 1 SPACE
         BAS   14,$EXTENT              Process VTOC extents
*
*------- ----- ----------------------- SEARCH FOR DATASET FROM INPUT
NEWDA    DS    0H
         BAS   R14,READIEH             Read next IEHLIST record
         CLC   DSN,HYPHDSN         C'---- DATA SET NAME ----' FOUND ?
         BE    NEWDA4                  NO TEST IF PRINTDATA AVAIL.
         CLC   =C'       ADDR  CYLS   A     ADDR',REGIN   F5 LINE?
         BE    NEWDA6                  Yes: read next and process F5
         CLC   =C' THERE ARE',DSN      TOTAL LINE OF IEHLIST OUTP. ?
         BNE   NEWDA                   No: read next IEHLIST record
         B     READEOF                 Else print totals and disk map
NEWDA4   TM    PRTSW,X'01'             Something to print?
         BO    PRTLINE                 Yes: do that
         B     NEWDA8
NEWDA6   DS    0H
         BAS   R14,READIEH             Next record are F5 values
         BAS   R14,F5DSCB              Process freespace
         B     NEWDA                   Process next data set name
NEWDA8   BAS   R14,READIEH             Read record after C'--- DATA SET
         MVI   DSNLINE+1,C' '          BLANK
         MVC   DSNLINE+2(119),DSNLINE+1     THE RECORD
         MVC   DSNAME,DSN              PREPARE PRINT RECORD
         MVC   EXT,EXTEN               # EXTENTS OF DATASET
         MVC   TEXTE,=C'EXT.'
         MVC   DSO,DSORG               DCB
         MVC   RECF,RECFM                 DATA
         MVC   BLK,BLKSIZE
         MVC   CRE,CREDT               Creation date of data set
         LH    R4,#DSCTR               Data set counter
         LA    R4,1(,R4)               Increase
         CVD   R4,WORKFLD              Pack counter
         OI    WORKFLD+7,X'0F'         Make absolute
         UNPK  SEQNR(4),WORKFLD        Make zoned
         STH   R4,#DSCTR               Save data set counter
*
NEWDA9   DS    0H
         BAS   14,READIEH              Read IEHLIST record
         CLC   LRECL,=C'LRECL'         DCB header line?
         BE    LRECL1                  Yes: process DCB info
         CLC   LRECL,=C'EXTEN'         Extents header line?
         BE    EXTENT1                 Yes: process extents line
*
         B     NEWDA9
LRECL1   BAS   R14,READIEH
         MVC   RECL,LRECL              Move record length
         OI    PRTSW,X'01'             Mark line available to print
         B     NEWDA9                  Next record
EXTENT1  BAS   R14,READIEH             Read next IEHLIST record
         BAS   R14,$EXTENT             Process data set extents
         B     NEWDA                   Next data set
*
PRTLINE  NI    PRTSW,255-X'01'         PRINTSW OFF
         MVC   TRACKS(6),=X'402020202120'  EDIT pattern
         ED    TRACKS(6),TRACK+1       Number of tracks in line
         ZAP   TRACK,=P'0'
         LA    R5,1(,R5)               Increase line counter
         C     R5,=F'50'               Maximum lines on page?
         BL    PRTLINE2                No: print detail line
         PUT   SYSUT2,HEADER1          Print header
         MVI   DSNLINE,C'-'            '-' ASA cc = skip 2 lines
         XR    R5,R5                   Clear line counter
PRTLINE2 DS    0H
         PUT   SYSUT2,DSNLINE          Write detail line
         MVI   DSNLINE,C' '            Blank ASA CC (skip 1 line)
         B     NEWDA8                  Read next record
*------- ----- ----------------------- EOF IEHLIST input
READEOF  DS    0H                      EODAD address IEHLIST
         MVC   HEADER1(164),REGUT      SAVE HEADER FOR DISK MAP
         PUT   MAPDCB,HEADER1          WRITE IT
         MVI   REGUT,X'40'             Clear ...
         MVC   REGUT+1(163),REGUT            line
         MVC   TEXT,=C'Cyl '           Linetext in map line
         MVI   SKIP,C'-'               Skip 2 lines
         L     R7,TRKSCYL              BCT (Tracks in a cylinder)
         XR    R4,R4                   Total Tracks (Empty+full)
         XR    R5,R5                   Clear line counter
         L     R3,=F'-1'               Cylinder counter (numerator)
         XR    R2,R2                   Total empty tracks
         XR    R6,R6                   Total full tracks
         L     R11,MAPADDR             ADDRESS INPUT BYT. P. TRACK
*------- ----- ----------------------- Prepare disk map for printing
MAP      DS    0H
         LA    R9,HEADS                Address output line (5*TRKCYL)
MAP01    DS    0H
         CLC   0(2,R11),=X'270E'       Track used twice or more?
         BL    MAP09                   Low: move data set number
         BH    MAP03                   High: empty track
         MVC   0(5,R9),=C'-===='       Track used by more than 1
         B     MAP07                   data set.
MAP03    DS    0H
         CLC   0(2,R11),=X'270F'       Unused track?
         BH    MAP05                   If high, track is empty
         MVC   0(5,R9),=C'-****'       Mark Unused/lost track
         MVC   RTNCODE,=F'4'           RC=4, possible disk error
         B     MAP07
MAP05    DS    0H
         MVC   0(5,R9),=C'     '       This track is empty
MAP07    DS    0H
         LA    R2,1(,R2)               Count emptry track
         B     MAP11
MAP09    DS    0H
         LH    R1,0(,R11)              Pickup entry in disk map
         CVD   R1,WORKFLD              Make decimal
         OI    WORKFLD+7,X'0F'         Make absolute
         MVC   0(5,R9),=C'-    '
         LA    R6,1(,R6)               Add full track
         UNPK  1(4,R9),WORKFLD         Data set number in disk map
MAP11    DS    0H
         LA    R9,5(,R9)               Next track in disk map
         BCT   R7,MAP15                Next track
         LA    R11,2(,R11)             DISKMAP COUNTER + 2
         LA    R4,1(,R4)               Increase data set counter
         L     R7,TRKSCYL              Next cylinder
         C     R5,=F'52'               Maximum lines reached?
         BL    MAP13                   No: do not print header
         PUT   MAPDCB,HEADER1          Yes: print header
         MVI   SKIP,C'-'               Skip 2 lines in ASA
         XR    R5,R5                   Clear line counter
MAP13    DS    0H
         LA    R3,1(,R3)               Increase cylinder counter
         CVD   R3,WORKFLD              To decimal
         OI    WORKFLD+7,X'0F'         Make absolute
         UNPK  NUMBER(4),WORKFLD       Make zoned
         PUT   MAPDCB,REGUT            Write line on disk map
         MVI   SKIP,C' '               Skip 1 line in ASA
         LA    R5,1(,R5)               Increase line counter
         C     R4,TOTTR                Last track reached?
         BL    MAP                     No: process
         B     MAP17                   Else process totals
MAP15    DS    0H
         LA    R11,2(,R11)             Next entry in disk map
         LA    R4,1(,R4)               Increase total track counter
         C     R4,TOTTR                Do we have the entire volume?
         BL    MAP01                   No: loop
MAP17    DS    0H
         MVI   REGUT,C' '              Clear ...
         MVC   REGUT+1(164),REGUT            ... REGUT field
         MVI   REGUT,C'-'              Skip 2 lines in ASA
         CVD   R6,WORKFLD              Total full tracks
         OI    WORKFLD+7,X'0F'         Make absolute
         UNPK  TOTFULL,WORKFLD
         CVD   R2,WORKFLD              Total empty tracks
         OI    WORKFLD+7,X'0F'         Make absolute
         UNPK  TOTEMPTY,WORKFLD
         MVC   REGUT+20(20),=C'Total empty tracks. '
         MVC   REGUT+40(8),TOTEMPTY
         MVC   REGUT+60(20),=C'Total full tracks.  '
         MVC   REGUT+80(8),TOTFULL
         PUT   MAPDCB,REGUT            Write last line on disk map
*
*------- ----- ----------------------- Process the total lines
TOTALS   DS    0H
         TM    PRTSW,X'01'             Still a DSN line to be printed?
         BNO   TOTALS3                 No: Don't print
*------- ----- ----------------------- Print the last line
         NI    PRTSW,255-X'01'         PRINTSW OFF
         MVC   TRACKS(6),=X'402020202120' Print the last data set line
         ED    TRACKS(6),TRACK+1       Number of tracks in line
         ZAP   TRACK,=P'0'
         LA    R5,1(,R5)               Increase line counter
         C     R5,=F'50'               Maximum lines on page?
         BL    TOTALS1                 No: print the detail line
         PUT   SYSUT2,HEADER1          WRITE HEADER
         MVI   DSNLINE,C'-'            '-' skip 2 lines ASA
         XR    R5,R5                   Clear line counter
TOTALS1  DS    0H
         PUT   SYSUT2,DSNLINE          Write detail line
         MVI   DSNLINE,C' '            Blank ASA control character
TOTALS3  DS    0H
         MVI   REGIN,C'-'              Skip 2 lines ASA
         PUT   SYSUT2,REGIN            Print
TOTALS5  DS    0H                      Print F4+F5 DSCB on SYSUT2
         CLOSE IEHLIST
         LA    R1,TOTALS7              New EODAD address
         STCM  R1,7,IEHLIST+DCBEODA-IHADCB
         OPEN  IEHLIST                 Start over
TOTALS6  DS    0H
         BAS   R14,READIEH             Read IEHLIST record
         CLC   DSN,HYPHDSN        =C'-----DATA SET NAME-----' found?
         BE    TOTALS7                 YES: ALL DONE
         PUT   SYSUT2,REGIN
         B     TOTALS6                 PRINT UNTIL ---DATA SET NAME--
*                                      OR EOF.
TOTALS7  DS    0H
         B     RETURN                  DISABLE VPSM
         BAS   R14,READIEH             Read IEHLIST record
         CLC   =C'VPSM  ',DSN          SPACE MAP (INDEXED VTOC) FOUND?
         BNE   TOTALS7                 NO: CONTINUE READ
         BAS   R14,F5DSCB              YES: PROCESS VPSM
*
*------- ----- ----------------------- DISKMAP COMPLETED
RETURN   DS    0H
         CLOSE (IEHLIST,,MAPDCB,,SYSUT2)
         L     R11,MAPADDR
         FREEMAIN R,A=(11),LV=120000   RELEASE DISK MAP STORAGE
         L     R15,RTNCODE
         L     R13,4(,R13)             LOAD CALLERS SAVE AREA
         RETURN (14,12),RC=(15)        Exit
         TITLE 'PROCESS VTOC AND DATA SET EXTENTS'
*--------------------------------------------------------------------*
*                                                                    *
*        Process format 4 DSCB and data set extents                  *
*        in this section the IEHLIST lines with the extent           *
*        boundaries will be processed.                               *
*        These are the lines after the IEHLIST line:                 *
*        'EXTENTS  NO  LOW(C H)     HIGH(C H)  ...........'          *
*                                                                    *
*        Register 3: loop thru the 6 extents in freespace line       *
*        Register 6: address of 1 extent in freespace line           *
*        Register 7: low boundary of extent                          *
*        Register 9: high boundary of extent                         *
*                                                                    *
*------------------------------------------(C)-2025 Skybird Systems--*
$EXTENT  DS    0H
         ST    R14,R14EXT              SAVE REGISTER 14
$EXT001  LA    R6,NO                   Point to first extent
         USING F1EXT,R6
         LA    R3,3                    Max 3 extents in data set line
         TM    EXTENT+1,X'F0'          EXTENT DESCR OF DATASET FOUND ?
         BO    $EXT003                 YES: SET EXTENT IN DISK MAP
         BAS   R14,READIEH             READ RECORD
         CLC   UNABLE,=CL18'----UNABLE TO CALC' END EXTENT LINES?
         BE    $EXT999                 YES: END OF DATASET
         CLC   UNABLE,=CL18'----ON THE ABOVE D' END EXTENT LINES?
         BE    $EXT999
         B     $EXT001                 PROCESS THE LINE
*
$EXT003  DS    0H
         TM    EXTENT+1,X'F0'          EXTENT DESCR OF DATASET FOUND?
         BNO   $EXT999                 No: no more extents
         PACK  WORKFLD,HIGHCYL         Highest cylinder
         CVB   R9,WORKFLD              TO BINARY
         MH    R9,TRKSCYL+2            CYL * TRKS PER CYLINDER
         PACK  WORKFLD,HIGHHEAD        Highest track
         CVB   R1,WORKFLD              TO BINARY
         AR    R9,R1                   COMPUTE HIGHEST TRACK ADDRESS
         SLL   R9,1                    * 2 because track in disk map
*                                      is 2 bytes
$EXT011  DS    0H
         OC    LOWCYL(5),=CL5'00000'   SET ZONES TO 'F'
         OC    LOWHEAD(2),=CL2'00'
         PACK  WORKFLD,LOWCYL          Pack lowest cylinder address
         CVB   R7,WORKFLD              To register 7.
         MH    R7,TRKSCYL+2            Cylinder * tracks per cylinder
         PACK  WORKFLD,LOWHEAD         LOWEST TRACK ADDRESS DATASET
         CVB   R1,WORKFLD              IN REG. 8
         AR    R7,R1                   TOTAL LOW TRACK ADDRESS
         SLL   R7,1                    X 2 BECAUSE EACH TRK = 2 BYTES
*
$EXT013  DS    0H         INITIALIZE START ADDRESS IN DISK MAP
         L     R11,MAPADDR             ADDRESS OF DISK MAP
         AR    R11,R7                  INDEX WITH START ADDRESS
$EXT015  DS    0H
*                      test of track, which contains > 1 data set
         CLC   0(2,R11),=X'270F'       UNFILLED? (9999)
         BE    $EXT017                 YES: OK
*                 tracks, which contain > 1 data set
         LH    R1,#DSCTR               2nd data set number
         CVD   R1,WORKFLD              TO DECIMAL
         OI    WORKFLD+7,X'0F'         MAKE ABSOLUTE
         UNPK  DUBWTO+15(4),WORKFLD+4(4) Move into message
         LH    R1,0(,R11)              1st data set number
         CVD   R1,WORKFLD              To decimal
         OI    WORKFLD+7,X'0F'         Make absolute
         UNPK  DUBWTO+31(4),WORKFLD+4(4) Move into message
*
         LA    R5,1(,R5)               Increase line counter
         PUT   SYSUT2,DUBWTO           Print double occupied line
         MVC   0(2,R11),=X'270E'       9998 = 2nd time in format 4
         B     $EXT019
$EXT017  DS    0H
         MVC   0(2,R11),#DSCTR         Data set number in disk map
$EXT019  DS    0H
         AP    TRACK,=P'1'             Increase track counter
         LA    R7,2(,R7)               Increase track counter
         LA    R11,2(,R11)             Next entry in disk map
         CR    R7,R9                   Last track reached?
         BNH   $EXT015                 No: process next track in map
$EXT021  DS    0H
         LA    R6,L'NO(,R6)            Next extent of data set
         BCT   R3,$EXT003              Process until extents done
         BAS   R14,READIEH             Read next IEHLIST record
         B     $EXT001
$EXT999  DS    0H
         L     R14,R14EXT              Restore register 14
         BR    R14                     Return
         DROP  R6
         TITLE 'PROCESS FREE SPACE IN F5 DSCB OR VPSM'
*------- ----- ----------------------- PROCESS F5 DSCB (OS) OR
*                                      VPSM (INDEXED VTOC)
*                                      Entry: BAS   R14,F5DSCB
F5DSCB   DS    0H
         ST    R14,R14F5               SAVE REGISTER 14
F5DSCB1  LA    R2,F5EXT1               ADDRESS FIRST F5 EXT
         USING FREESPC,R2
         LA    R4,6                    6 extents in F5 DSCB line
F5DSCB2  DS    0H
         PACK  FSPCADDR,FADDR          Address of free space
         PACK  FREECYL,FCYLS           Free cylinders
         PACK  FREETR,FTRKS            Free tracks
         L     R11,MAPADDR             Start address disk map
         CVB   R1,FSPCADDR             1st free track address
         SLL   R1,1                    TIMES 2
         AR    R11,R1                  Adjust offser in disk map
         CVB   R6,FREECYL              # free cylinders
         MH    R6,TRKSCYL+2            # tracks per cylinder
         CVB   R1,FREETR               # free tracks
         AR    R6,R1                   Total free tracks
         LTR   R6,R6                   No free tracks?
         BZ    F5DSCB9                 Yes: next entent
F5DSCB5  DS    0H
         CLC   0(2,R11),=X'270F'       Track not used?
         BE    F5DSCB6                 Yes: good, process
*------- ----  ------------------------ Already used track
         LH    R1,#DSCTR
         CVD   R1,WORKFLD              Make decimal
         OI    WORKFLD+7,X'0F'         Make absolute
         UNPK  DUBWTO+30(4),WORKFLD
         MVC   DUBWTO+15(4),=C'FREE'
         LA    R5,1(,R5)               Increase line counter
         PUT   SYSUT2,DUBWTO           Write message on file
         MVC   0(2,R11),=X'270E'       Track is used twice
         B     F5DSCB7
F5DSCB6  DS    0H
         MVC   0(2,R11),=H'-1'         X'FFFF' = real free track
F5DSCB7  DS    0H
         LA    R11,2(,R11)             Next entry in disk map
         BCT   R6,F5DSCB5
F5DSCB9  LA    R2,19(,R2)              Address of next extent of F5
         CLC   FADDR,=CL5' '           Another format 5 record?
         BE    F5DSCB99                F5 freespace with less 6 entries
         BCT   R4,F5DSCB2              Process next extent in same line
         BAS   R14,READIEH             Read next IEHLIST record
         CLC   =C'DSCB(C-H-R)',DSCBCHR End of free space lines?
         BE    F5DSCB99                Find ---DATA SET ...
         CLC   FADDR,=CL5' '           Another format 5 record?
         BNE   F5DSCB1                 Yes: process next freespace line
F5DSCB99 L     R14,R14F5               Restore register 14
         BR    R14                     Return
         DROP  R2
         TITLE 'READ IEHLIST LISTVTOC FORMAT'
*------- ----- ----------------------- Read IEHLIST LISTVTOC FORMAT
READIEH  DS    0H
         ST    R14,R14IEH              Save register 14
READIE2  GET   IEHLIST,REGIN
         CLI   REGIN,C'1'              Header line in IIHLIST?
         BE    READIE2                 Yes: skip
         CLC   =C'CONTENTS OF VTOC ON VOL ',REGIN+17
         BE    READIE3                 Pickup volume serial
         B     READ999                 Exit
READIE3  MVC   VOLUME,REGIN+41         Volume serial in header
         B     READ999
READIE9  LA    R14,READEOF             EODAD
         BR    R14
READ999  L     R14,R14IEH              Restore register 14
         BR    R14
         TITLE 'DATA CONTROL BLOCKS, CONSTANTS AND VARIABLES'
*------- ----- ----------------------- DEFINE DATA CONTROL BLOCKS
         PRINT NOGEN
IEHLIST  DCB   DDNAME=SYSUT1,DSORG=PS,MACRF=(GM),LRECL=(121),RECFM=FB, C
               EODAD=READIE9
SYSUT2   DCB   DDNAME=SYSUT2,DSORG=PS,MACRF=(PM),LRECL=121,            C
               RECFM=FBA,BLKSIZE=1210
MAPDCB   DCB   DDNAME=SYSPRINT,DSORG=PS,MACRF=(PM),LRECL=121,          C
               RECFM=FBA,BLKSIZE=1210
         PRINT GEN
