//IEBCOPYR JOB (SYS),'RELINK IEBCOPY',CLASS=S,MSGCLASS=A
//IEHPROGM EXEC PGM=IEHPROGM
//SYSPRINT  DD SYSOUT=*
//DD1       DD UNIT=SYSDA,VOL=SER=MVSRES,DISP=OLD
//SYSIN     DD *
  RENAME DSNAME=SYS1.LINKLIB,VOL=SYSDA=MVSRES,MEMBER=IEBCOPY,          C
               NEWNAME=IEBCOPY@
//IEWL     EXEC PGM=IEWL,REGION=1024K,COND=(0,NE),
//             PARM='NCAL,LIST,XREF,LET'
//SYSUT1    DD UNIT=SYSDA,DSN=&&SYSUT1,SPACE=(1700,(400,50))
//SYSPRINT  DD SYSOUT=*
//SYSLMOD   DD DISP=OLD,DSN=SYS1.LINKLIB
//SYSLIN   DD  *
 INCLUDE SYSLMOD(IEBCOPY@)
 ORDER IEBDSMCA(P)
 INSERT IEBDSMCA
 INSERT IEBDSCP2
 INSERT IEBVMTXT
 INSERT IEBDV1MG
 INSERT IEBIOEMG
 INSERT IEBWSUMG
 INSERT IEBDSCPY,IEBVMS,IEBDV1
 INSERT IEBLDUL
 INSERT IEBSCN
 INSERT IEBVCT
 INSERT IEBIOE
 INSERT IEBRSAM,IEBCNVT,IEBDRD
 INSERT IEBWSAM,IEBDSU
 INSERT IEBWSU,IEBDWR
 INSERT IEBBAM
 INSERT IEBVDM
 INSERT IEBDRB
 INSERT IEBMCM
 INSERT IEBVTT
 INSERT IEBVTM
 ENTRY IEBDSCPY
 SETCODE AC(1)
 NAME    IEBCOPY(R)
//
