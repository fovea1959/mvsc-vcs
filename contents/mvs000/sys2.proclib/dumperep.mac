//DUMPEREP PROC SOUT=R,P=SU
//* ***************************************************************** *
//* DUMP ENVIRONMENTAL ERROR RECORDER DATASET                         *
//* ***************************************************************** *
//EREP     EXEC PGM=IFCEREP1,REGION=2048K,
//  PARM='PRINT=&P,ZERO=N,ACC=N,LINECT=60,TABSIZE=512K'
