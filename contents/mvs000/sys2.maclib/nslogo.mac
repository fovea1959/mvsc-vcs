*
* MFSCREEN - IBM SYSTEM/370 LOGON PANEL, 24 X 80, 3270 STREAM
*
* ESC + ERASE/WRITE ALTERNATE + WCC + ORDERS, FOR TPUT FULLSCR.
* ROW 1 IS THE TITLE LINE, ROWS 2-23 ARE THREE CABINETS (TAPE, CPU,
* DISK), ROW 24 IS THE LOGON PROMPT.
*
* USES THE EXISTING MACROS $ESC, $WCC, $SBA AND $SF, PLUS $SFE
* (MEMBER $SFE IN MFMACS) FOR THE EXTENDED ATTRIBUTES.
*   $SFE (ATTRS),HILITE=,COLOR=
*   ATTRS   SAME WORDS AS $SF; DEFAULT UNPROT,ALPHA,NOMDT, NORMAL
*   HILITE  NORMAL BLINK REVERSE UNDERSCORE
*   COLOR   DEFAULT BLUE RED PINK GREEN TURQ YELLOW WHITE
*
* LAYOUT (COLUMNS): TAPE 2-25, CPU 27-54, DISK 56-79.
* COLORS: YELLOW = TAPE AND DISK MECHANICS, TURQUOISE = CPU PANEL,
* GREEN/RED/BLUE = LAMPS, REVERSE-VIDEO BUTTONS. ONE CPU LAMP BLINKS.
* A COLOR ATTRIBUTE BYTE TAKES THE PLACE OF A BLANK NEXT TO THE
* COLORED TEXT, SO COLORING NEVER CHANGES THE LAYOUT.
* LOGOxxxx LABELS ARE 8- OR 4-BYTE READ-ONLY FIELDS: FILL BEFORE TPUT.
*
SCREEN   DS    0H
         $ESC
         DC    X'7E'                ERASE/WRITE ALTERNATE
         $WCC  (RESETKBD,MDT)
*
* ROW 1 - TITLE PLUS LOGODEV (LABELED), LOGODATE AND LOGOTIME.
*         ALL THREE ARE 8-BYTE HIGHLIGHTED READ-ONLY FIELDS; FILL
*         THEM BEFORE TPUT. EACH FIELD'S ATTRIBUTE BYTE SHOWS AS THE
*         BLANK BEFORE IT, SO THE FIELDS NEED NO SEPARATORS.
         $SBA  (1,1)
         $SF   (PROT)
         DC    C'==='
         DC    C' IBM SYSTEM/370 '
         DC    C'==========================='
         DC    C' TERM'
         $SF   (PROT,HI)
LOGODEV  DC    CL8'TERM0001'
         $SF   (PROT,HI)
LOGODATE DC    CL8'MM/DD/YY'
         $SF   (PROT,HI)
LOGOTIME DC    CL8'HH:MM:SS'
         $SF   (PROT)
* ROW 2
         $SBA  (2,1)
         DC    C' +======================+ +====================='
         DC    C'=====+ +======================+ '
* ROW 3
         $SBA  (3,1)
         DC    C' ',X'4F',C'  ::::::::::::::::::  ',X'4F',C' ',X'4F'
         DC    C'    MODEL'
         $SF   (PROT,HI)
LOGOMODL DC    CL4'????'
         DC    C' '
LOGOMEM  DC    C'?????k'
         $SF   (PROT)
         DC    C'    '
         DC    X'4F',C' ',X'4F',C'  ::::::::::::::::::  ',X'4F'
         DC    C' '
* ROW 4
         $SBA  (4,1)
         DC    C' +----------------------+ +---------------------'
         DC    C'-----+ +----------------------+ '
* ROW 5
         $SBA  (5,1)
         DC    C' ',X'4F',C'                      ',X'4F',C' ',X'4F'
         DC    C'                          ',X'4F',C' ',X'4F'
         DC    C'                      ',X'4F',C' '
* ROW 6
         $SBA  (6,1)
         DC    C' ',X'4F'
         $SFE  (PROT),COLOR=YELLOW
         DC    C' .-----. '
         $SF   (PROT)
         $SFE  (PROT),COLOR=YELLOW
         DC    C' .-----. '
         $SF   (PROT)
         DC    X'4F',C' ',X'4F',C' +----------------------+ ',X'4F'
         DC    C' ',X'4F',C' '
         $SFE  (PROT),COLOR=YELLOW
         DC    C'.----------------.'
         $SF   (PROT)
         DC    C' ',X'4F',C' '
* ROW 7
* Tape drive
         $SBA  (7,1)
         DC    C' ',X'4F'
         $SFE  (PROT),COLOR=YELLOW
         DC    C'(  .-.  )'
         $SF   (PROT)
         $SFE  (PROT),COLOR=YELLOW
         DC    C'(  .-.  )'
         $SF   (PROT)
         DC    X'4F'
*
         DC    C' '
* CPU
         DC    X'4F',C' ',X'4F'
         $SFE  (PROT),COLOR=PINK
         DC    C' ',X'90',C' . ',X'90'
         DC    C' ',X'90',C' . ',X'90',C' . ',X'90',C' ',X'90',C' .'
         $SF   (PROT)
         DC    X'4F',C' ',X'4F'
*
         DC    C' '
* Disk Drive
         DC    X'4F',C' '
         $SFE  (PROT),COLOR=YELLOW
         DC    C'(  .----------.  )'
         $SF   (PROT)
         DC    C' ',X'4F',C' '
* ROW 8
* Tape drive
         $SBA  (8,1)
         DC    C' ',X'4F'
         $SFE  (PROT),COLOR=YELLOW
         DC    C'( ( o ) )'
         $SF   (PROT)
         $SFE  (PROT),COLOR=YELLOW
         DC    C'( ( o ) )'
         $SF   (PROT)
         DC    X'4F'
*
         DC    C' '
* CPU
         DC    X'4F',C' ',X'4F'
         $SFE  (PROT),COLOR=PINK
         DC    C' . ',X'90',C' . .'
         $SFE  (PROT),HILITE=BLINK,COLOR=PINK
         DC    X'90'
         $SFE  (PROT),COLOR=PINK
         DC    X'90',C' . ',X'90',C' . ',X'90'
         $SF   (PROT)
         DC    X'4F',C' ',X'4F'
*
         DC    C' '
* DISK
         DC    X'4F',C' '
         $SFE  (PROT),COLOR=YELLOW
         DC    C'( (  .------.  ) )'
         $SF   (PROT)
         DC    C' ',X'4F',C' '
* ROW 9
* Tape Drive
         $SBA  (9,1)
         DC    C' ',X'4F'
         $SFE  (PROT),COLOR=YELLOW
         DC    C'(  +-+  )'
         $SF   (PROT)
         $SFE  (PROT),COLOR=YELLOW
         DC    C'(  +-+  )'
         $SF   (PROT)
         DC    X'4F'
*
         DC    C' '
* CPU
         DC    X'4F',C' ',X'4F'
         $SFE  (PROT),COLOR=PINK
         DC    C' ',X'90',C' ',X'90'
         DC    C' . ',X'90',C' . . ',X'90',C' ',X'90',C' . .'
         $SF   (PROT)
         DC    X'4F'
*
         DC    C' '
* Disk drive
         DC    X'4F',C' ',X'4F',C' '
         $SFE  (PROT),COLOR=YELLOW
         DC    C'( ( ( ( () ) ) ) )'
         $SF   (PROT)
         DC    C' ',X'4F',C' '
* ROW 10
* Tape drive
         $SBA  (10,1)
         DC    C' ',X'4F'
         $SFE  (PROT),COLOR=YELLOW
         DC    C' +-----+ '
         $SF   (PROT)
         $SFE  (PROT),COLOR=YELLOW
         DC    C' +-----+ '
         $SF   (PROT)
         DC    X'4F'
*
         DC    C' '
* CPU cabinet
         DC    X'4F',C' ',X'4F'
         $SFE  (PROT),COLOR=PINK
         DC    C' . . ',X'90',C' . ',X'90'
         DC    C' ',X'90',C' . . ',X'90',C' ',X'90'
         $SF   (PROT)
         DC    X'4F',C' ',X'4F'
*
         DC    C' '
* Disk
         DC    X'4F',C' '
         $SFE  (PROT),COLOR=YELLOW
         DC    C'( (  +------+  ) )'
         $SF   (PROT)
         DC    C' ',X'4F',C' '
* ROW 11
         $SBA  (11,1)
         DC    C' ',X'4F',C'                      ',X'4F',C' ',X'4F'
         DC    C' +----------------------+ ',X'4F',C' ',X'4F',C' '
         $SFE  (PROT),COLOR=YELLOW
         DC    C'(  +----------+  )'
         $SF   (PROT)
         DC    C' ',X'4F',C' '
* ROW 12
         $SBA  (12,1)
         DC    C' ',X'4F',C' '
         $SFE  (PROT),COLOR=YELLOW
         DC    C'=================='
         $SF   (PROT)
         DC    C' ',X'4F',C' ',X'4F',C'                          '
         DC    X'4F',C' ',X'4F',C' '
         $SFE  (PROT),COLOR=YELLOW
         DC    C'+----------------+'
         $SF   (PROT)
         DC    C' ',X'4F',C' '
* ROW 13
         $SBA  (13,1)
         DC    C' ',X'4F',C'    +------------+    ',X'4F',C' ',X'4F'
         DC    C'   '
         $SFE  (PROT),COLOR=TURQ
         DC    C'(/) (/) (/) (/) (/)'
         $SF   (PROT)
         DC    C'  ',X'4F',C' ',X'4F',C' '
         $SFE  (PROT),COLOR=YELLOW
         DC    C'=================='
         $SF   (PROT)
         DC    C' ',X'4F',C' '
* ROW 14
         $SBA  (14,1)
         DC    C' ',X'4F',C'    ',X'4F',C'  R/W HEAD  ',X'4F',C'    '
         DC    X'4F',C' ',X'4F',C'                          ',X'4F'
         DC    C' ',X'4F',C'                      ',X'4F',C' '
* ROW 15
         $SBA  (15,1)
         DC    C' ',X'4F',C'    +------------+    ',X'4F',C' ',X'4F'
         DC    C'  '
         $SFE  (PROT),COLOR=TURQ
         DC    C'+------------------+'
         $SF   (PROT)
         DC    C'  ',X'4F',C' ',X'4F',C' (O) (O) (O) (O) (O)  ',X'4F'
         DC    C' '
* ROW 16
         $SBA  (16,1)
         DC    C' ',X'4F',C'                      ',X'4F',C' ',X'4F'
         DC    C'  '
         $SFE  (PROT),COLOR=TURQ
         DC    X'4F'
         DC    C' MVS'
         $SF   (PROT,HI)
LOGORLSE DC    CL4'????'
         $SFE  (PROT),COLOR=TURQ
         DC    C'ID'
         $SF   (PROT,HI)
LOGOID   DC    CL4'????'
         $SFE  (PROT),COLOR=TURQ
         DC    X'4F'
         $SF   (PROT)
         DC    C'  ',X'4F',C' ',X'4F',C'                      ',X'4F'
         DC    C' '
* ROW 17
         $SBA  (17,1)
         DC    C' ',X'4F',C' '
         $SFE  (PROT),COLOR=YELLOW
         DC    C'O O O O O O O O O'
         $SF   (PROT)
         DC    C'  ',X'4F',C' ',X'4F',C'  '
         $SFE  (PROT),COLOR=TURQ
         DC    C'+------------------+'
         $SF   (PROT)
         DC    C'  ',X'4F',C' ',X'4F',C'                      ',X'4F'
         DC    C' '
* ROW 18
         $SBA  (18,1)
         DC    C' ',X'4F',C' '
         $SFE  (PROT),COLOR=GREEN
         DC    X'90'
         $SF   (PROT)
         DC    C'RDY '
         $SFE  (PROT),COLOR=RED
         DC    X'90'
         $SF   (PROT)
         DC    C'CHK  ',X'90',C' PRT ',X'4F',C' ',X'4F'
         DC    C'                          ',X'4F',C' ',X'4F',C' '
         $SFE  (PROT),COLOR=GREEN
         DC    X'90'
         $SF   (PROT)
         DC    C'RDY '
         $SFE  (PROT),COLOR=RED
         DC    X'90'
         $SF   (PROT)
         DC    C'CHK  ',X'90',C' SEL ',X'4F',C' '
* ROW 19
         $SBA  (19,1)
         DC    C' +----------------------+ +---------------------'
         DC    C'-----+ +----------------------+ '
* ROW 20
         $SBA  (20,1)
         DC    C' ',X'4F',C'  '
         $SFE  (PROT),HILITE=REVERSE,COLOR=GREEN
         DC    C'ON-LINE'
         $SF   (PROT)
         DC    C' '
         $SFE  (PROT),HILITE=REVERSE,COLOR=BLUE
         DC    C'REWIND'
         $SF   (PROT)
         DC    C'  ',X'4F',C' ',X'4F',C'     '
         $SFE  (PROT),HILITE=REVERSE,COLOR=GREEN
         DC    C'LOAD'
         $SF   (PROT)
         DC    C'   '
         $SFE  (PROT),HILITE=REVERSE,COLOR=RED
         DC    C'RESET'
         $SF   (PROT)
         DC    C'     ',X'4F',C' ',X'4F',C'   '
         $SFE  (PROT),HILITE=REVERSE,COLOR=GREEN
         DC    C'START'
         $SF   (PROT)
         DC    C'    '
         $SFE  (PROT),HILITE=REVERSE,COLOR=RED
         DC    C'STOP'
         $SF   (PROT)
         DC    C'  ',X'4F',C' '
* ROW 21
         $SBA  (21,1)
         DC    C' ',X'4F',C'                      ',X'4F',C' ',X'4F'
         DC    C' ',X'6A5F6A5F6A5F6A5F6A5F6A5F6A5F6A5F6A5F6A5F6A5F6A5F'
         DC    C' ',X'4F',C' ',X'4F',C'                      ',X'4F'
         DC    C' '
* ROW 22
         $SBA  (22,1)
         DC    C' ',X'4F',C'  ::::::::::::::::::  ',X'4F',C' ',X'4F'
         DC    C'  ::::::::::::::::::::::  ',X'4F',C' ',X'4F'
         DC    C'  ::::::::::::::::::  ',X'4F',C' '
* ROW 23
         $SBA  (23,1)
         DC    C' +======================+ +====================='
         DC    C'=====+ +======================+ '
* ROW 24 - LOGON PROMPT: PROTECTED LABEL, UNDERSCORED INPUT FIELD
*          COLS 14-79, ENDED BY A PROTECTED ATTRIBUTE AT COL 80.
*          CURSOR GOES TO THE FIELD START.
         $SBA  (24,1)
         $SF   (PROT,HI)
         DC    C'LOGON ===> '
         $SFE  (UNPROT),HILITE=UNDERSCORE
         $SBA  (24,80)
         $SF   (PROT)
         $SBA  (24,14)
         DC    X'13'                INSERT CURSOR
SCRLEN   EQU   *-SCREEN
